<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coupon Management | PawPalace Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#fff1f2', 500: '#f43f5e' },
                        accent: { navy: '#0f172a', teal: '#2dd4bf' }
                    }
                }
            }
        }
    </script>

    <style>
        .field-error {
            border-color: #ef4444 !important;
            /* red-500 */
            background-color: #fff1f2;
        }

        .error-text {
            font-size: 11px;
            color: #ef4444;
            font-weight: 600;
            margin-top: 4px;
        }
    </style>
</head>

<body class="bg-gray-50 font-sans text-accent-navy">

    <div class="flex min-h-screen">
        <%- include('../partials/adminSidebar') %>

            <main class="flex-1 p-8">
                <header class="flex justify-between items-center mb-8">
                    <div>
                        <h1 class="text-3xl font-bold">Coupons</h1>
                        <p class="text-gray-500 text-sm font-medium">Create and manage all coupons</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <div
                            class="bg-teal-50 text-teal-600 p-2 rounded-full w-10 h-10 flex items-center justify-center font-bold">
                            A</div>
                        <div>
                            <p class="text-sm font-bold">Admin User</p>
                            <p class="text-xs text-gray-400">Super Admin</p>
                        </div>
                    </div>
                </header>

                <!-- Stats -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white p-6 rounded-[2rem] shadow-sm flex items-center gap-4 border border-gray-100">
                        <div
                            class="w-12 h-12 bg-red-50 text-brand-500 rounded-2xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-ticket"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Redemptions
                            </p>
                            <p class="text-2xl font-bold">
                                <%= (typeof totalRedemptions !=='undefined' ) ? totalRedemptions : '8,499' %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Filters & Actions -->
                <div class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-50 flex flex-wrap gap-4 items-center justify-between">
                        <!-- Search -->
                        <div class="relative w-full max-w-md">
                            <i
                                class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input type="text" placeholder="Search coupons by code..."
                                class="w-full pl-12 pr-4 py-2.5 bg-gray-50 border border-gray-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/10 transition">
                        </div>

                        <!-- Filters -->
                        <div class="flex items-center gap-3">
                            <select
                                class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer">
                                <option value="">All Status</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                                <option value="pending">Pending</option>
                                <option value="expired">Expired</option>
                            </select>

                            <select
                                class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer">
                                <option value="">Sort By</option>
                                <option value="newest">Newest</option>
                                <option value="oldest">Oldest</option>
                                <option value="usage">Usage</option>
                            </select>

                            <button onclick="openAddCouponModal()"
                                class="bg-brand-500 text-white px-6 py-2.5 rounded-xl text-xs font-bold shadow-lg shadow-brand-500/20 flex items-center gap-2 hover:-translate-y-0.5 transition-all">
                                <i class="fa-solid fa-plus"></i> Add Coupon
                            </button>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 text-gray-400 text-[10px] font-bold uppercase tracking-widest">
                                <tr>
                                    <th class="px-8 py-5">Coupon Code</th>
                                    <th class="px-6 py-5">Discount</th>
                                    <th class="px-6 py-5">Min. Amount</th>
                                    <th class="px-6 py-5">Max Discount</th>
                                    <th class="px-6 py-5">Validity Period</th>
                                    <th class="px-6 py-5">Usage</th>
                                    <th class="px-6 py-5">Status</th>
                                    <th class="px-8 py-5">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="couponsTableBody" class="divide-y divide-gray-50">
                                <!-- Rendered via JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="p-6 border-t border-gray-50 flex justify-between items-center" id="paginationControls">
                        <!-- Rendered via JS -->
                    </div>
                </div>
            </main>
    </div>

    <!-- Add Coupon Modal -->
    <div id="addCouponModal"
        class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-accent-navy/40 backdrop-blur-sm">
        <div
            class="bg-white rounded-[2.5rem] p-8 md:p-10 max-w-lg w-full shadow-2xl border-4 border-white/50 relative overflow-hidden max-h-[90vh] overflow-y-auto custom-scrollbar">
            <div
                class="absolute top-0 right-0 w-24 h-24 bg-brand-50 rounded-bl-full -mr-8 -mt-8 pointer-events-none opacity-60">
            </div>

            <h3 class="text-2xl font-bold text-accent-navy mb-6">Create Coupon</h3>

            <form id="addCouponForm" onsubmit="handleAddCoupon(event)">
                <div class="space-y-5 mb-8">
                    <!-- Code & Discount Type -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Coupon
                                Code</label>
                            <input type="text" id="addCode" name="code"
                                oninput="this.value = this.value.replace(/[^a-zA-Z0-9]/g,'').toUpperCase()"
                                placeholder="e.g. SUMMER20"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-bold text-accent-navy uppercase">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Discount
                                Type</label>
                            <select id="addDiscountType" name="discountType" onchange="toggleMaxDiscount('add')"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-medium">
                                <option value="percentage">Percentage (%)</option>
                                <option value="fixed">Fixed Amount ($)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Value & Max Discount -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Discount
                                Amount</label>
                            <input type="number" id="addDiscountValue" name="discountValue" placeholder="20"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-bold">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Maximum
                                Discount</label>
                            <input type="number" id="addMaxDiscount" name="maximumDiscount" placeholder="Optional"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-medium">
                        </div>
                    </div>

                    <!-- Min Amount & Usage Limit -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Min. Purchase
                                Amount</label>
                            <input type="number" id="addMinimumPurchase" name="minimumPurchase" placeholder="0"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-medium">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Total Usage
                                Limit</label>
                            <input type="number" id="addUsageLimit" name="usageLimit" placeholder="Unlimited"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-medium">
                        </div>
                    </div>

                    <!-- Start Date & End Date -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Valid
                                From</label>
                            <input type="text" id="addStartDate" name="startDate" placeholder="Select Date"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-medium datepicker">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Valid
                                Until</label>
                            <input type="text" id="addExpiryDate" name="expiryDate" placeholder="Select Date"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-medium datepicker">
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="mb-4">
                        <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Status</label>
                        <select id="addStatus" name="isActive"
                            class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-brand-500 focus:bg-white transition outline-none font-medium">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="flex flex-col gap-3">
                    <button type="submit" id="addSubmitBtn"
                        class="w-full py-4 bg-brand-500 text-white rounded-2xl font-bold shadow-lg shadow-brand-500/20 hover:-translate-y-1 transition-all">
                        Create Coupon
                    </button>
                    <button type="button" onclick="closeModal('addCouponModal')"
                        class="w-full py-4 bg-white border border-gray-100 text-gray-400 rounded-2xl font-bold hover:bg-gray-50 transition">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit Coupon Modal -->
    <div id="editCouponModal"
        class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-accent-navy/40 backdrop-blur-sm">
        <div
            class="bg-white rounded-[2.5rem] p-8 md:p-10 max-w-lg w-full shadow-2xl border-4 border-white/50 relative overflow-hidden max-h-[90vh] overflow-y-auto custom-scrollbar">
            <div
                class="absolute top-0 right-0 w-24 h-24 bg-pink-50 rounded-bl-full -mr-8 -mt-8 pointer-events-none opacity-60">
            </div>

            <h3 class="text-2xl font-bold text-accent-navy mb-6">Edit Coupon</h3>

            <form id="editCouponForm" onsubmit="handleEditCoupon(event)">
                <input type="hidden" id="editCouponId">
                <div class="space-y-5 mb-8">
                    <!-- Code & Discount Type -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Coupon
                                Code</label>
                            <input type="text" id="editCode" name="code" oninput="this.value = this.value.replace(/[^a-zA-Z0-9]/g,'').toUpperCase()"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-bold text-accent-navy uppercase">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Discount
                                Type</label>
                            <select id="editDiscountType" name="discountType" onchange="toggleMaxDiscount('edit')"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-medium">
                                <option value="percentage">Percentage (%)</option>
                                <option value="fixed">Fixed Amount ($)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Value & Max Discount -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label
                                class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Discount</label>
                            <input type="number" id="editDiscountValue" name="discountValue"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-bold">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Maximum
                                Discount</label>
                            <input type="number" id="editMaxDiscount" name="maximumDiscount"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-medium">
                        </div>
                    </div>

                    <!-- Min Amount & Usage Limit -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Min. Purchase
                                Amount</label>
                            <input type="number" id="editMinimumPurchase" name="minimumPurchase"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-medium">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Total Usage
                                Limit</label>
                            <input type="number" id="editUsageLimit" name="usageLimit"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-medium">
                        </div>
                    </div>

                    <!-- Start Date & End Date -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Valid
                                From</label>
                            <input type="text" id="editStartDate" name="startDate" placeholder="Select Date"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-medium datepicker">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Valid
                                Until</label>
                            <input type="text" id="editExpiryDate" name="expiryDate" placeholder="Select Date"
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-medium datepicker">
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="mb-4">
                        <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">Status</label>
                        <select id="editStatus" name="isActive"
                            class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl focus:border-pink-500 focus:bg-white transition outline-none font-medium">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="flex flex-col gap-3">
                    <button type="submit" id="editSubmitBtn"
                        class="w-full py-4 bg-pink-500 text-white rounded-2xl font-bold shadow-lg shadow-pink-500/20 hover:-translate-y-1 transition-all">
                        Save Changes
                    </button>
                    <button type="button" onclick="closeModal('editCouponModal')"
                        class="w-full py-4 bg-white border border-gray-100 text-gray-400 rounded-2xl font-bold hover:bg-gray-50 transition">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script>
        const couponsData = <%- JSON.stringify(typeof coupons !== 'undefined' ? coupons : []) %>;

        let filteredCoupons = [...couponsData];
        let currentPage = 1;
        const itemsPerPage = 7;

        document.addEventListener('DOMContentLoaded', () => {
            flatpickr(".datepicker", {
                dateFormat: "Y-m-d",
                minDate: "today"
            });
            renderTable();
            setupSearchAndFilter();
        });

        // --- RENDER TABLE ---
        function renderTable() {
            const tbody = document.getElementById('couponsTableBody');
            tbody.innerHTML = '';

            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const pageData = filteredCoupons.slice(start, end);

            // Time-safe format helper
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (pageData.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="px-8 py-16 text-center">
                            <div class="flex flex-col items-center justify-center gap-3 text-gray-400">
                                <i class="fa-solid fa-ticket text-4xl"></i>
                                <p class="text-sm font-semibold">No coupons found</p>
                            </div>
                        </td>
                    </tr>
                 `;
                renderPagination();
                return;
            }

            pageData.forEach(coupon => {
                const startDate = new Date(coupon.startDate);
                startDate.setHours(0, 0, 0, 0);
                const expiryDate = new Date(coupon.expiryDate);
                expiryDate.setHours(0, 0, 0, 0);

                const isExpired = expiryDate < today;
                const isPending = startDate > today;

                let statusClass = '';
                let statusText = '';

                if (isExpired) {
                    statusText = 'Expired';
                    statusClass = 'bg-gray-100 text-gray-500';
                } else if (isPending) {
                    statusText = 'Pending';
                    statusClass = 'bg-yellow-50 text-yellow-600';
                } else if (coupon.isActive) {
                    statusText = 'Active';
                    statusClass = 'bg-green-50 text-green-600';
                } else {
                    statusText = 'Inactive';
                    statusClass = 'bg-orange-50 text-orange-600';
                }

                const discountDisplay = coupon.discountType === 'percentage'
                    ? `${coupon.discountValue}%`
                    : `₹${coupon.discountValue}`;

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50/50 transition';
                tr.innerHTML = `
                    <td class="px-8 py-5">
                         <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center border border-purple-100">
                                <i class="fa-solid fa-ticket-simple"></i>
                            </div>
                            <div>
                                <p class="font-bold text-sm text-accent-navy">${coupon.code}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-5">
                        <span class="font-extrabold text-brand-500 text-sm">${discountDisplay}</span>
                    </td>
                    <td class="px-6 py-5 text-sm font-bold text-gray-600">₹${coupon.minimumPurchase}</td>
                    <td class="px-6 py-5 text-sm font-bold text-gray-600">${coupon.maximumDiscount ? '₹' + coupon.maximumDiscount : '-'}</td>
                    <td class="px-6 py-5 text-sm font-medium text-gray-500">
                        <div class="flex flex-col">
                            <span class="text-[10px] uppercase text-gray-400">Valid: ${new Date(coupon.startDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short' })}</span>
                            <span class="font-bold text-gray-600">Until: ${new Date(coupon.expiryDate).toLocaleDateString('en-US', { day: 'numeric', month: 'short' })}</span>
                        </div>
                    </td>
                    <td class="px-6 py-5 text-xs font-bold text-gray-500">${coupon.usageCount || 0} times</td>
                    <td class="px-6 py-5">
                         <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide ${statusClass}">
                            ${statusText}
                        </span>
                    </td>
                    <td class="px-8 py-5">
                         <div class="flex items-center gap-3">
                            <button onclick="openEditCouponModal('${coupon._id}')" 
                                class="flex items-center gap-2 bg-pink-50 text-pink-500 px-4 py-1.5 rounded-lg text-[10px] font-bold hover:bg-pink-500 hover:text-white transition">
                                <i class="fa-solid fa-pen"></i> Edit
                            </button>
                             <button onclick="confirmDelete('${coupon._id}', '${coupon.code}')" 
                                class="w-8 h-8 flex items-center justify-center bg-red-50 text-red-500 rounded-lg text-xs hover:bg-red-500 hover:text-white transition">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            renderPagination();
        }

        // --- FILTER & SEARCH ---
        function setupSearchAndFilter() {
            const searchInput = document.querySelector('input[placeholder="Search coupons by code..."]');
            const statusFilter = document.querySelector('select:nth-of-type(1)'); // Status select
            const sortFilter = document.querySelector('select:nth-of-type(2)');   // Sort select

            function applyFilters() {
                const query = searchInput.value.toLowerCase();
                const status = statusFilter.value;
                const sort = sortFilter.value;

                const today = new Date();
                today.setHours(0, 0, 0, 0);

                filteredCoupons = couponsData.filter(c => {
                    const matchesSearch = c.code.toLowerCase().includes(query);
                    let matchesStatus = true;

                    if (status) {
                        const startDate = new Date(c.startDate);
                        startDate.setHours(0, 0, 0, 0);
                        const expiryDate = new Date(c.expiryDate);
                        expiryDate.setHours(0, 0, 0, 0);

                        const isExpired = expiryDate < today;
                        const isPending = startDate > today;

                        let currentStatus = '';
                        if (isExpired) currentStatus = 'expired';
                        else if (isPending) currentStatus = 'pending';
                        else if (c.isActive) currentStatus = 'active';
                        else currentStatus = 'inactive';

                        matchesStatus = (currentStatus === status);
                    }

                    return matchesSearch && matchesStatus;
                });

                // Sort
                if (sort === 'newest') {
                    filteredCoupons.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
                } else if (sort === 'oldest') {
                    filteredCoupons.sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
                } else if (sort === 'usage') {
                    filteredCoupons.sort((a, b) => (b.usageCount || 0) - (a.usageCount || 0));
                }

                currentPage = 1;
                renderTable();
            }

            searchInput.addEventListener('input', applyFilters);
            statusFilter.addEventListener('change', applyFilters);
            sortFilter.addEventListener('change', applyFilters);
        }

        function renderPagination() {
            const totalPages = Math.ceil(filteredCoupons.length / itemsPerPage);
            const controls = document.getElementById('paginationControls');

            if (filteredCoupons.length === 0) {
                controls.innerHTML = '';
                return;
            }

            // Calculate range
            const startItem = (currentPage - 1) * itemsPerPage + 1;
            const endItem = Math.min(currentPage * itemsPerPage, filteredCoupons.length);

            let buttons = '';

            // Prev Button
            buttons += `
                <button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} 
                    class="w-8 h-8 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </button>
            `;

            // Page Numbers Logic
            const pages = [];
            if (totalPages <= 7) {
                for (let i = 1; i <= totalPages; i++) pages.push(i);
            } else {
                pages.push(1);
                if (currentPage > 3) pages.push('...');

                let start = Math.max(2, currentPage - 1);
                let end = Math.min(totalPages - 1, currentPage + 1);

                if (currentPage <= 3) {
                    end = 4;
                }
                if (currentPage >= totalPages - 2) {
                    start = totalPages - 3;
                }

                for (let i = start; i <= end; i++) {
                    if (i > 1 && i < totalPages) pages.push(i);
                }

                if (currentPage < totalPages - 2) pages.push('...');
                pages.push(totalPages);
            }

            pages.forEach(p => {
                if (p === '...') {
                    buttons += `<span class="w-8 h-8 flex items-center justify-center text-gray-400 font-bold select-none">...</span>`;
                } else {
                    const isActive = p === currentPage;
                    const classes = isActive
                        ? 'bg-brand-500 text-white shadow-lg shadow-brand-500/20'
                        : 'border border-gray-100 text-gray-400 hover:bg-gray-50 hover:text-accent-navy';

                    buttons += `
                        <button onclick="changePage(${p})" 
                            class="w-8 h-8 rounded-lg flex items-center justify-center text-xs font-bold transition ${classes}">
                            ${p}
                        </button>
                    `;
                }
            });

            // Next Button
            buttons += `
                <button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} 
                    class="w-8 h-8 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            `;

            controls.innerHTML = `
                <p class="text-xs font-bold text-gray-400">Showing ${startItem}-${endItem} of ${filteredCoupons.length} coupons</p>
                <div class="flex gap-2 items-center">
                    ${buttons}
                </div>
            `;
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredCoupons.length / itemsPerPage);
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderTable();
        }


        // --- MODAL & API HANDLERS ---
        const addModal = document.getElementById('addCouponModal');
        const editModal = document.getElementById('editCouponModal');

        function openAddCouponModal() {
            document.getElementById('addCouponForm').reset();
            toggleMaxDiscount('add');
            addModal.classList.remove('hidden');
            addModal.classList.add('flex');
        }

        function openEditCouponModal(id) {
            const coupon = couponsData.find(c => c._id === id);
            if (!coupon) return;

            document.getElementById('editCouponId').value = coupon._id;
            document.getElementById('editCode').value = coupon.code;
            document.getElementById('editDiscountType').value = coupon.discountType;
            document.getElementById('editDiscountValue').value = coupon.discountValue;
            document.getElementById('editMinimumPurchase').value = coupon.minimumPurchase;
            document.getElementById('editMaxDiscount').value = coupon.maximumDiscount || '';
            document.getElementById('editUsageLimit').value = coupon.usageLimit || '';
            document.getElementById('editStartDate').value = new Date(coupon.startDate).toISOString().split('T')[0];
            document.getElementById('editExpiryDate').value = new Date(coupon.expiryDate).toISOString().split('T')[0];
            document.getElementById('editStatus').value = coupon.isActive.toString();

            toggleMaxDiscount('edit');
            editModal.classList.remove('hidden');
            editModal.classList.add('flex');
        }

        function closeModal(modalId) {
            const m = document.getElementById(modalId);
            m.classList.add('hidden');
            m.classList.remove('flex');
        }

        function toggleMaxDiscount(prefix) {
            const typeSelect = document.getElementById(`${prefix}DiscountType`);
            const maxDiscountInput = document.getElementById(`${prefix}MaxDiscount`);
            const maxDiscountContainer = maxDiscountInput.parentElement;

            if (typeSelect.value === 'fixed') {
                maxDiscountInput.value = '';
                maxDiscountInput.disabled = true;
                maxDiscountContainer.style.opacity = '0.5';
                maxDiscountInput.placeholder = "Not Applicable";
            } else {
                maxDiscountInput.disabled = false;
                maxDiscountContainer.style.opacity = '1';
                maxDiscountInput.placeholder = "Optional";
            }
        }

        function validateCouponData(data) {

            const errors = [];

            const discountValue = Number(data.discountValue);
            const minimumPurchase = Number(data.minimumPurchase) || 0;
            const usageLimit = Number(data.usageLimit);
            const code = data.code.trim().toUpperCase();
            const couponRegex = /^[A-Z0-9]{4,20}$/;

            if (!couponRegex.test(code)) {
                errors.push(
                    "Coupon code must contain only letters and numbers (4–20 characters)."
                );
            }

            if (!data.code || data.code.trim().length < 4) {
                errors.push("Coupon code must be at least 4 characters.");
            }

            if (!discountValue || discountValue <= 0) {
                errors.push("Discount value must be positive.");
            }

            if (data.discountType === "percentage" && discountValue > 90) {
                errors.push("Percentage discount cannot exceed 90%");
            }

            if (data.discountType === "fixed") {

                if (minimumPurchase <= 0) {
                    errors.push("Minimum purchase must be greater than 0 for fixed coupons.");
                }

                const maxDiscount = minimumPurchase * 0.9;

                if (discountValue > maxDiscount) {
                    errors.push("Discount cannot exceed 90% of minimum purchase amount.");
                }
            }

            if (data.usageLimit && usageLimit <= 0) {
                errors.push("Usage limit should be greater than 0");
            }

            if (!data.startDate) {
                errors.push("Start date is required.");
            }

            if (!data.expiryDate) {
                errors.push("Expiry date is required.");
            }

            if (data.startDate && data.expiryDate) {

                const start = new Date(data.startDate);
                const end = new Date(data.expiryDate);

                const today = new Date();
                today.setHours(0, 0, 0, 0);

                if (end < today) {
                    errors.push("Expiry date cannot be in the past.");
                }

                if (start > end) {
                    errors.push("Start date must be before expiry date.");
                }
            }

            return errors;
        }


        async function handleAddCoupon(e) {
            e.preventDefault();
            const btn = document.getElementById('addSubmitBtn');

            const formData = {
                code: document.getElementById('addCode').value,
                discountType: document.getElementById('addDiscountType').value,
                discountValue: document.getElementById('addDiscountValue').value,
                minimumPurchase: document.getElementById('addMinimumPurchase').value,
                maximumDiscount: document.getElementById('addMaxDiscount').value,
                usageLimit: document.getElementById('addUsageLimit').value,
                startDate: document.getElementById('addStartDate').value,
                expiryDate: document.getElementById('addExpiryDate').value,
                isActive: document.getElementById('addStatus').value
            };

            const errors = validateCouponData(formData);
            if (errors.length > 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    html: errors.join('<br>'),
                    confirmButtonText: 'OK'
                });
                return;
            }

            const originalText = btn.innerText;
            btn.innerText = 'Creating...';
            btn.disabled = true;

            try {
                const res = await fetch('/admin/coupons/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await res.json();

                if (res.ok && data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: data.message,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => location.reload());
                } else {
                    throw new Error(data.message || 'Validation Failed');
                }
            } catch (err) {
                Swal.fire('Error', err.message, 'error');
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }

        async function handleEditCoupon(e) {
            e.preventDefault();
            const id = document.getElementById('editCouponId').value;
            const btn = document.getElementById('editSubmitBtn');

            const formData = {
                code: document.getElementById('editCode').value,
                discountType: document.getElementById('editDiscountType').value,
                discountValue: document.getElementById('editDiscountValue').value,
                minimumPurchase: document.getElementById('editMinimumPurchase').value,
                maximumDiscount: document.getElementById('editMaxDiscount').value,
                usageLimit: document.getElementById('editUsageLimit').value,
                startDate: document.getElementById('editStartDate').value,
                expiryDate: document.getElementById('editExpiryDate').value,
                isActive: document.getElementById('editStatus').value
            };

            const errors = validateCouponData(formData);
            if (errors.length > 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    html: errors.join('<br>'),
                    confirmButtonText: 'OK'
                });
                return;
            }

            const originalText = btn.innerText;
            btn.innerText = 'Saving...';
            btn.disabled = true;

            try {
                const res = await fetch(`/admin/coupons/edit/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await res.json();

                if (res.ok && data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated',
                        text: data.message,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => location.reload());
                } else {
                    throw new Error(data.message || 'Update Failed');
                }
            } catch (err) {
                Swal.fire('Error', err.message, 'error');
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }

        function confirmDelete(id, code) {
            Swal.fire({
                title: 'Delete Coupon?',
                text: `Are you sure you want to delete ${code}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'Yes, delete it!'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/admin/coupons/delete/${id}`, { method: 'DELETE' });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Deleted!', 'Coupon has been deleted.', 'success')
                                .then(() => location.reload());
                        } else {
                            throw new Error(data.message);
                        }
                    } catch (err) {
                        Swal.fire('Error', err.message, 'error');
                    }
                }
            });
        }

    </script>
</body>

