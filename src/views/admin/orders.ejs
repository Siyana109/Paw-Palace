<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management | PawPalace Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#fff1f2', 100: '#ffe4e6', 500: '#f43f5e', 600: '#e11d48' },
                        accent: { navy: '#0f172a', teal: '#2dd4bf' }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #cbd5e1;
        }

        /* Drawer Transition */
        .drawer {
            transition: transform 0.3s ease-in-out;
        }

        .drawer-open {
            transform: translateX(0);
        }

        .drawer-closed {
            transform: translateX(100%);
        }
    </style>
</head>

<body class="bg-gray-50 font-sans text-accent-navy overflow-hidden">

    <div class="flex h-screen">
        <%- include('../partials/adminSidebar') %>

            <main class="flex-1 p-8 h-full overflow-y-auto custom-scrollbar relative">
                <!-- HEADER -->
                <header class="flex justify-between items-center mb-8">
                    <div>
                        <h1 class="text-3xl font-bold text-accent-navy">Order History</h1>
                        <p class="text-gray-400 font-medium text-sm mt-1">View and manage all customer orders</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <div
                            class="bg-teal-50 text-teal-600 p-2 rounded-full w-10 h-10 flex items-center justify-center font-bold shadow-sm">
                            A
                        </div>
                        <div>
                            <p class="text-sm font-bold text-accent-navy">Admin User</p>
                            <p class="text-xs text-gray-400 font-semibold">Super Admin</p>
                        </div>
                    </div>
                </header>

                <!-- STATS CARDS -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <!-- Total Orders -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Total Orders
                            </p>
                            <h3 class="text-3xl font-extrabold text-accent-navy">
                                <%= stats.total %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-gray-50 text-gray-400 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-solid fa-box-open"></i>
                        </div>
                    </div>

                    <!-- Completed -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Completed</p>
                            <h3 class="text-3xl font-extrabold text-brand-500">
                                <%= stats.completed %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-brand-50 text-brand-500 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-solid fa-check"></i>
                        </div>
                    </div>

                    <!-- Pending -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Pending</p>
                            <h3 class="text-3xl font-extrabold text-orange-400">
                                <%= stats.pending %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-orange-50 text-orange-400 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-regular fa-clock"></i>
                        </div>
                    </div>

                    <!-- Cancelled -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Cancelled</p>
                            <h3 class="text-3xl font-extrabold text-red-500">
                                <%= stats.cancelled %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-solid fa-ban"></i>
                        </div>
                    </div>
                </div>

                <!-- FILTERS & TABLE -->
                <div class="bg-white rounded-[2.5rem] shadow-sm border border-gray-100 overflow-hidden mb-8">

                    <!-- FILTER BAR -->
                    <form action="/admin/orders" method="GET"
                        class="p-6 border-b border-gray-50 flex flex-wrap gap-4 items-center justify-between">
                        <!-- Search -->
                        <div class="relative w-full max-w-sm group">
                            <i
                                class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-brand-500 transition"></i>
                            <input type="text" name="search" value="<%= query.search || '' %>"
                                placeholder="Order ID, User, or Product..."
                                class="w-full pl-12 pr-10 py-3 bg-gray-50 border-2 border-transparent focus:border-brand-50 rounded-2xl focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand-500/10 transition font-medium text-sm">
                            <% if (query.search) { %>
                                <a href="/admin/orders"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 transition"
                                    title="Clear Search">
                                    <i class="fa-solid fa-xmark"></i>
                                </a>
                                <% } %>
                        </div>

                        <div class="flex items-center gap-3 overflow-x-auto pb-2 md:pb-0">
                            <!-- Status Filter -->
                            <div class="relative">
                                <select name="status" onchange="this.form.submit()"
                                    class="appearance-none bg-gray-50 border border-gray-100 rounded-xl pl-4 pr-10 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer hover:bg-gray-100 transition focus:border-brand-200">
                                    <option value="">Status: All</option>
                                    <% ['Pending' , 'Processing' , 'Shipped' , 'Delivered' , 'Cancelled' , 'Returned'
                                        , 'Failed' ].forEach(s=> { %>
                                        <option value="<%= s %>" <%=query.status===s ? 'selected' : '' %>><%= s %>
                                        </option>
                                        <% }) %>
                                </select>
                                <i
                                    class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-gray-400 pointer-events-none"></i>
                            </div>
                            <!-- Payment Filter -->
                            <div class="relative">
                                <select name="payment" onchange="this.form.submit()"
                                    class="appearance-none bg-gray-50 border border-gray-100 rounded-xl pl-4 pr-10 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer hover:bg-gray-100 transition focus:border-brand-200">
                                    <option value="">Payment: All</option>
                                    <option value="Online" <%=query.payment==='Online' ? 'selected' : '' %>>Online
                                    </option>
                                    <option value="COD" <%=query.payment==='COD' ? 'selected' : '' %>>COD</option>
                                    <option value="Wallet" <%=query.payment==='Wallet' ? 'selected' : '' %>>Wallet
                                    </option>
                                </select>
                                <i
                                    class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-gray-400 pointer-events-none"></i>
                            </div>
                            <!-- Sort Filter -->
                            <div class="relative">
                                <select name="sort" onchange="this.form.submit()"
                                    class="appearance-none bg-gray-50 border border-gray-100 rounded-xl pl-4 pr-10 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer hover:bg-gray-100 transition focus:border-brand-200">
                                    <option value="newest" <%=(!query.sort || query.sort==='newest' ) ? 'selected' : ''
                                        %>>Date: Newest</option>
                                    <option value="oldest" <%=query.sort==='oldest' ? 'selected' : '' %>>Date: Oldest
                                    </option>
                                    <option value="amount_high" <%=query.sort==='amount_high' ? 'selected' : '' %>
                                        >Amount: High to Low</option>
                                    <option value="amount_low" <%=query.sort==='amount_low' ? 'selected' : '' %>>Amount:
                                        Low to High</option>
                                </select>
                                <i
                                    class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-gray-400 pointer-events-none"></i>
                            </div>
                        </div>
                    </form>

                    <!-- TABLE -->
                    <div class="overflow-x-auto min-h-[400px]">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-gray-50/50 sticky top-0 z-10">
                                <tr
                                    class="text-gray-400 text-[10px] font-bold uppercase tracking-widest border-b border-gray-100 text-left">
                                    <th class="px-8 py-5">Order ID</th>
                                    <th class="px-6 py-5">User</th>
                                    <th class="px-6 py-5">Products</th>
                                    <th class="px-6 py-5">Amount</th>
                                    <th class="px-6 py-5">Payment Method</th>
                                    <th class="px-6 py-5">Status</th>
                                    <th class="px-6 py-5">Date</th>
                                    <th class="px-8 py-5 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% if (orders.length> 0) { %>
                                    <% orders.forEach(order=> {
                                        let statusColor = 'bg-gray-50 text-gray-500';
                                        if (['Delivered', 'Completed'].includes(order.orderStatus)) statusColor =
                                        'bg-teal-50 text-teal-600';
                                        else if (['Pending', 'Placed'].includes(order.orderStatus)) statusColor =
                                        'bg-orange-50 text-orange-600';
                                        else if (order.orderStatus === 'Processing')
                                        statusColor = 'bg-blue-50 text-blue-600';
                                        else if (['Cancelled', 'Failed', 'Returned'].includes(order.orderStatus))
                                        statusColor = 'bg-red-50 text-red-600';

                                        const itemsCount = order.items.reduce((acc, item) => acc + item.quantity, 0);
                                        const initials = order.userId && order.userId.fullName
                                        ? order.userId.fullName
                                        .split(' ')
                                        .map(n => n[0])
                                        .join('')
                                        .substring(0, 2)
                                        .toUpperCase()
                                        : '??';
                                        %>
                                        <tr class="hover:bg-gray-50/50 transition group">
                                            <td class="px-8 py-5">
                                                <span class="font-bold text-brand-500 text-xs">#<%= order.orderId %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-5">
                                                <div class="flex items-center gap-3">
                                                    <div
                                                        class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-[10px] font-bold shadow-sm">
                                                        <%= initials %>
                                                    </div>
                                                    <p class="font-bold text-sm text-accent-navy">
                                                        <%= order.userId?.fullName || 'Unknown User' %>
                                                    </p>
                                                </div>
                                            </td>
                                            <td class="px-6 py-5">
                                                <div class="flex items-center gap-2 text-gray-500">
                                                    <i class="fa-solid fa-box text-xs"></i>
                                                    <span class="text-xs font-bold">
                                                        <%= itemsCount %> items
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-5">
                                                <span class="font-extrabold text-accent-navy text-sm">₹<%=
                                                        order.totalAmount.toFixed(2) %></span>
                                            </td>
                                            <td class="px-6 py-5">
                                                <span class="text-xs font-medium text-gray-500 uppercase">
                                                    <%= order.payment.method %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-5">
                                                <span
                                                    class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide <%= statusColor %>">
                                                    <%= order.orderStatus %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-5">
                                                <span class="text-xs font-bold text-gray-500">
                                                    <%= new Date(order.createdAt).toLocaleDateString() %>
                                                </span>
                                            </td>
                                            <td class="px-8 py-5 text-right">
                                                <button onclick="openDrawer('<%= order._id %>')"
                                                    class="text-brand-500 hover:text-brand-600 font-bold text-xs flex items-center justify-end gap-1 transition hover:gap-2 ml-auto">
                                                    <i class="fa-regular fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="8" class="text-center py-20">
                                                        <div class="flex flex-col items-center">
                                                            <div
                                                                class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center text-2xl text-gray-300 mb-4">
                                                                <i class="fa-solid fa-box-open"></i>
                                                            </div>
                                                            <h3 class="text-lg font-bold text-gray-900">No orders found
                                                            </h3>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- PAGINATION -->
                    <div
                        class="p-6 border-t border-gray-50 flex flex-col md:flex-row items-center justify-between gap-4">
                        <!-- Info Text -->
                        <div class="text-xs text-gray-400 font-bold">
                            Showing <%= (currentPage - 1) * 10 + 1 %>-<%= Math.min(currentPage * 10, stats.total) %> of
                                    <%= stats.total %> results
                        </div>

                        <!-- Pagination Controls -->
                        <% if (totalPages> 0) { %>
                            <div class="flex items-center gap-2">
                                <% const getPageUrl=(page)=> {
                                    const params = new URLSearchParams();
                                    Object.keys(query).forEach(key => {
                                    if (query[key] && key !== 'page') {
                                    params.append(key, query[key]);
                                    }
                                    });
                                    params.append('page', page);
                                    return `/admin/orders?${params.toString()}`;
                                    };
                                    %>

                                    <!-- Previous Button -->
                                    <a href="<%= currentPage > 1 ? getPageUrl(currentPage - 1) : '#' %>"
                                        class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center transition bg-white <%= currentPage > 1 ? 'text-brand-500 hover:bg-brand-50' : 'text-gray-300 pointer-events-none' %>">
                                        <i class="fa-solid fa-chevron-left text-[10px]"></i>
                                    </a>

                                    <!-- Page Numbers -->
                                    <% let startPage=Math.max(1, currentPage - 2); let endPage=Math.min(totalPages,
                                        startPage + 4); if (endPage - startPage < 4) { startPage=Math.max(1, endPage -
                                        4); } if (startPage> 1) { %>
                                        <a href="<%= getPageUrl(1) %>"
                                            class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition bg-white text-xs font-bold">1</a>
                                        <% if (startPage> 2) { %>
                                            <span class="text-xs text-gray-400">...</span>
                                            <% } %>
                                                <% } %>

                                                    <% for(let i=startPage; i <=endPage; i++) { %>
                                                        <a href="<%= getPageUrl(i) %>"
                                                            class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition <%= currentPage === i ? 'bg-brand-500 text-white shadow-lg shadow-brand-500/20' : 'bg-white border border-gray-100 text-gray-500 hover:bg-brand-50 hover:text-brand-500' %>">
                                                            <%= i %>
                                                        </a>
                                                        <% } %>

                                                            <% if (endPage < totalPages) { %>
                                                                <% if (endPage < totalPages - 1) { %>
                                                                    <span class="text-xs text-gray-400">...</span>
                                                                    <% } %>
                                                                        <a href="<%= getPageUrl(totalPages) %>"
                                                                            class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition bg-white text-xs font-bold">
                                                                            <%= totalPages %>
                                                                        </a>
                                                                        <% } %>

                                                                            <!-- Next Button -->
                                                                            <a href="<%= currentPage < totalPages ? getPageUrl(currentPage + 1) : '#' %>"
                                                                                class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center transition bg-white <%= currentPage < totalPages ? 'text-brand-500 hover:bg-brand-50' : 'text-gray-300 pointer-events-none' %>">
                                                                                <i
                                                                                    class="fa-solid fa-chevron-right text-[10px]"></i>
                                                                            </a>
                            </div>
                            <% } %>
                    </div>
                </div>

            </main>
    </div>

    <!-- SIDE DRAWER & OVERLAY -->
    <!-- Overlay -->
    <div id="drawerOverlay" onclick="closeDrawer()"
        class="fixed inset-0 bg-black/20 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></div>

    <!-- Drawer -->
    <div id="orderDrawer"
        class="drawer drawer-closed fixed top-0 right-0 w-full md:w-[480px] h-full bg-white shadow-2xl z-50 flex flex-col">
        <!-- Drawer Header -->
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
            <div>
                <h2 class="text-xl font-bold text-accent-navy">Order Details</h2>
                <p id="drawerOrderId" class="text-xs font-bold text-brand-500 mt-1">#LOADING...</p>
            </div>
            <button onclick="closeDrawer()"
                class="w-8 h-8 rounded-full bg-white border border-gray-200 text-gray-400 hover:text-red-500 hover:border-red-100 flex items-center justify-center transition">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Drawer Content -->
        <div id="drawerContent" class="flex-1 overflow-y-auto p-6 space-y-8 custom-scrollbar">
            <!-- Loading Spinner Initially -->
            <div class="flex items-center justify-center h-40">
                <i class="fa-solid fa-circle-notch fa-spin text-brand-500 text-3xl"></i>
            </div>
        </div>

        <!-- Drawer Footer (Actions) -->
        <div class="p-6 border-t border-gray-100 bg-gray-50/50">
            <div class="mb-4">
                <label class="block text-xs font-bold text-gray-500 mb-2 uppercase tracking-wide">Update Order
                    Status</label>
                <select id="updateStatusSelect"
                    class="w-full bg-white border border-gray-200 text-gray-700 text-sm font-bold rounded-xl px-4 py-3 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition">
                    <option value="Processing">Processing</option>
                    <option value="Shipped">Shipped</option>
                    <option value="Out for Delivery">Out for Delivery</option>
                    <option value="Delivered">Delivered</option>
                </select>
            </div>

            <div class="flex gap-3">
                <button onclick="closeDrawer()"
                    class="flex-1 py-3 rounded-xl border border-gray-200 text-gray-500 font-bold text-sm hover:bg-gray-50 transition">
                    Cancel
                </button>
                <button onclick="saveOrderStatus()"
                    class="flex-1 py-3 rounded-xl bg-brand-500 text-white font-bold text-sm hover:bg-brand-600 shadow-lg shadow-brand-500/20 transition">
                    Save Changes
                </button>
            </div>
        </div>
    </div>


    <script>
        let currentOrderId = null;

        function openDrawer(orderId) {
            currentOrderId = orderId;
            const drawer = document.getElementById('orderDrawer');
            const overlay = document.getElementById('drawerOverlay');

            // Show UI
            drawer.classList.remove('drawer-closed');
            drawer.classList.add('drawer-open');
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.remove('opacity-0'), 10); // Fade in

            // Fetch Details
            fetchOrderDetails(orderId);
        }

        function closeDrawer() {
            const drawer = document.getElementById('orderDrawer');
            const overlay = document.getElementById('drawerOverlay');

            drawer.classList.remove('drawer-open');
            drawer.classList.add('drawer-closed');

            overlay.classList.add('opacity-0');
            setTimeout(() => overlay.classList.add('hidden'), 300);

            // Reset content after anim
            setTimeout(() => {
                document.getElementById('drawerContent').innerHTML = '<div class="flex items-center justify-center h-40"><i class="fa-solid fa-circle-notch fa-spin text-brand-500 text-3xl"></i></div>';
            }, 300);
        }

        async function fetchOrderDetails(id) {
            try {
                const response = await fetch(`/admin/orders/${id}/details`);
                const data = await response.json();

                if (data.success) {
                    renderDrawerContent(data.order);
                } else {
                    Swal.fire("Error", "Failed to load order/details", "error");
                    closeDrawer();
                }
            } catch (error) {
                console.error(error);
                Swal.fire("Error", "Server error", "error");
            }
        }

        function renderDrawerContent(order) {
            document.getElementById('drawerOrderId').textContent = `ID: #${order.orderId}`;
            document.getElementById('updateStatusSelect').value = order.orderStatus;

            const content = document.getElementById('drawerContent');

            // Generate HTML for Items
            const itemsHtml = order.items.map(item => `
                <div class="flex gap-4 items-center mb-4 last:mb-0">
                    <div class="w-16 h-16 bg-gray-50 rounded-xl border border-gray-100 p-1 flex-shrink-0">
                        <img src="${item.variantId?.coverImage || '/default.png'}" class="w-full h-full object-cover rounded-lg">
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-accent-navy text-sm line-clamp-1">${item.productName}</p>
                        <p class="text-xs text-gray-500">Qty: ${item.quantity} × ₹${item.price}</p>
                    </div>
                    <p class="font-bold text-accent-navy text-sm">₹${(item.price * item.quantity).toFixed(2)}</p>
                </div>
            `).join('');

            content.innerHTML = `
                <!-- Customer Info -->
                <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Customer Information</h4>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center font-bold">
                            ${order.userId?.fullName.charAt(0) || 'U'}
                        </div>
                        <div>
                            <p class="font-bold text-accent-navy text-sm">${order.userId?.fullName}</p>
                            <p class="text-xs text-gray-500">${order.userId?.email}</p>
                            <p class="text-xs text-gray-500">${order.address?.phone || '-'}</p>
                        </div>
                    </div>
                    <div class="flex gap-2 text-xs text-gray-500">
                        <i class="fa-solid fa-location-dot mt-0.5"></i>
                        <p>${order.address?.addressLine}, ${order.address?.city}, ${order.address?.state} - ${order.address?.zipCode}</p>
                    </div>
                </div>

                <!-- Products -->
                <div>
                     <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Ordered Items</h4>
                     ${itemsHtml}
                </div>

                <!-- Payment Info -->
                <div class="bg-indigo-50/50 rounded-2xl p-5 border border-indigo-100/50">
                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">Payment Details</h4>
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-xs font-bold text-gray-500">Method</span>
                        <span class="text-xs font-bold text-accent-navy uppercase">${order.payment.method}</span>
                    </div>
                     <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-gray-500">Status</span>
                        <span class="text-xs font-bold ${order.payment.status === 'Paid' ? 'text-green-600' : 'text-orange-500'}">${order.payment.status}</span>
                    </div>
                </div>

                <!-- Summary -->
                <div class="pt-4 border-t border-gray-100 space-y-2">
                    <div class="flex justify-between text-xs text-gray-500">
                        <span>Subtotal</span>
                        <span>₹${(order.subtotal || 0).toFixed(2)}</span>
                    </div>
                    <div class="flex justify-between text-xs text-gray-500">
                        <span>Shipping</span>
                        <span>+₹${(order.totalAmount - order.subtotal + (order.discount || 0)).toFixed(2)}</span>
                    </div>
                    <div class="flex justify-between text-xs text-gray-500">
                        <span>Coupon Discount</span>
                        <span class="text-green-500">-₹${(order.discount || 0).toFixed(2)}</span>
                    </div>
                    <!-- Note: Offer discounts are currently applied directly to item prices -->
                    
                    <div class="flex justify-between text-base font-black text-accent-navy pt-2 border-t border-dashed border-gray-100">
                        <span>Grand Total</span>
                        <span>₹${order.totalAmount.toFixed(2)}</span>
                    </div>
                </div>
            `;
        }

        async function saveOrderStatus() {
            if (!currentOrderId) return;

            const newStatus = document.getElementById('updateStatusSelect').value;

            try {
                const response = await fetch(`/admin/orders/${currentOrderId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: 'Order status updated successfully',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.reload(); // Reload to reflect changes in list
                    });
                } else {
                    Swal.fire("Error", data.message, "error");
                }
            } catch (error) {
                console.error(error);
                Swal.fire("Error", "Failed to update status", "error");
            }
        }
    </script>
</body>

</html>