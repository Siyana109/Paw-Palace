<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management | PawPalace Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#fff1f2', 100: '#ffe4e6', 500: '#f43f5e', 600: '#e11d48' },
                        accent: { navy: '#0f172a', teal: '#2dd4bf' }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #cbd5e1;
        }
    </style>
</head>

<body class="bg-gray-50 font-sans text-accent-navy">

    <div class="flex min-h-screen">
        <%- include('../partials/adminSidebar') %>

            <main class="flex-1 p-8 h-screen overflow-y-auto custom-scrollbar">
                <!-- HEADER -->
                <header class="flex justify-between items-center mb-8">
                    <div>
                        <h1 class="text-3xl font-bold text-accent-navy">Order History</h1>
                        <p class="text-gray-400 font-medium text-sm mt-1">View and manage all customer orders</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <div
                            class="bg-teal-50 text-teal-600 p-2 rounded-full w-10 h-10 flex items-center justify-center font-bold shadow-sm">
                            A
                        </div>
                        <div>
                            <p class="text-sm font-bold text-accent-navy">Admin User</p>
                            <p class="text-xs text-gray-400 font-semibold">Super Admin</p>
                        </div>
                    </div>
                </header>

                <!-- STATS CARDS -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <!-- Total Orders -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Total Orders
                            </p>
                            <h3 class="text-3xl font-extrabold text-accent-navy" id="statTotal">0</h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-gray-50 text-gray-400 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-solid fa-box-open"></i>
                        </div>
                    </div>

                    <!-- Completed -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Completed</p>
                            <h3 class="text-3xl font-extrabold text-brand-500" id="statCompleted">0</h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-brand-50 text-brand-500 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-solid fa-check"></i>
                        </div>
                    </div>

                    <!-- Pending -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Pending</p>
                            <h3 class="text-3xl font-extrabold text-orange-400" id="statPending">0</h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-orange-50 text-orange-400 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-regular fa-clock"></i>
                        </div>
                    </div>

                    <!-- Cancelled -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between group hover:shadow-md transition">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Cancelled</p>
                            <h3 class="text-3xl font-extrabold text-red-500" id="statCancelled">0</h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center text-xl group-hover:scale-110 transition">
                            <i class="fa-solid fa-ban"></i>
                        </div>
                    </div>
                </div>

                <!-- CONTROLS & FILTERS -->
                <div class="bg-white rounded-[2.5rem] shadow-sm border border-gray-100 overflow-hidden mb-8">
                    <div class="p-6 border-b border-gray-50 flex flex-wrap gap-4 items-center justify-between">

                        <!-- Search -->
                        <div class="relative w-full max-w-sm group">
                            <i
                                class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-brand-500 transition"></i>
                            <input type="text" id="searchInput" placeholder="Search Filter..."
                                class="w-full pl-12 pr-4 py-3 bg-gray-50 border-2 border-transparent focus:border-brand-50 rounded-2xl focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand-500/10 transition font-medium text-sm">
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center gap-3 overflow-x-auto pb-2 md:pb-0">

                            <!-- Date Filter (Optional as per user request, but good to have ui for future) -> Removed Logic but kept UI minimal if needed, user said 'no need of date based sorting', but date filtering is often useful. user request said 'no need of that date based sorting', so I will remove the UI sort option, but maybe keep simple filters. Let's stick to what was asked: User said: "include all functionalities like sorting(no need of that date based sorting) real time search , pagination and everything we need in frontend". -->

                            <!-- Status Filter -->
                            <div class="relative">
                                <i
                                    class="fa-solid fa-filter absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs z-10"></i>
                                <select id="statusFilter" onchange="applyFilters()"
                                    class="appearance-none bg-gray-50 border border-gray-100 rounded-xl pl-8 pr-10 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer hover:bg-gray-100 transition focus:border-brand-200">
                                    <option value="">Status: All</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Processing">Processing</option>
                                    <option value="Cancelled">Cancelled</option>
                                    <option value="Failed">Failed</option>
                                </select>
                                <i
                                    class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-gray-400 pointer-events-none"></i>
                            </div>

                            <!-- Payment Filter -->
                            <div class="relative">
                                <i
                                    class="fa-regular fa-credit-card absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs z-10"></i>
                                <select id="paymentFilter" onchange="applyFilters()"
                                    class="appearance-none bg-gray-50 border border-gray-100 rounded-xl pl-8 pr-10 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer hover:bg-gray-100 transition focus:border-brand-200">
                                    <option value="">Payment: All</option>
                                    <option value="Online">Online</option>
                                    <option value="COD">COD</option>
                                    <option value="Wallet">Wallet</option>
                                </select>
                                <i
                                    class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-gray-400 pointer-events-none"></i>
                            </div>

                            <!-- Sort -->
                            <div class="relative">
                                <i
                                    class="fa-solid fa-arrow-up-wide-short absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs z-10"></i>
                                <select id="sortFilter" onchange="applyFilters()"
                                    class="appearance-none bg-gray-50 border border-gray-100 rounded-xl pl-8 pr-10 py-2.5 text-xs font-bold text-gray-500 outline-none cursor-pointer hover:bg-gray-100 transition focus:border-brand-200">
                                    <option value="newest">Sort By</option>
                                    <option value="amount_high">Amount (High)</option>
                                    <option value="amount_low">Amount (Low)</option>
                                    <option value="status_asc">Status (A-Z)</option>
                                </select>
                                <i
                                    class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-gray-400 pointer-events-none"></i>
                            </div>

                        </div>
                    </div>

                    <!-- TABLE -->
                    <div class="overflow-x-auto min-h-[400px]">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-gray-50/50 sticky top-0 z-10">
                                <tr
                                    class="text-gray-400 text-[10px] font-bold uppercase tracking-widest border-b border-gray-100 text-left">
                                    <th class="px-8 py-5">Order ID</th>
                                    <th class="px-6 py-5">User</th>
                                    <th class="px-6 py-5">Products</th>
                                    <th class="px-6 py-5">Amount</th>
                                    <th class="px-6 py-5">Payment Method</th>
                                    <th class="px-6 py-5">Status</th>
                                    <th class="px-6 py-5">Date</th>
                                    <th class="px-8 py-5 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="ordersTableBody" class="divide-y divide-gray-50">
                                <!-- Rows rendered by JS -->
                            </tbody>
                        </table>

                        <!-- Empty State -->
                        <div id="emptyState" class="hidden flex-col items-center justify-center py-20 text-center">
                            <div
                                class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center text-3xl text-gray-300 mb-4">
                                <i class="fa-solid fa-box-open"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">No orders found</h3>
                            <p class="text-sm text-gray-400">Try adjusting your search or filters</p>
                        </div>
                    </div>

                    <!-- PAGINATION -->
                    <div
                        class="p-6 border-t border-gray-50 flex flex-col md:flex-row justify-between items-center gap-4">
                        <p class="text-xs font-bold text-gray-400" id="paginationInfo">Showing 0-0 of 0 orders</p>
                        <div class="flex items-center gap-2" id="paginationControls">
                            <!-- Buttons rendered by JS -->
                        </div>
                    </div>
                </div>

            </main>
    </div>

    <!-- SCRIPTS -->
    <script>
        // --- MOCK DATA ---
        // Generating some realistic mock data
        const generateOrders = () => {
            const statuses = ['Completed', 'Pending', 'Processing', 'Cancelled', 'Failed'];
            const payments = ['Online', 'COD', 'Wallet'];
            const names = ['Sarah Miller', 'John Davis', 'Emily Chen', 'Michael Brown', 'Lisa Wilson', 'David Lee', 'Anna Thompson', 'Robert Garcia', 'James Wilson', 'Maria Rodriguez', 'William Thomas', 'Jessica Martinez'];

            return Array.from({ length: 45 }, (_, i) => {
                const id = `#ORD-00${i + 1}`;
                const user = names[i % names.length];
                const itemsCount = Math.floor(Math.random() * 5) + 1;
                const amount = (Math.random() * 200 + 20).toFixed(2);
                const payment = payments[Math.floor(Math.random() * payments.length)];
                const status = statuses[Math.floor(Math.random() * statuses.length)];
                const date = new Date(Date.now() - Math.floor(Math.random() * 10000000000)).toISOString();

                return { id, user, itemsCount, amount, payment, status, date };
            });
        };

        let ordersData = generateOrders();

        // State for Pagination & Filtering
        let currentPage = 1;
        const itemsPerPage = 8;
        let filteredOrders = [...ordersData];

        // --- INIT ---
        document.addEventListener('DOMContentLoaded', () => {
            // Search Listener
            document.getElementById('searchInput').addEventListener('input', (e) => {
                applyFilters();
            });

            updateStats();
            applyFilters(); // Initial render
        });

        // --- CORE LOGIC ---

        function applyFilters() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;
            const paymentFilter = document.getElementById('paymentFilter').value;
            const sort = document.getElementById('sortFilter').value;

            // Filter
            filteredOrders = ordersData.filter(order => {
                const matchesSearch = order.id.toLowerCase().includes(query) || order.user.toLowerCase().includes(query);
                const matchesStatus = statusFilter ? order.status === statusFilter : true;
                const matchesPayment = paymentFilter ? order.payment === paymentFilter : true;

                return matchesSearch && matchesStatus && matchesPayment;
            });

            // Sort
            filteredOrders.sort((a, b) => {
                if (sort === 'newest') return new Date(b.date) - new Date(a.date);
                if (sort === 'amount_high') return b.amount - a.amount;
                if (sort === 'amount_low') return a.amount - b.amount;
                if (sort === 'status_asc') return a.status.localeCompare(b.status);
                // Default fallback roughly by ID desc if needed, but newest is default
                return 0;
            });

            currentPage = 1; // Reset to page 1
            renderTable();
            renderPagination();
        }

        function renderTable() {
            const tbody = document.getElementById('ordersTableBody');
            const emptyState = document.getElementById('emptyState');
            tbody.innerHTML = '';

            if (filteredOrders.length === 0) {
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
                document.getElementById('paginationControls').style.display = 'none'; // Hide pagination controls
                document.getElementById('paginationInfo').style.display = 'none';
                return;
            }

            emptyState.classList.add('hidden');
            emptyState.classList.remove('flex');
            document.getElementById('paginationControls').style.display = 'flex';
            document.getElementById('paginationInfo').style.display = 'block';

            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const pageData = filteredOrders.slice(start, end);

            pageData.forEach(order => {
                const statusColor = getStatusColor(order.status);
                const formattedDate = formatDate(order.date);
                const initials = order.user.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                const avatarColorClass = getAvatarColor(initials);

                const tr = document.createElement('tr');
                tr.className = "hover:bg-gray-50/50 transition group border-b border-gray-50 last:border-0";
                tr.innerHTML = `
                    <td class="px-8 py-5">
                       <span class="font-bold text-brand-500 text-xs">${order.id}</span>
                    </td>
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full ${avatarColorClass} flex items-center justify-center text-[10px] font-bold text-white shadow-sm">
                                ${initials}
                            </div>
                            <p class="font-bold text-sm text-accent-navy">${order.user}</p>
                        </div>
                    </td>
                    <td class="px-6 py-5">
                         <div class="flex items-center gap-2 text-gray-500">
                            <i class="fa-solid fa-box text-xs"></i>
                            <span class="text-xs font-bold">${order.itemsCount} items</span>
                        </div>
                    </td>
                    <td class="px-6 py-5">
                        <span class="font-extrabold text-accent-navy text-sm">₹${order.amount}</span>
                    </td>
                    <td class="px-6 py-5">
                        <span class="text-xs font-medium text-gray-500">${order.payment}</span>
                    </td>
                    <td class="px-6 py-5">
                        <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide ${statusColor}">
                            ${order.status}
                        </span>
                    </td>
                     <td class="px-6 py-5">
                        <span class="text-xs font-bold text-gray-500">${formattedDate}</span>
                    </td>
                    <td class="px-8 py-5 text-right">
                        <button class="text-brand-500 hover:text-brand-600 font-bold text-xs flex items-center justify-end gap-1 transition hover:gap-2">
                            <i class="fa-regular fa-eye"></i> View
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderPagination() {
            const totalPages = Math.ceil(filteredOrders.length / itemsPerPage);
            const paginationControls = document.getElementById('paginationControls');
            const info = document.getElementById('paginationInfo');

            // Info
            const start = filteredOrders.length === 0 ? 0 : (currentPage - 1) * itemsPerPage + 1;
            const end = Math.min(currentPage * itemsPerPage, filteredOrders.length);
            info.textContent = `Showing ${start}-${end} of ${filteredOrders.length} orders`;

            // Controls
            let btns = '';

            // Prev
            btns += `<button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled class="opacity-50 cursor-not-allowed"' : ''} 
                class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-brand-500 hover:bg-brand-50 hover:border-brand-100 transition shadow-sm bg-white">
                <i class="fa-solid fa-chevron-left text-[10px]"></i>
                <span class="ml-1 text-xs font-bold hidden md:inline">Previous</span>
            </button>`;

            // Pages (Simplified: just Show current / Total)
            btns += `<div class="flex items-center gap-1 mx-2">`;
            for (let i = 1; i <= totalPages; i++) {
                // Logic to show limited pages
                if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                    if (i === currentPage) {
                        btns += `<button class="w-8 h-8 rounded-full bg-brand-500 text-white flex items-center justify-center text-xs font-bold shadow-lg shadow-brand-500/30 scale-110">${i}</button>`;
                    } else {
                        btns += `<button onclick="changePage(${i})" class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-gray-500 text-xs font-bold hover:bg-gray-50 hover:text-brand-500 transition bg-white">${i}</button>`;
                    }
                } else if (i === currentPage - 2 || i === currentPage + 2) {
                    btns += `<span class="text-gray-300 text-xs text-center w-4">...</span>`;
                }
            }
            btns += `</div>`;

            // Next
            btns += `<button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages || totalPages === 0 ? 'disabled class="opacity-50 cursor-not-allowed"' : ''} 
                class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-brand-500 hover:bg-brand-50 hover:border-brand-100 transition shadow-sm bg-white">
                <span class="mr-1 text-xs font-bold hidden md:inline">Next</span>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </button>`;

            paginationControls.innerHTML = btns;
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredOrders.length / itemsPerPage);
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderTable();
            renderPagination();
        }

        function updateStats() {
            const completed = ordersData.filter(o => o.status === 'Completed').length;
            const pending = ordersData.filter(o => ['Pending', 'Processing'].includes(o.status)).length;
            const cancelled = ordersData.filter(o => o.status === 'Cancelled').length;

            // Animate Numbers
            animateValue("statTotal", 0, ordersData.length, 1000);
            animateValue("statCompleted", 0, completed, 1000);
            animateValue("statPending", 0, pending, 1000);
            animateValue("statCancelled", 0, cancelled, 1000);
        }

        // --- HELPERS ---
        function getStatusColor(status) {
            switch (status) {
                case 'Completed': return 'bg-teal-50 text-teal-600';
                case 'Processing': return 'bg-purple-50 text-purple-600';
                case 'Pending': return 'bg-orange-50 text-orange-600';
                case 'Cancelled': return 'bg-red-50 text-red-500';
                case 'Failed': return 'bg-gray-100 text-gray-500';
                default: return 'bg-gray-50 text-gray-500';
            }
        }

        function getAvatarColor(initials) {
            const colors = ['bg-pink-400', 'bg-violet-400', 'bg-blue-400', 'bg-emerald-400', 'bg-amber-400', 'bg-rose-400'];
            const index = initials.charCodeAt(0) % colors.length;
            return colors[index];
        }

        function formatDate(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function animateValue(id, start, end, duration) {
            if (start === end) return;
            const range = end - start;
            let current = start;
            const increment = end > start ? 1 : -1;
            const stepTime = Math.abs(Math.floor(duration / range));
            const obj = document.getElementById(id);
            if (!obj) return;

            const timer = setInterval(function () {
                current += increment;
                obj.innerHTML = current;
                if (current == end) {
                    clearInterval(timer);
                }
            }, stepTime);
        }
    </script>
</body>

</html>