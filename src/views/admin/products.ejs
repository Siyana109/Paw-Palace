<script>
  async function confirmDelete() {

    // PRODUCT DELETE
    if (deleteType === "product") {
      try {
        const res = await fetch(`/admin/products/delete/${deleteId}`, {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest"
          }
        });
        const data = await res.json();

        if (!data.success) {
          Swal.fire("Error", "Failed to delete product", "error");
          return;
        }

        // remove product row
        document
          .querySelector(`[data-product-row="${deleteId}"]`)
          ?.remove();

        // remove variant row
        document.getElementById(`variant-row-${deleteId}`)?.remove();

        closeDeleteModal();

        Swal.fire("Deleted!", "Product deleted successfully", "success");

      } catch (err) {
        Swal.fire("Error", "Something went wrong", "error");
      }
    }

    // VARIANT DELETE
    if (deleteType === "variant") {
      try {
        const res = await fetch(`/admin/products/variants/delete/${deleteId}`, {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest"
          }
        });


        const data = await res.json();

        if (!data.success) {
          Swal.fire("Error", "Failed to delete variant", "error");
          return;
        }

        document
          .querySelector(`[data-variant-id="${deleteId}"]`)
          ?.remove();

        const stockCell = document.querySelector(
          `[data-product-stock="${data.productId}"]`
        );

        if (stockCell) {
          stockCell.innerHTML =
            data.totalStock === 0
              ? `<span class="text-xs font-bold text-red-500 bg-red-50 px-3 py-1 rounded-full">Out of Stock</span>`
              : `<span class="text-sm font-bold text-gray-600">${data.totalStock}</span>`;
        }

        closeDeleteModal();

        Swal.fire("Deleted!", "Variant deleted successfully", "success");

      } catch (err) {
        Swal.fire("Error", "Something went wrong", "error");
      }
    }
  }
</script>




<script>
  function closeEditProductModal() {
    const modal = document.getElementById("editProductModal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  function openAddVariantModal(productId) {
    const modal = document.getElementById("addVariantModal");
    document.getElementById("variantProductId").value = productId;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeAddVariantModal() {
    const modal = document.getElementById("addVariantModal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");

    // Clear file inputs and previews
    document.getElementById("addVariantModal").querySelector("form").reset();
    document.getElementById("variantCoverPreview").innerHTML = '<i class="fa-regular fa-image text-2xl"></i>';
    document.getElementById("variantCoverPreview").classList.remove("hidden"); // Ensure it's visible for placeholder
    document.getElementById("variantSubPreview").innerHTML = '';
    document.getElementById("variantSubPreview").classList.add("hidden");
    selectedVariantSubImages = []; // Reset the file array
  }

  // --- CROPPER STATE & HELPERS ---
  let cropper = null;
  let currentCropCallback = null;
  let cropQueue = [];
  let currentInput = null;

  function startCropper(file, callback) {
    const reader = new FileReader();
    reader.onload = (e) => {
      const image = document.getElementById('imageToCrop');
      image.src = e.target.result;

      const modal = document.getElementById('cropperModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      if (cropper) cropper.destroy();

      cropper = new Cropper(image, {
        viewMode: 1,
        aspectRatio: 1, // Enforce Square
        autoCropArea: 1,
        background: false,
      });
      currentCropCallback = callback;
    };
    reader.readAsDataURL(file);
  }

  function closeCropperModal() {
    const modal = document.getElementById('cropperModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }
  }

  function cancelCrop() {
    closeCropperModal();
    cropQueue = []; // Abort queue

    // Restore input state if needed
    if (currentInput && currentInput.name === 'subImages') {
      updateSubInputFiles(currentInput);
    } else if (currentInput) {
      currentInput.value = '';
    }
  }

  function cropImage() {
    if (!cropper) return;

    cropper.getCroppedCanvas({
      maxWidth: 1024,
      maxHeight: 1024,
      fillColor: '#fff',
    }).toBlob((blob) => {
      if (currentCropCallback) {
        currentCropCallback(blob);
      }
      closeCropperModal();

      // Next
      if (cropQueue.length > 0) {
        setTimeout(processCropQueue, 200);
      }
    }, 'image/jpeg', 0.9);
  }

  function processCropQueue() {
    if (cropQueue.length === 0) return;

    const { file, input, previewId } = cropQueue.shift();
    currentInput = input;

    startCropper(file, (blob) => {
      const newFile = new File([blob], file.name, { type: 'image/jpeg', lastModified: Date.now() });

      selectedVariantSubImages.push(newFile);

      renderSubImagesPreview(previewId);
      updateSubInputFiles(input);
    });
  }

  function previewImage(input, previewId) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      currentInput = input;

      startCropper(file, (blob) => {
        const newFile = new File([blob], file.name, { type: 'image/jpeg', lastModified: Date.now() });

        // Update Input
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(newFile);
        input.files = dataTransfer.files;

        // Preview
        const preview = document.getElementById(previewId);
        preview.innerHTML = '';
        preview.classList.remove("text-gray-300"); // Remove placeholder text color

        const img = document.createElement('img');
        img.src = URL.createObjectURL(blob);
        img.className = 'w-full h-full object-cover';
        preview.appendChild(img);
        preview.classList.remove('hidden');
      });
    }
  }

  let selectedVariantSubImages = [];

  function previewImages(input, previewId) {
    const errorMsg = document.getElementById("imageLimitError");
    errorMsg.classList.add("hidden");

    if (input.files && input.files.length > 0) {
      if (selectedVariantSubImages.length + input.files.length > 5) {
        errorMsg.classList.remove("hidden");
        errorMsg.innerText = `You can only upload up to 5 images.`;
        updateSubInputFiles(input);
        return;
      }

      Array.from(input.files).forEach(file => {
        // Simple Duplicate Check (by name) just to avoid immediate double-add if user drags same file twice?
        // But cropping changes it, so we rely on user.
        cropQueue.push({ file, input, previewId });
      });

      if (!document.getElementById('cropperModal').classList.contains('flex')) {
        processCropQueue();
      }
    }
  }

  function updateSubInputFiles(input) {
    const dataTransfer = new DataTransfer();
    selectedVariantSubImages.forEach(file => dataTransfer.items.add(file));
    input.files = dataTransfer.files;
  }

  function renderSubImagesPreview(previewId) {
    const preview = document.getElementById(previewId);
    preview.innerHTML = '';

    if (selectedVariantSubImages.length > 0) {
      preview.classList.remove('hidden');
      selectedVariantSubImages.forEach((file, index) => {
        const div = document.createElement('div');
        div.className = 'w-16 h-16 rounded-lg overflow-hidden border border-dashed border-gray-300 relative group';

        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.className = 'w-full h-full object-cover';

        const removeBtn = document.createElement('button');
        removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
        removeBtn.className = 'absolute top-0 right-0 bg-red-500 text-white w-4 h-4 text-[10px] flex items-center justify-center rounded-full opacity-0 group-hover:opacity-100 transition cursor-pointer';
        removeBtn.onclick = (ev) => {
          ev.preventDefault();
          removeSubImage(index, document.querySelector('input[name="subImages"]'), previewId);
        };

        div.appendChild(img);
        div.appendChild(removeBtn);
        preview.appendChild(div);
      });
    } else {
      preview.classList.add('hidden');
    }
  }

  function removeSubImage(index, input, previewId) {
    selectedVariantSubImages.splice(index, 1);
    updateSubInputFiles(input);
    renderSubImagesPreview(previewId);
  }

  function validateVariantForm() {
    const priceInput = document.querySelector('#addVariantModal input[name="price"]');
    const stockInput = document.querySelector('#addVariantModal input[name="stock"]');

    if (priceInput.value < 0) {
      Swal.fire("Error", "Price cannot be negative", "error");
      return false;
    }
    if (stockInput.value < 0) {
      Swal.fire("Error", "Stock cannot be negative", "error");
      return false;
    }

    if (selectedVariantSubImages.length < 3) {
      Swal.fire("Error", `You must upload at least 3 images. Current: ${selectedVariantSubImages.length}`, "error");
      return false;
    }
    if (selectedVariantSubImages.length > 5) {
      Swal.fire("Error", `You can only upload up to 5 images. Current: ${selectedVariantSubImages.length}`, "error");
      return false;
    }
    return true;
  }


  function openDeleteModal(type, id) {
    deleteType = type;
    deleteId = id;

    const modal = document.getElementById("deleteConfirmationModal");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }


  function closeDeleteModal() {
    const modal = document.getElementById("deleteConfirmationModal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }
</script>

<script>
  // --- Edit Product Modal Logic ---
  function openEditProductModal(btn) {
    const id = btn.getAttribute('data-id');
    const name = btn.getAttribute('data-name');
    const brand = btn.getAttribute('data-brand');
    const category = btn.getAttribute('data-category');
    const description = btn.getAttribute('data-description');

    // Parse pet type (it's JSON string now)
    let petTypes = [];
    try {
      const raw = btn.getAttribute('data-pettype');
      if (raw) petTypes = JSON.parse(raw);
      if (!Array.isArray(petTypes)) petTypes = [petTypes]; // Fallback for old strings
    } catch (e) {
      console.error("Error parsing pet types", e);
      // Fallback to treating it as a single string if JSON parsing fails
      const raw = btn.getAttribute('data-pettype');
      if (raw) {
        petTypes = raw.split(',').map(item => item.trim());
      } else {
        petTypes = [];
      }
    }

    const status = btn.getAttribute('data-status');

    document.getElementById('editProductForm').action = `/admin/products/edit/${id}`;
    document.getElementById('editProductName').value = name;
    document.getElementById('editBrandId').value = brand;
    document.getElementById('editCategoryId').value = category;

    // Uncheck all Edit checkboxes first
    document.querySelectorAll('#editProductModal input[name="petType"]').forEach(cb => {
      cb.checked = false;
    });

    // Check matches
    petTypes.forEach(type => {
      // Map singular to plural if needed, or just iterate.
      // My Enum has strict values, so it should match.
      const el = document.getElementById(`editPetType${type}`);
      if (el) el.checked = true;

      // Fallback mapping if DB has "Dog" but checkbox is "Dogs"
      // Actually I added singular to Schema enum but checkboxes use Plural values.
      // I should handle map.
      if (type === 'Dog' && document.getElementById('editPetTypeDogs')) document.getElementById('editPetTypeDogs').checked = true;
      if (type === 'Cat' && document.getElementById('editPetTypeCats')) document.getElementById('editPetTypeCats').checked = true;
      if (type === 'Puppy' && document.getElementById('editPetTypePuppies')) document.getElementById('editPetTypePuppies').checked = true;
      if (type === 'Kitten' && document.getElementById('editPetTypeKittens')) document.getElementById('editPetTypeKittens').checked = true;
    });


    document.getElementById('editIsActive').value = status;
    document.getElementById('editDescription').value = description;

    const modal = document.getElementById("editProductModal");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  // --- Edit Variant Logic ---
  let editVariantKeptImages = [];
  let editVariantNewFiles = [];

  function renderEditVariantSubImages() {
    const container = document.getElementById("editVariantExistingSubImages");
    container.innerHTML = '';

    // 1. Render Kept Images
    editVariantKeptImages.forEach((imgUrl, index) => {
      const div = document.createElement("div");
      div.className = "w-16 h-16 rounded-lg overflow-hidden border border-gray-200 relative group";

      div.innerHTML = `
             <img src="${imgUrl}" class="w-full h-full object-cover">
             <button type="button" onclick="removeKeptSubImage(${index})" 
                class="absolute top-0 right-0 bg-red-500 text-white w-4 h-4 text-[10px] flex items-center justify-center rounded-full opacity-0 group-hover:opacity-100 transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
             </button>
           `;
      container.appendChild(div);
    });

    // 2. Render New Files
    editVariantNewFiles.forEach((file, index) => {
      const div = document.createElement("div");
      div.className = "w-16 h-16 rounded-lg overflow-hidden border border-dashed border-brand-300 relative group";

      div.innerHTML = `
             <img src="${URL.createObjectURL(file)}" class="w-full h-full object-cover">
             <div class="absolute bottom-0 left-0 right-0 bg-brand-500 text-white text-[8px] font-bold text-center">NEW</div>
             <button type="button" onclick="removeNewSubImage(${index})" 
                class="absolute top-0 right-0 bg-red-500 text-white w-4 h-4 text-[10px] flex items-center justify-center rounded-full opacity-0 group-hover:opacity-100 transition cursor-pointer">
                <i class="fa-solid fa-xmark"></i>
             </button>
           `;
      container.appendChild(div);
    });
  }

  function removeKeptSubImage(index) {
    editVariantKeptImages.splice(index, 1);
    renderEditVariantSubImages();
  }

  function removeNewSubImage(index) {
    editVariantNewFiles.splice(index, 1);
    renderEditVariantSubImages();
  }

  // Handle new file selection
  function handleEditVariantNewFiles(input) {
    if (input.files) {
      Array.from(input.files).forEach(file => {
        editVariantNewFiles.push(file);
      });
      renderEditVariantSubImages();
      input.value = '';
    }
  }

  function openEditVariantModal(variantId) {
    const variant = currentVariants.find(v => v._id === variantId);
    if (!variant) return;

    editVariantKeptImages = [];
    editVariantNewFiles = [];

    document.getElementById("editVariantSubInput").value = "";

    // Clear old simple preview if exists
    const oldPreview = document.getElementById("editVariantNewSubPreview");
    if (oldPreview) { oldPreview.innerHTML = ""; oldPreview.classList.add("hidden"); }

    document.getElementById("editVariantId").value = variant._id;
    document.getElementById("editVariantPrice").value = variant.price;
    document.getElementById("editVariantStock").value = variant.stock;
    document.getElementById("editVariantSize").value = variant.size || '';
    document.getElementById("editVariantColor").value = variant.color || '';

    // Cover Preview
    document.getElementById("editVariantCoverPreviewImg").src = variant.coverImage || '';

    // Sub Images Parsing
    if (Array.isArray(variant.subImages)) {
      editVariantKeptImages = [...variant.subImages];
    }

    renderEditVariantSubImages();

    const modal = document.getElementById("editVariantModal");
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeEditVariantModal() {
    const modal = document.getElementById("editVariantModal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

</script>






<!-- SCRIPTS -->
<script>
  let currentProductId = null;
  let currentVariants = [];

  // --- MODAL UTILS ---
  function openVariantsModal(productId) {
    currentProductId = productId;
    const modal = document.getElementById("viewVariantsModal");
    modal.classList.remove("hidden");
    modal.classList.add("flex");

    // Load initial list
    loadVariants(productId);
  }

  function closeVariantsModal() {
    const modal = document.getElementById("viewVariantsModal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    currentProductId = null;
    currentVariants = [];
  }

  // --- FETCH & RENDER LIST ---
  async function loadVariants(productId) {
    const loading = document.getElementById("variantsLoading");
    const content = document.getElementById("variantsModalContent");
    const backBtn = document.getElementById("backToVariantsBtn");
    const title = document.getElementById("variantsModalTitle");
    const subTitle = document.getElementById("variantsModalSubtitle");

    // Reset View State
    loading.classList.remove("hidden");
    loading.classList.add("flex");
    content.innerHTML = "";
    backBtn.classList.add("hidden");
    title.innerText = "Product Variants";
    subTitle.innerText = "Manage variants for this product";

    try {
      const res = await fetch(
        `/admin/products/${productId}/variants/json`,
        {
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest"
          }
        }
      );
      if (!res.ok) throw new Error(`HTTP Error: ${res.status}`);

      const text = await res.text();
      let data;
      try {
        data = JSON.parse(text);
      } catch (e) {
        console.error("Server return non-JSON:", text);
        throw new Error("Invalid server response");
      }

      if (data.success) {
        currentVariants = data.variants;
        renderVariantsList(data.variants);
      } else {
        console.error("API returned error:", data);
        content.innerHTML = `
            <div class="p-6 text-center">
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4 text-red-500 text-2xl">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3 class="text-lg font-bold text-red-500 mb-2">Error Loading Variants</h3>
                <p class="text-gray-500">${data.message || 'Unknown error occurred on server'}</p>
                <div class="mt-4 p-4 bg-gray-100 rounded-xl text-left text-xs font-mono text-gray-600 overflow-x-auto">
                    ${JSON.stringify(data, null, 2)}
                </div>
            </div>
        `;
      }

    } catch (err) {
      console.error("Load Variants Error:", err);
      content.innerHTML = `
            <div class="p-6 text-center">
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4 text-red-500 text-2xl">
