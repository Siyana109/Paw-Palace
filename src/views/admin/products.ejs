                                    <p class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Price</p>
                                </div>
                                <div class="text-right">
                                     <span class="px-3 py-1 bg-gray-100 rounded-lg text-xs font-bold ${v.stock < 5 ? 'text-red-500 bg-red-50' : 'text-gray-600'}">
                                        ${v.stock} Stock
