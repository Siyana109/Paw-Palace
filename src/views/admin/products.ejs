<script>
  async function submitAddVariantForm(event) {
    event.preventDefault();
    if (!validateVariantForm()) return;

    const form = event.target;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerText;

    submitBtn.disabled = true;
    submitBtn.innerText = "Saving...";

    const formData = new FormData(form);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: formData,
        credentials: "same-origin",
        headers: {
          "X-Requested-With": "XMLHttpRequest"
        }
      });
      const data = await res.json();

      if (data.success) {
        closeAddVariantModal();
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: 'Variant Added',
          showConfirmButton: false,
          timer: 3000
        });

        // Refresh list
        if (currentProductId) {
          loadVariants(currentProductId);
        }
      } else {
        Swal.fire("Error", data.message || "Failed to add variant", "error");
      }
    } catch (err) {
      console.error(err);
      Swal.fire("Error", "Something went wrong", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = originalText;
    }
  }

  // --- AJAX for Edit Variant --
  async function submitEditVariantForm(event) {
    event.preventDefault();

    const form = event.target;
    const submitBtn = form.querySelector('button[type="submit"]');
    const variantId = document.getElementById("editVariantId").value;
    const originalText = submitBtn.innerText;

    if (!variantId) return;

    submitBtn.disabled = true;
    submitBtn.innerText = "Updating...";

    const data = {
      price: document.getElementById("editVariantPrice").value,
      stock: document.getElementById("editVariantStock").value,
      size: document.getElementById("editVariantSize").value,
      color: document.getElementById("editVariantColor").value
    };

    const formData = new FormData();
    formData.append("price", data.price);
    formData.append("stock", data.stock);
    formData.append("size", data.size);
    formData.append("color", data.color);

    const coverInput = document.getElementById("editVariantCoverInput");
    if (coverInput.files.length > 0) {
      formData.append("coverImage", coverInput.files[0]);
    }

    const subInput = document.getElementById("editVariantSubInput");
    if (subInput.files.length > 0) {
      for (let i = 0; i < subInput.files.length; i++) {
        formData.append("subImages", subInput.files[i]);
      }
    }

    try {
      const res = await fetch(`/admin/products/variants/edit/${variantId}`, {
        method: 'POST',
        credentials: "same-origin",
        headers: {
          "X-Requested-With": "XMLHttpRequest"
          // "Content-Type": "multipart/form-data" // Fetch auto-sets this with FormData
        },
        body: formData
      });
      const result = await res.json();

      if (result.success) {
        closeEditVariantModal();
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: 'Variant Updated',
          showConfirmButton: false,
          timer: 3000
        });

        // Refresh list if modal is open
        if (currentProductId) {
          loadVariants(currentProductId);
        }
      } else {
        Swal.fire("Error", result.message || "Failed to update variant", "error");
      }

    } catch (err) {
      console.error(err);
      Swal.fire("Error", "Something went wrong", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = originalText;
    }
  }
</script>
</body>

</html>