                <div class="flex flex-col items-center justify-center py-20 bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center text-gray-400 text-2xl mb-4">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <p class="text-gray-500 font-bold">No variants found</p>
                    <p class="text-xs text-gray-400 mt-1">Add a variant to get started</p>
                </div>
            `;
    } else {
      html += `<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">`;

      variants.forEach(v => {
        html += `
                    <div onclick="showVariantDetails('${v._id}')" 
                        class="bg-white border-2 border-gray-50 hover:border-brand-500 hover:shadow-xl hover:shadow-brand-500/10 rounded-[2rem] p-4 cursor-pointer transition-all group relative overflow-hidden">
                        
                        <!-- Image -->
                        <div class="aspect-square rounded-2xl bg-gray-100 overflow-hidden mb-4 relative">
                            <img src="${v.coverImage}" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition"></div>
