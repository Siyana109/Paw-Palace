                        <!-- Info -->
                        <div class="px-2">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <p class="text-lg font-bold text-accent-navy">₹${v.price}</p>
                                    <p class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Price</p>
                                </div>
                                <div class="text-right">
                                     <span class="px-3 py-1 bg-gray-100 rounded-lg text-xs font-bold ${v.stock < 5 ? 'text-red-500 bg-red-50' : 'text-gray-600'}">
                                        ${v.stock} Stock
                                     </span>
                                </div>
                            </div>

                            <div class="flex gap-2 mt-4 pt-4 border-t border-gray-50">
                                <span class="px-3 py-1.5 bg-gray-50 rounded-lg text-xs font-bold text-gray-500">
                                    Size: <span class="text-accent-navy">${v.size || 'N/A'}</span>
                                </span>
                                <span class="px-3 py-1.5 bg-gray-50 rounded-lg text-xs font-bold text-gray-500">
                                    Color: <span class="text-accent-navy">${v.color || 'N/A'}</span>
                                </span>
                            </div>
                        </div>
                    </div>
                `;
      });

      html += `</div>`;
    }

    content.innerHTML = html;
  }

  // --- VARIANT DETAILS VIEW ---
  function showVariantDetails(variantId) {
    const variant = currentVariants.find(v => v._id === variantId);
    if (!variant) return;

    const content = document.getElementById("variantsModalContent");
    const backBtn = document.getElementById("backToVariantsBtn");
    const title = document.getElementById("variantsModalTitle");
    const subTitle = document.getElementById("variantsModalSubtitle");

    backBtn.classList.remove("hidden"); // Show Back Button
    title.innerText = "Variant Details";
    subTitle.innerText = `${variant.size} - ${variant.color}`;

    // Render Details HTML
    content.innerHTML = `
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 animate-fade-in">
                
                <!-- LEFT: IMAGES -->
                <div class="space-y-4">
                    <div class="aspect-square rounded-[2rem] bg-gray-100 overflow-hidden shadow-sm border border-gray-100">
                         <img src="${variant.coverImage}" class="w-full h-full object-cover">
                    </div>
                    
                    <div class="grid grid-cols-4 gap-2">
                        ${variant.subImages.map(img => `
                            <div class="aspect-square rounded-xl bg-gray-50 overflow-hidden border border-gray-100">
                                <img src="${img}" class="w-full h-full object-cover">
                            </div>
                        `).join('')}
                    </div>
                </div>

                <!-- RIGHT: INFO & ACTIONS -->
                <div class="space-y-8">
                    
                    <div class="bg-gray-50 rounded-[2rem] p-8">
                        <div class="grid grid-cols-2 gap-6 mb-6">
                            <div>
                                <p class="text-xs font-bold text-gray-400 uppercase mb-1">Price</p>
                                <p class="text-3xl font-bold text-accent-navy">₹${variant.price}</p>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-gray-400 uppercase mb-1">Stock Status</p>
                                <p class="text-xl font-bold ${variant.stock > 0 ? 'text-green-500' : 'text-red-500'}">
                                    ${variant.stock} Units
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                             <div class="bg-white p-4 rounded-2xl border border-gray-100">
                                <p class="text-xs font-bold text-gray-400 uppercase mb-1">Size</p>
                                <p class="font-bold text-accent-navy">${variant.size}</p>
                             </div>
                             <div class="bg-white p-4 rounded-2xl border border-gray-100">
                                <p class="text-xs font-bold text-gray-400 uppercase mb-1">Color</p>
                                <p class="font-bold text-accent-navy">${variant.color}</p>
                             </div>
                        </div>
                    </div>

                    <!-- ACTIONS -->
                    <div class="flex flex-col gap-3">
                        <button onclick="openEditVariantModal('${variant._id}')" 
                            class="w-full py-4 bg-brand-500 text-white rounded-2xl font-bold shadow-lg shadow-brand-500/20 hover:scale-[1.02] transition">
                            <i class="fa-solid fa-pen mr-2"></i> Edit Variant Details
                        </button>

                        <button onclick="openDeleteModal('variant', '${variant._id}')" 
                            class="w-full py-4 bg-red-50 text-red-500 rounded-2xl font-bold hover:bg-red-100 transition">
                            <i class="fa-solid fa-trash mr-2"></i> Delete Variant
                        </button>
                    </div>

                </div>

            </div>
        `;
  }

  function showVariantsList() {
    const backBtn = document.getElementById("backToVariantsBtn");
    const title = document.getElementById("variantsModalTitle");
    const subTitle = document.getElementById("variantsModalSubtitle");

    backBtn.classList.add("hidden");
    title.innerText = "Product Variants";
    subTitle.innerText = "Manage variants for this product";

    // Re-render list from cache
    renderVariantsList(currentVariants);
  }

</script>

<script>
  async function submitAddProduct(event) {
    event.preventDefault();
    const form = event.target;

    if (!validateProductForm(form)) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;

    const formData = new FormData(form);

    try {
      const res = await fetch("/admin/products/add", {
        method: "POST",
        body: formData,
        headers: { "X-Requested-With": "XMLHttpRequest" }
      });

      const data = await res.json();

      if (!data.success) {
        Swal.fire("Error", data.message || "Failed to add product", "error");
        return;
      }

      closeAddProductModal();
      form.reset();

      Swal.fire({
        toast: true,
        position: "top-end",
        icon: "success",
        title: "Product added successfully",
        showConfirmButton: false,
        timer: 3000
      });

      fetchProducts(1); // refresh table

    } catch (err) {
      Swal.fire("Error", "Something went wrong", "error");
    } finally {
      submitBtn.disabled = false;
    }
  }

  async function submitEditProduct(event) {
    event.preventDefault();
    const form = event.target;

    if (!validateProductForm(form)) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;

    const formData = new FormData(form);

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: { "X-Requested-With": "XMLHttpRequest" }
      });

      const data = await res.json();

      if (!data.success) {
        Swal.fire("Error", data.message || "Failed to update product", "error");
        return;
      }

      closeEditProductModal();

      Swal.fire({
        toast: true,
        position: "top-end",
        icon: "success",
        title: "Product updated successfully",
        showConfirmButton: false,
        timer: 3000
      });

      fetchProducts(currentPage); // refresh

    } catch (err) {
      Swal.fire("Error", "Something went wrong", "error");
    } finally {
      submitBtn.disabled = false;
    }
  }

  async function submitAddVariantForm(event) {
    event.preventDefault();
    if (!validateVariantForm()) return;

    const form = event.target;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerText;

    submitBtn.disabled = true;
    submitBtn.innerText = "Saving...";

    const formData = new FormData(form);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: formData,
        credentials: "same-origin",
        headers: {
          "X-Requested-With": "XMLHttpRequest"
        }
      });
      const data = await res.json();

      if (data.success) {
        closeAddVariantModal();
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: 'Variant Added',
          showConfirmButton: false,
          timer: 3000
        });

        // Refresh list
        if (currentProductId) {
          loadVariants(currentProductId);
        }
      } else {
        Swal.fire("Error", data.message || "Failed to add variant", "error");
      }
    } catch (err) {
      console.error(err);
      Swal.fire("Error", "Something went wrong", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = originalText;
    }
  }

  // --- AJAX for Edit Variant --
  async function submitEditVariantForm(event) {
    event.preventDefault();

    const form = event.target;
    const submitBtn = form.querySelector('button[type="submit"]');
    const variantId = document.getElementById("editVariantId").value;
    const originalText = submitBtn.innerText;

    if (!variantId) return;

    // Validation
    const priceVal = document.getElementById("editVariantPrice").value;
    const stockVal = document.getElementById("editVariantStock").value;

    if (priceVal < 0 || stockVal < 0) {
      Swal.fire("Error", "Price and Stock cannot be negative", "error");
      return;
    }

    const totalImages = editVariantKeptImages.length + editVariantNewFiles.length;
    if (totalImages < 3) {
      Swal.fire("Error", `You need at least 3 sub-images. Current: ${totalImages}`, "error");
      return;
    }
    if (totalImages > 5) {
      Swal.fire("Error", `You can have at most 5 sub-images. Current: ${totalImages}`, "error");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerText = "Updating...";

    const formData = new FormData();
    formData.append("price", document.getElementById("editVariantPrice").value);
    formData.append("stock", document.getElementById("editVariantStock").value);
    formData.append("size", document.getElementById("editVariantSize").value);
    formData.append("color", document.getElementById("editVariantColor").value);

    // Kept Images
    formData.append("keptSubImages", JSON.stringify(editVariantKeptImages));

    // Cover Image
    const coverInput = document.getElementById("editVariantCoverInput");
    if (coverInput.files.length > 0) {
      formData.append("coverImage", coverInput.files[0]);
    }

    // New Sub Images
    editVariantNewFiles.forEach(file => {
      formData.append("subImages", file);
    });

    try {
      const res = await fetch(`/admin/products/variants/edit/${variantId}`, {
        method: 'POST',
        credentials: "same-origin",
        headers: {
          "X-Requested-With": "XMLHttpRequest"
        },
        body: formData
      });
      const result = await res.json();

      if (result.success) {
        closeEditVariantModal();
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: 'Variant Updated',
          showConfirmButton: false,
          timer: 3000
        });

        // Refresh list if modal is open
        if (currentProductId) {
          loadVariants(currentProductId);
        }
      } else {
        Swal.fire("Error", result.message || "Failed to update variant", "error");
      }

    } catch (err) {
      console.error(err);
      Swal.fire("Error", "Something went wrong", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = originalText;
    }
  }


  function validateProductForm(form) {
    const productName = form.productName.value.trim();
    const description = form.description.value.trim();
    const petTypes = form.querySelectorAll('input[name="petType"]:checked');

    if (productName.length < 3) {
      Swal.fire("Validation Error", "Product name must be at least 3 characters", "error");
      return false;
    }

    if (productName.length > 100) {
      Swal.fire("Validation Error", "Product name cannot exceed 100 characters", "error");
      return false;
    }

    if (petTypes.length === 0) {
      Swal.fire("Validation Error", "Select at least one pet type", "error");
      return false;
    }

    if (description.length < 10 || description.length > 250) {
      Swal.fire(
        "Validation Error",
        "Description must be between 10 and 250 characters",
        "error"
      );
      return false;
    }

    return true;
  }


</script>

<script>
  let searchTimer = null;
  let currentPage = 1;
  let currentSort = "newest";

  document.getElementById("searchInput").addEventListener("input", (e) => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      fetchProducts(1);
    }, 400); // debounce
  });

  function fetchProducts(page = 1) {
    currentPage = page;
    const search = document.getElementById("searchInput").value;
    const category = document.getElementById("categoryFilter").value;
    const status = document.getElementById("statusFilter").value;
    const sort = document.getElementById("sortFilter").value;
    currentSort = sort; // Update global

    fetch(`/admin/products?page=${page}&search=${search}&sort=${sort}&category=${category}&status=${status}`, {
      headers: { "X-Requested-With": "XMLHttpRequest" }
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) return;
        renderTable(data.products);
        renderPagination(data.pagination);
      });
  }
</script>

<script>
  function renderTable(products) {
    const tbody = document.getElementById("productTableBody");
    tbody.innerHTML = "";

    if (products.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-gray-400">No products found</td></tr>`;
      return;
    }

    products.forEach(p => {
      const petTypes = Array.isArray(p.petType) ? p.petType.join(', ') : (p.petType || '-');
      const petTypeJson = JSON.stringify(p.petType || []);
      const safePetType = petTypeJson.replace(/'/g, "&apos;");

      tbody.innerHTML += `
      <tr data-product-row="${p._id}" class="hover:bg-gray-50/50 transition">

        <td class="px-8 py-5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl overflow-hidden bg-gray-100">
              <img src="${p.coverImage || '/images/placeholder.png'}" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="font-bold text-sm text-accent-navy">${p.productName}</p>
              <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">${p._id}</p>
            </div>
          </div>
        </td>

        <td class="px-6 py-5 text-sm font-semibold text-gray-600">${p.brandId?.brandName || '-'}</td>
        <td class="px-6 py-5 text-sm font-semibold text-gray-600">${p.categoryId?.categoryName || '-'}</td>
        <td class="px-6 py-5 text-sm font-semibold text-gray-600">${petTypes}</td>

        <td class="px-6 py-5" data-product-stock="${p._id}">
          ${p.totalStock === 0
          ? `<span class="text-xs font-bold text-red-500 bg-red-50 px-3 py-1 rounded-full">Out of Stock</span>`
          : `<span class="text-sm font-bold text-gray-600">${p.totalStock}</span>`
        }
        </td>

        <td class="px-6 py-5">
          <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide
            ${p.isActive ? 'bg-green-50 text-green-600' : 'bg-orange-50 text-orange-600'}">
            ${p.isActive ? 'Active' : 'Inactive'}
          </span>
        </td>

        <td class="px-8 py-5">
          <div class="flex items-center gap-4 text-gray-400">
             <button onclick="openEditProductModal(this)" 
                data-id="${p._id}"
                data-name="${p.productName}" 
                data-brand="${p.brandId?._id || ''}"
                data-category="${p.categoryId?._id || ''}" 
                data-description="${p.description}"
                data-pettype='${safePetType}' 
                data-status="${p.isActive}"
                class="hover:text-brand-500 hover:scale-110 transition"
                title="Edit Product">
                <i class="fa-solid fa-pen-to-square text-sm"></i>
              </button>
            <button onclick="openVariantsModal('${p._id}')" class="hover:text-teal-500 hover:scale-110 transition" title="View Variants">
               <i class="fa-solid fa-layer-group text-sm"></i>
            </button>
            <button onclick="openDeleteModal('product', '${p._id}')" class="hover:text-red-500 hover:scale-110 transition" title="Delete Product">
              <i class="fa-solid fa-trash text-sm"></i>
            </button>
          </div>
        </td>

      </tr>
    `;
    });
  }

  function renderPagination(pagination) {
    const container = document.getElementById("paginationContainer");
    const { page, totalPages, totalProducts } = pagination;

    if (totalProducts === 0) {
      container.innerHTML = '';
      return;
    }

    let links = '';

    // Prev
    if (page > 1) {
      links += `<button onclick="fetchProducts(${page - 1})" class="px-4 py-2 rounded-xl border border-gray-100 hover:bg-gray-50 transition"><i class="fa-solid fa-chevron-left"></i> Previous</button>`;
    }

    // Pages
    for (let i = 1; i <= totalPages; i++) {
      // Show current, first, last, and neighbours
      if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) {
        if (i === page) {
          links += `<button class="w-10 h-10 rounded-xl bg-brand-500 text-white">${i}</button>`;
        } else {
          links += `<button onclick="fetchProducts(${i})" class="w-10 h-10 rounded-xl hover:bg-gray-50">${i}</button>`;
        }
      } else if (i === page - 2 || i === page + 2) {
        links += `<span class="px-2">...</span>`;
      }
    }

    // Next
    if (page < totalPages) {
      links += `<button onclick="fetchProducts(${page + 1})" class="px-4 py-2 rounded-xl border border-gray-100 hover:bg-gray-50 transition">Next <i class="fa-solid fa-chevron-right ml-1"></i></button>`;
    }

    container.innerHTML = `
        <p>Showing ${(page - 1) * 8 + 1}-${Math.min(page * 8, totalProducts)} of ${totalProducts} products</p>
        <div class="flex items-center gap-2">
            ${links}
        </div>
    `;
  }

  // Initialize Pagination with server-side data
  // Initialize Pagination with server-side data
  document.addEventListener("DOMContentLoaded", () => {
    try {
      const initialPagination = {
        page: Number('<%= (typeof page !== "undefined") ? page : 1 %>'),
        totalPages: Number('<%= (typeof totalPages !== "undefined") ? totalPages : 1 %>'),
        totalProducts: Number('<%= (typeof totalProducts !== "undefined") ? totalProducts : 0 %>')
      };

      if (typeof renderPagination === 'function' && !isNaN(initialPagination.page)) {
        renderPagination(initialPagination);
      }
    } catch (err) {
      console.error("Pagination init error:", err);
    }
  });
</script>


