<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Report | PawPalace Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#fff1f2', 100: '#ffe4e6', 500: '#f43f5e', 600: '#e11d48' },
                        accent: { navy: '#0f172a', teal: '#2dd4bf' }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-gray-50 font-sans text-accent-navy overflow-hidden">

    <div class="flex h-screen">
        <%- include('../partials/adminSidebar') %>

            <main class="flex-1 p-8 h-full overflow-y-auto custom-scrollbar relative">
                <!-- HEADER -->
                <header class="flex justify-between items-center mb-8">
                    <div>
                        <h1 class="text-3xl font-bold text-accent-navy">Sales Report</h1>
                        <p class="text-gray-400 font-medium text-sm mt-1">Comprehensive sales analytics and insights</p>
                    </div>
                    <!-- Export Buttons -->
                    <div class="flex gap-3">
                        <button onclick="downloadReport('pdf')"
                            class="px-4 py-2 bg-red-100 text-red-600 rounded-xl font-bold text-xs hover:bg-red-200 transition flex items-center gap-2">
                            <i class="fa-solid fa-file-pdf"></i> Export PDF
                        </button>
                        <button onclick="downloadReport('excel')"
                            class="px-4 py-2 bg-green-100 text-green-600 rounded-xl font-bold text-xs hover:bg-green-200 transition flex items-center gap-2">
                            <i class="fa-solid fa-file-excel"></i> Export Excel
                        </button>
                    </div>
                </header>

                <!-- FILTERS -->
                <div
                    class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mb-8 flex flex-wrap gap-4 items-center">
                    <form id="filterForm" action="/admin/sales-report" method="GET"
                        class="flex gap-4 items-center w-full">

                        <!-- Predefined Range -->
                        <select name="filter" onchange="toggleCustomDate(this.value)"
                            class="bg-gray-50 border border-gray-200 text-gray-600 text-sm rounded-xl px-4 py-2 focus:border-brand-500 outline-none font-bold">
                            <option value="daily" <%=filter==='daily' ? 'selected' : '' %>>Today</option>
                            <option value="weekly" <%=filter==='weekly' ? 'selected' : '' %>>This Week</option>
                            <option value="yearly" <%=filter==='yearly' ? 'selected' : '' %>>This Year</option>
                            <option value="custom" <%=filter==='custom' ? 'selected' : '' %>>Custom Range</option>
                        </select>

                        <!-- Custom Date Inputs -->
                        <div id="customDateContainer" class="flex gap-2 <%= filter === 'custom' ? '' : 'hidden' %>">
                            <input type="date" name="startDate" id="startDate" value="<%= startDate %>"
                                class="bg-gray-50 border border-gray-200 text-gray-600 text-sm rounded-xl px-3 py-2 outline-none">
                            <span class="text-gray-400 self-center">to</span>
                            <input type="date" name="endDate" id="endDate" value="<%= endDate %>"
                                class="bg-gray-50 border border-gray-200 text-gray-600 text-sm rounded-xl px-3 py-2 outline-none">
                        </div>

                        <button type="submit"
                            class="ml-auto px-6 py-2 bg-brand-500 text-white rounded-xl font-bold text-sm hover:bg-brand-600 shadow-lg shadow-brand-500/20 transition">
                            Apply Filter
                        </button>
                    </form>
                </div>

                <!-- STATS CARDS -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                    <!-- Total Sales Amount -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Total Revenue
                            </p>
                            <h3 class="text-3xl font-extrabold text-brand-500">₹<%= stats.totalRevenue.toLocaleString()
                                    %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-brand-50 text-brand-500 rounded-2xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                        </div>
                    </div>

                    <!-- Total Orders -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Total Orders
                            </p>
                            <h3 class="text-3xl font-extrabold text-accent-teal">#<%= stats.totalOrders %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-teal-50 text-teal-600 rounded-2xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                    </div>

                    <!-- Total Discount -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Discounts
                                Given</p>
                            <h3 class="text-3xl font-extrabold text-orange-400">₹<%=
                                    stats.totalDiscount.toLocaleString() %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-orange-50 text-orange-400 rounded-2xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-tags"></i>
                        </div>
                    </div>

                    <!-- Products Sold -->
                    <div
                        class="bg-white p-6 rounded-[2rem] shadow-sm border border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Products Sold
                            </p>
                            <h3 class="text-3xl font-extrabold text-indigo-500">
                                <%= stats.productsSold %>
                            </h3>
                        </div>
                        <div
                            class="w-12 h-12 bg-indigo-50 text-indigo-500 rounded-2xl flex items-center justify-center text-xl">
                            <i class="fa-solid fa-box-open"></i>
                        </div>
                    </div>
                </div>

                <!-- CHARTS ROW -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <!-- Sales Over Time (Line Chart) -->
                    <div class="md:col-span-2 bg-white p-6 rounded-[2.5rem] shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-accent-navy mb-4">Sales Over Time</h3>
                        <canvas id="salesChart" height="150"></canvas>
                    </div>

                    <!-- Payment Methods (Doughnut) -->
                    <div class="bg-white p-6 rounded-[2.5rem] shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-accent-navy mb-4">Payment Methods</h3>
                        <div class="h-[200px] flex justify-center">
                            <canvas id="paymentChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- DETAILED TABLE -->
                <div class="bg-white rounded-[2.5rem] shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-50">
                        <h3 class="text-lg font-bold text-accent-navy">Detailed Sales Report</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-gray-50/50">
                                <tr
                                    class="text-gray-400 text-[10px] font-bold uppercase tracking-widest border-b border-gray-100 text-left">
                                    <th class="px-6 py-4">Order ID</th>
                                    <th class="px-6 py-4">Date</th>
                                    <th class="px-6 py-4">Customer</th>
                                    <th class="px-6 py-4">Amount</th>
                                    <th class="px-6 py-4">Method</th>
                                    <th class="px-6 py-4">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% if (orders.length> 0) { %>
                                    <% orders.forEach(order=> { %>
                                        <tr class="hover:bg-gray-50/50 transition">
                                            <td class="px-6 py-4 font-bold text-brand-500 text-xs">#<%= order.orderId %>
                                            </td>
                                            <td class="px-6 py-4 text-xs font-bold text-gray-500">
                                                <%= new Date(order.createdAt).toLocaleDateString() %>
                                            </td>
                                            <td class="px-6 py-4 text-sm font-bold text-accent-navy">
                                                <%= order.userId?.fullName || 'Guest' %>
                                            </td>
                                            <td class="px-6 py-4 text-sm font-extrabold text-accent-navy">₹<%=
                                                    order.totalAmount %>
                                            </td>
                                            <td class="px-6 py-4 text-xs uppercase font-bold text-gray-400">
                                                <%= order.payment.method %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span
                                                    class="px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide bg-teal-50 text-teal-600">
                                                    <%= order.orderStatus %>
                                                </span>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-10 text-gray-400 font-bold">No
                                                        sales data found for this period</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="p-4 border-t border-gray-50 flex justify-between items-center">
                        <p class="text-xs text-gray-400 font-bold">Page <%= currentPage %> of <%= totalPages %>
                        </p>
                        <div class="flex gap-2">
                            <% if (currentPage> 1) { %>
                                <a href="?page=<%= currentPage - 1 %>&filter=<%= filter %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
                                    class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition">
                                    <i class="fa-solid fa-chevron-left text-[10px]"></i>
                                </a>
                                <% } %>
                                    <% if (currentPage < totalPages) { %>
                                        <a href="?page=<%= currentPage + 1 %>&filter=<%= filter %>&startDate=<%= startDate %>&endDate=<%= endDate %>"
                                            class="w-8 h-8 rounded-full border border-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition">
                                            <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                        </a>
                                        <% } %>
                        </div>
                    </div>
                </div>

            </main>
    </div>

    <!-- Chart Scripts -->
    <script>
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');

        // Initial setup for max dates
        const todayStr = new Date().toISOString().split('T')[0];
        startDateInput.max = todayStr;
        endDateInput.max = todayStr;

        // When start date changes, restrict the end date's minimum value
        startDateInput.addEventListener('change', function () {
            if (this.value) {
                endDateInput.min = this.value;
            } else {
                endDateInput.min = '';
            }
        });

        // Optional: If start date is already filled (e.g., from server load), set end date's min
        if (startDateInput.value) {
            endDateInput.min = startDateInput.value;
        }

        const toggleCustomDate = (val) => {
            const container = document.getElementById('customDateContainer');
            if (val === 'custom') container.classList.remove('hidden');
            else container.classList.add('hidden');
        };

        const downloadReport = (format) => {
            const params = new URLSearchParams(window.location.search);
            params.set('format', format);

            // Add basic check for custom before downloading
            if (params.get('filter') === 'custom') {
                const s = params.get('startDate');
                const e = params.get('endDate');
                if (!s || !e) return Swal.fire({ icon: 'error', title: 'Invalid Filter', text: 'You must apply a valid date range first.', confirmButtonColor: '#f43f5e' });
            }

            window.location.href = `/admin/sales-report/download?${params.toString()}`;
        };

        // Form Validation for applying custom filter
        document.getElementById('filterForm').addEventListener('submit', function (e) {
            const filter = this.filter.value;
            if (filter === 'custom') {
                const start = this.startDate.value;
                const end = this.endDate.value;

                if (!start || !end) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Missing Dates',
                        text: 'Please select both a start date and an end date.',
                        confirmButtonColor: '#f43f5e'
                    });
                    return;
                }

                if (new Date(start) > new Date(end)) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Date Range',
                        text: 'The end date cannot be earlier than the start date.',
                        confirmButtonColor: '#f43f5e'
                    });
                    return;
                }

                const today = new Date();
                today.setHours(23, 59, 59, 999);
                if (new Date(end) > today) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Date',
                        text: 'The end date cannot be in the future.',
                        confirmButtonColor: '#f43f5e'
                    });
                    return;
                }
            }
        });

        // Parse Chart Data
        const salesData = JSON.parse('<%- salesChart %>');
        const paymentData = JSON.parse('<%- paymentChart %>');

        // Sales Line Chart
        new Chart(document.getElementById('salesChart'), {
            type: 'line',
            data: {
                labels: salesData.map(d => d._id),
                datasets: [{
                    label: 'Sales (₹)',
                    data: salesData.map(d => d.dailySales),
                    borderColor: '#f43f5e',
                    backgroundColor: 'rgba(244, 63, 94, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { display: false } },
                    x: { grid: { display: false } }
                }
            }
        });

        // Payment Doughnut Chart
        new Chart(document.getElementById('paymentChart'), {
            type: 'doughnut',
            data: {
                labels: paymentData.map(d => d._id),
                datasets: [{
                    data: paymentData.map(d => d.count),
                    backgroundColor: ['#f43f5e', '#2dd4bf', '#fbbf24'],
                    borderWidth: 0
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } },
                cutout: '70%'
            }
        });
    </script>
</body>

</html>