            <%- include('./partials/header') %>


                <!-- HERO SECTION -->
                <section id="home"
                    class="relative bg-gradient-to-br from-brand-50 via-white to-amber-50 overflow-hidden pt-36 pb-24 lg:pt-40 lg:pb-36 px-6">
                    <!-- Decorative Blobs -->
                    <div
                        class="absolute top-0 -left-10 w-96 h-96 bg-brand-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob">
                    </div>
                    <div class="absolute top-0 -right-10 w-96 h-96 bg-amber-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"
                        style="animation-delay: 2s;"></div>
                    <div class="absolute -bottom-10 left-32 w-96 h-96 bg-pink-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"
                        style="animation-delay: 4s;"></div>

                    <div class="absolute inset-0 hero-pattern pointer-events-none"></div>

                    <div class="max-w-7xl mx-auto relative z-10">
                        <div class="flex flex-col lg:flex-row items-center gap-12">
                            <!-- Left Column: Text Content -->
                            <div
                                class="lg:w-1/2 text-center lg:text-left flex flex-col items-center lg:items-start pt-16 pb-4">
                                <!-- Premium Badge -->
                                <div
                                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white shadow-sm shadow-brand-500/10 mb-8 border border-brand-50 transform hover:scale-105 transition-transform duration-300">
                                    <span class="relative flex h-3 w-3">
                                        <span
                                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-3 w-3 bg-brand-500"></span>
                                    </span>
                                    <span class="text-xs font-bold uppercase tracking-widest text-brand-500">Premium Pet
                                        Boutique</span>
                                </div>

                                <!-- Main Headline -->
                                <h1
                                    class="text-5xl lg:text-7xl font-extrabold text-accent-navy mb-6 tracking-tight leading-[1.1]">
                                    Spoil Your Furry <br />
                                    <span
                                        class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 to-amber-500 drop-shadow-sm">Best
                                        Friend.</span>
                                </h1>

                                <p
                                    class="text-xl text-gray-500 mb-10 max-w-lg mx-auto lg:mx-0 font-medium leading-relaxed">
                                    Discover the happiest toys, tastiest treats, and coziest beds. Curated with absolute
                                    love
                                    for pets who deserve the very best in life.
                                </p>

                                <!-- CTA & Social Proof -->
                                <div
                                    class="flex flex-col sm:flex-row gap-6 items-center w-full justify-center lg:justify-start">
                                    <a href="/home"
                                        class="group relative px-8 py-4 bg-accent-navy text-white rounded-2xl font-bold text-lg hover:bg-brand-500 hover:shadow-2xl hover:shadow-brand-500/40 transition-all duration-300 transform hover:-translate-y-1 w-full sm:w-auto overflow-hidden">
                                        <span class="relative z-10 flex items-center justify-center gap-2">
                                            Start Shopping
                                            <i
                                                class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                                        </span>
                                        <div
                                            class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity">
                                        </div>
                                    </a>

                                    <div
                                        class="flex items-center justify-center gap-4 px-6 py-4 bg-white/70 backdrop-blur-md rounded-2xl shadow-sm border border-white/50 hover:shadow-md transition-shadow">
                                        <div class="flex -space-x-3">
                                            <img class="w-10 h-10 rounded-full border-2 border-white object-cover"
                                                src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=100&q=80"
                                                alt="Pet Parent" />
                                            <img class="w-10 h-10 rounded-full border-2 border-white object-cover"
                                                src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=100&q=80"
                                                alt="Pet Parent" />
                                            <img class="w-10 h-10 rounded-full border-2 border-white object-cover"
                                                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80"
                                                alt="Pet Parent" />
                                        </div>
                                        <div class="flex flex-col text-left">
                                            <div class="flex text-amber-400 text-[10px] gap-0.5">
                                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i
                                                    class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i
                                                    class="fa-solid fa-star"></i>
                                            </div>
                                            <span class="text-xs font-extrabold text-accent-navy bg-clip-text">2k+ Happy
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Image Content -->
                            <div class="lg:w-1/2 relative mt-12 lg:mt-0 pb-8 flex justify-center">
                                <div
                                    class="relative z-10 rounded-[2.5rem] overflow-hidden border-[8px] border-white shadow-2xl transform hover:rotate-2 transition duration-500 w-full max-w-md lg:max-w-full">
                                    <img src="https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=800&q=80"
                                        alt="Happy Dog" class="w-full h-[400px] lg:h-[550px] object-cover">
                                </div>
                                <div
                                    class="absolute -bottom-6 -right-6 w-32 h-32 bg-amber-100 rounded-full mix-blend-multiply opacity-50 z-0 hidden lg:block animate-pulse">
                                </div>
                                <div class="absolute -top-6 -left-6 w-24 h-24 bg-brand-100 rounded-full mix-blend-multiply opacity-50 z-0 hidden lg:block"
                                    style="animation: float 6s ease-in-out infinite;">
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- FEATURES STRIP -->
                <section
                    class="border-y border-gray-100 bg-white relative z-20 shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.05)]">
                    <div
                        class="max-w-7xl mx-auto px-6 py-8 grid grid-cols-2 lg:grid-cols-4 gap-8 lg:divide-x divide-gray-100">

                        <div class="flex flex-col items-center text-center px-4 group">
                            <div
                                class="w-14 h-14 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:-translate-y-2 group-hover:shadow-lg group-hover:shadow-blue-500/20 transition-all duration-300">
                                <i class="fa-solid fa-truck-fast"></i>
                            </div>
                            <h4 class="font-black text-gray-900">Fast Delivery</h4>
                            <p class="text-xs text-gray-500 mt-1 font-medium leading-relaxed">Free, fast shipping on
                                orders over ₹500</p>
                        </div>

                        <div class="flex flex-col items-center text-center px-4 group">
                            <div
                                class="w-14 h-14 bg-emerald-50 text-emerald-500 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:-translate-y-2 group-hover:shadow-lg group-hover:shadow-emerald-500/20 transition-all duration-300">
                                <i class="fa-solid fa-shield-cat"></i>
                            </div>
                            <h4 class="font-black text-gray-900">Trusted Brands</h4>
                            <p class="text-xs text-gray-500 mt-1 font-medium leading-relaxed">100% genuine & safe
                                products</p>
                        </div>

                        <div class="flex flex-col items-center text-center px-4 group">
                            <div
                                class="w-14 h-14 bg-purple-50 text-purple-500 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:-translate-y-2 group-hover:shadow-lg group-hover:shadow-purple-500/20 transition-all duration-300">
                                <i class="fa-solid fa-award"></i>
                            </div>
                            <h4 class="font-black text-gray-900">Premium Quality</h4>
                            <p class="text-xs text-gray-500 mt-1 font-medium leading-relaxed">Tested and curated with
                                love</p>
                        </div>

                        <div class="flex flex-col items-center text-center px-4 group">
                            <div
                                class="w-14 h-14 bg-brand-50 text-brand-500 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:-translate-y-2 group-hover:shadow-lg group-hover:shadow-brand-500/20 transition-all duration-300">
                                <i class="fa-solid fa-headset"></i>
                            </div>
                            <h4 class="font-black text-gray-900">24/7 Support</h4>
                            <p class="text-xs text-gray-500 mt-1 font-medium leading-relaxed">Expert help when you need
                                it</p>
                        </div>

                    </div>
                </section>

                <section id="products" class="py-24 bg-accent-cream">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <h2 class="text-3xl font-bold text-accent-navy mb-12 text-center">Popular Picks</h2>

                        <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                            <% if (products && products.length> 0) { %>
                                <% products.forEach(product=> { %>
                                    <div
                                        class="bg-white rounded-3xl p-4 shadow-sm hover:shadow-xl transition-all group border border-gray-100 flex flex-col hover:-translate-y-1">
                                        <div class="relative h-56 rounded-2xl overflow-hidden mb-4 bg-brand-50">
                                            <img src="<%= product.image %>" alt="<%= product.title %>"
                                                class="w-full h-full object-cover group-hover:scale-105 transition duration-700">
                                            <% if (product.badge) { %>
                                                <span
                                                    class="absolute top-3 left-3 bg-white/95 backdrop-blur text-[10px] font-bold px-3 py-1.5 rounded-full text-brand-500 shadow-sm uppercase tracking-wide flex items-center gap-1">
                                                    <i class="fa-solid fa-face-smile text-accent-teal"></i>
                                                    <%= product.badge %>
                                                </span>
                                                <% } %>
                                                    <button
                                                        class="absolute bottom-3 right-3 w-10 h-10 bg-white rounded-xl shadow-lg flex items-center justify-center text-accent-tealDark hover:bg-brand-500 hover:text-white transition transform translate-y-12 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 duration-300">
                                                        <i class="fa-solid fa-plus"></i>
                                                    </button>
                                        </div>
                                        <div class="flex-1 px-1">
                                            <div
                                                class="text-[10px] text-accent-tealDark font-extrabold uppercase mb-1.5 tracking-wider">
                                                <%= product.category %>
                                            </div>
                                            <h3
                                                class="font-bold text-accent-navy text-lg leading-tight mb-2 group-hover:text-brand-500 transition">
                                                <%= product.title %>
                                            </h3>
                                            <span class="text-xl font-extrabold text-accent-navy">$<%=
                                                    product.price.toFixed(2) %></span>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <p class="col-span-full text-center text-gray-400">No products found!</p>
                                            <% } %>
                        </div>
                    </div>
                </section>

                <footer class="bg-white text-accent-navy pt-20 pb-10 border-t border-brand-100">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                        <div class="flex justify-center items-center gap-2 mb-6">
                            <div class="bg-brand-500 text-white w-8 h-8 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-heart text-sm"></i>
                            </div>
                            <span class="font-extrabold text-2xl tracking-tight">Paw<span
                                    class="text-brand-500">Palace</span></span>
                        </div>
                        <p class="text-sm text-gray-400">&copy; 2025 PawPalace. Made with love for furry friends.</p>
                    </div>
                </footer>

                <script>
                    window.addEventListener('scroll', () => {
                        const nav = document.getElementById('navbar');
                        window.scrollY > 20 ? nav.classList.add('shadow-md') : nav.classList.remove('shadow-md');
                    });
                </script>
</body>

</html>