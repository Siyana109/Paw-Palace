<nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">

            <a href="/" class="flex items-center gap-2 group cursor-pointer">
                <div
                    class="bg-brand-500 text-white p-2 rounded-xl shadow-lg shadow-brand-200 group-hover:scale-110 transition duration-300">
                    <i class="fa-solid fa-paw text-xl"></i>
                </div>
                <span class="font-extrabold text-2xl tracking-tight text-accent-navy">
                    Paw<span class="text-brand-500">Palace</span>
                </span>
            </a>

            <div class="hidden md:flex items-center gap-8">
                <a href="/"
                    class="<%= currentPath === '/' ? 'text-brand-500 font-bold border-b-2 border-brand-500 pb-1' : 'text-gray-500 hover:text-accent-navy font-bold transition' %>">
                    Home
                </a>

                <a href="/home"
                    class="<%= currentPath.startsWith('/home') ? 'text-brand-500 font-bold border-b-2 border-brand-500 pb-1' : 'text-gray-500 hover:text-accent-navy font-bold transition' %>">
                    Shop All
                </a>

            </div>

            <div class="flex items-center gap-6 text-accent-navy">
                <a href="<%= user ? '/wishlist' : '/login' %>" class="hover:text-brand-500 transition relative group">

                    <i class="fa-regular fa-heart text-2xl"></i>

                    <span id="wishlistCountBadge" class="absolute -top-1 -right-1 bg-accent-navy text-white text-[10px] font-bold
           h-4 w-4 rounded-full flex items-center justify-center border-2 border-white
           group-hover:bg-brand-500">
                        <%= wishlistCount %>
                    </span>
                </a>
                <a href="<%= user ? '/cart' : '/login' %>" class="hover:text-brand-500 transition relative group">

                    <i class="fa-solid fa-cart-shopping text-2xl"></i>

                    <span id="cartCountBadge" class="absolute -top-1 -right-1 bg-brand-500 text-white text-[10px] font-bold
           h-4 w-4 rounded-full flex items-center justify-center border-2 border-white">
                        <%= cartCount %>
                    </span>
                </a>


                <a href="<%= user ? '/profile' : '/login' %>" class="h-10 w-10 rounded-xl flex items-center justify-center overflow-hidden transition
   <%= currentPath.startsWith('/profile')
      ? 'bg-accent-teal text-white'
      : 'bg-teal-50 text-accent-teal hover:bg-accent-teal hover:text-white' %>">

                    <% if (user && user.profilePic) { %>
                        <!-- PROFILE IMAGE -->
                        <img src="<%= user.profilePic %>" alt="Profile" class="w-full h-full object-cover" />
                        <% } else { %>
                            <!-- DEFAULT USER ICON -->
                            <i class="fa-solid fa-user text-lg"></i>
                            <% } %>

                </a>

                <% if (!user) { %>
                    <a href="/login"
                        class="hidden sm:block text-sm font-bold text-gray-500 hover:text-brand-500 transition">
                        Login
                    </a>
                    <% } else { %>
                        <span class="hidden sm:block text-sm font-bold text-accent-navy truncate max-w-[120px]">
                            <%= user.fullName %>

                        </span>
                        <% } %>



            </div>
        </div>
    </div>
</nav>

<script>
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });

    window.updateCartCount = (count) => {
        const badge = document.getElementById('cartCountBadge');
        if (badge) {
            badge.innerText = count;
            // Optional: Bounce animation
            badge.classList.add('scale-125');
            setTimeout(() => badge.classList.remove('scale-125'), 200);
        }
    };

    window.updateWishlistCount = (count) => {
        const badge = document.getElementById('wishlistCountBadge');
        if (badge) {
            badge.innerText = count;
            badge.classList.add('scale-125');
            setTimeout(() => badge.classList.remove('scale-125'), 200);
        }
    };
</script>