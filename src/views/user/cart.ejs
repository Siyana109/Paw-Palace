<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart | PawPalace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-accent-cream font-sans text-accent-navy antialiased min-h-screen flex flex-col">

    <%- include('../partials/header') %>

        <main class="flex-grow max-w-7xl mx-auto py-12 px-6 w-full">

            <h1 class="text-4xl md:text-5xl font-extrabold mb-12">Your Cart <span class="text-brand-500">.</span></h1>

            <div class="flex flex-col lg:flex-row gap-12 items-start">

                <!-- LEFT COLUMN: CART ITEMS -->
                <div class="w-full lg:flex-1 space-y-6">

                    <% if (cart && cart.items && cart.items.length> 0) { %>

                        <% cart.items.forEach(item=> { %>
                            <div
                                class="bg-white rounded-[2rem] p-4 sm:p-6 shadow-sm border border-gray-100 flex flex-col sm:flex-row gap-6 items-center relative group">

                                <!-- DELETE BUTTON (Top right on mobile, inline on desktop) -->
                                <button onclick="removeItem('<%= item.variant._id %>')"
                                    class="absolute top-4 right-4 text-brand-500 hover:text-red-600 w-8 h-8 flex items-center justify-center rounded-full hover:bg-red-50 transition">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>

                                <!-- IMAGE -->
                                <div
                                    class="w-24 h-24 sm:w-32 sm:h-32 flex-shrink-0 bg-gray-50 rounded-2xl overflow-hidden cursor-pointer">
                                    <a href="/product/<%= item.product._id %>">
                                        <img src="<%= item.variant.coverImage %>" alt="<%= item.product.name %>"
                                            class="w-full h-full object-cover">
                                    </a>
                                </div>

                                <!-- DETAILS -->
                                <div class="flex-1 text-center sm:text-left w-full">
                                    <h3 class="font-bold text-lg text-accent-navy mb-1 hover:text-brand-500 transition">
                                        <a href="/product/<%= item.product._id %>">
                                            <%= item.product.productName %>
                                        </a>
                                    </h3>
                                    <p class="text-sm text-gray-700 mb-4 font-medium">
                                        <% if(item.variant.size) { %>Size: <%= item.variant.size %>
                                                <% } %>
                                                    <% if(item.variant.size && item.variant.color) { %>•<% } %>
                                                            <% if(item.variant.color) { %>Color: <%= item.variant.color
                                                                    %>
                                                                    <% } %>
                                    </p>

                                    <!-- QUANTITY CONTROLS -->
                                    <div class="flex flex-col items-center sm:items-start gap-1">
                                        <div class="flex items-center bg-gray-50 rounded-xl p-1">
                                            <button
                                                onclick="updateQuantity('<%= item.variant._id %>', -1, <%= item.quantity %>, <%= item.variant.stock %>)"
                                                class="w-8 h-8 flex items-center justify-center rounded-lg border border-transparent transition-all
                                                    <%= item.quantity <= 1 
                                                        ? 'bg-gray-100 text-gray-300 cursor-not-allowed shadow-none' 
                                                        : 'bg-white text-gray-400 hover:text-accent-navy hover:border-gray-200 shadow-sm' %>"
                                                <%=item.quantity <=1 ? 'disabled' : '' %>>
                                                <i class="fa-solid fa-minus text-xs"></i>
                                            </button>

                                            <span id="qty-<%= item.variant._id %>"
                                                class="w-10 text-center font-bold text-sm text-accent-navy">
                                                <%= item.quantity %>
                                            </span>

                                            <button
                                                onclick="updateQuantity('<%= item.variant._id %>', 1, <%= item.quantity %>, <%= item.variant.stock %>)"
                                                class="w-8 h-8 flex items-center justify-center rounded-lg border border-transparent transition-all
                                                    <%= item.quantity >= Math.min(item.variant.stock, 10)
                                                        ? 'bg-gray-100 text-gray-300 cursor-not-allowed shadow-none' 
                                                        : 'bg-white text-gray-400 hover:text-accent-navy hover:border-gray-200 shadow-sm' %>"
                                                <%=item.quantity>= Math.min(item.variant.stock, 10) ? 'disabled' : ''
                                                %>>
                                                <i class="fa-solid fa-plus text-xs"></i>
                                            </button>
                                        </div>

                                        <!-- Stock Limit Message -->
                                        <% if (item.variant.stock===0) { %>
                                            <p class="text-[10px] font-bold text-red-500">
                                                Out of stock
                                            </p>
                                            <% } else if (item.quantity>= 10 && item.variant.stock >= 10) { %>
                                                <p class="text-[10px] font-bold text-red-400">
                                                    Max limit reached (10)
                                                </p>
                                                <% } else if (item.quantity>= item.variant.stock) { %>
                                                    <p class="text-[10px] font-bold text-red-400">
                                                        Stock limit reached
                                                    </p>
                                                    <% } %>
                                    </div>
                                </div>

                                <!-- PRICE -->
                                <div class="flex flex-col items-end gap-1">
                                    <% const effectivePrice=(item.variant.offerPrice && item.variant.offerPrice <
                                        item.variant.price) ? item.variant.offerPrice : item.variant.price; const
                                        itemTotal=effectivePrice * item.quantity; %>
                                        <span class="text-sm font-semibold text-gray-500">₹<%= effectivePrice %> /- </span>

                                        <div class="flex items-end gap-2 mt-1">
                                            <span class="text-sm font-bold text-gray-400">Total:</span>
                                            <span class="text-brand-500 text-xl font-black">₹<%= itemTotal.toFixed(2) %>
                                                    </span>
                                        </div>
                                </div>
                            </div>
                            <% }) %>



                                <% } else { %>
                                    <!-- EMPTY STATE -->
                                    <div class="text-center py-20 bg-white rounded-[2.5rem] shadow-sm">
                                        <div
                                            class="bg-gray-50 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                                            <i class="fa-solid fa-basket-shopping text-4xl text-gray-300"></i>
                                        </div>
                                        <h2 class="text-2xl font-bold text-gray-900 mb-2">Your cart is empty</h2>
                                        <p class="text-gray-500 mb-8">Looks like you haven't added anything yet.</p>
                                        <a href="/home"
                                            class="inline-block bg-brand-500 text-white px-8 py-3 rounded-xl font-bold hover:bg-brand-600 transition shadow-lg shadow-brand-500/30">
                                            Start Shopping
                                        </a>
                                    </div>
                                    <% } %>

                </div>

                <!-- RIGHT COLUMN: ORDER SUMMARY -->
                <% if (cart && cart.items && cart.items.length> 0) { %>
                    <div class="w-full lg:w-96 flex-shrink-0">
                        <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100 sticky top-8">
                            <h2 class="text-xl font-bold mb-8">Order Summary</h2>

                            <div class="border-t border-gray-100 my-6"></div>

                            <% const subtotal=cart.items.reduce((acc, item)=>
                                acc + (item.variant.price * item.quantity), 0
                                );

                                const offerDiscount = cart.items.reduce((acc, item) =>
                                acc + ((item.variant.price - (item.variant.offerPrice || item.variant.price)) *
                                item.quantity), 0
                                );

                                const postOfferTotal = subtotal - offerDiscount;

                                const shipping = 50;

                                const total = postOfferTotal + shipping;
                                %>

                                <div class="space-y-4 mb-8">

                                    <div class="flex justify-between items-center text-sm font-bold text-gray-500">
                                        <span>Subtotal</span>
                                        <span class="text-accent-navy">₹<%= subtotal.toFixed(2) %></span>
                                    </div>

                                    <div class="flex justify-between items-center text-sm font-bold text-gray-500">
                                        <span>Discount</span>
                                        <span class="text-emerald-600">-₹<%= offerDiscount.toFixed(2) %></span>
                                    </div>

                                    <div class="flex justify-between items-center text-sm font-bold text-gray-500">
                                        <span>Shipping</span>

                                        <span class="text-accent-navy">₹<%= shipping.toFixed(2) %></span>
                                    </div>

                                </div>

                                <div class="border-t border-gray-100 my-6"></div>

                                <div class="flex justify-between items-center mb-8">
                                    <span class="font-bold text-lg">Total</span>
                                    <span class="text-3xl font-black text-brand-500">
                                        ₹<%= total.toFixed(2) %>
                                    </span>
                                </div>

                                <% if (hasStockIssues) { %>
                                    <div
                                        class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-sm font-bold mb-4">
                                        <i class="fa-solid fa-triangle-exclamation mr-2"></i>
                                        Some items are out of stock or exceed available quantity.
                                        Please update your cart to continue.
                                    </div>
                                    <% } %>

                                        <button <% if (hasStockIssues) { %> disabled <% } %>
                                                onclick="<%= hasStockIssues ? '' : `window.location.href='/checkout' `
                                                    %>"
                                                    class="w-full py-4 rounded-xl font-bold
                                                    <%= hasStockIssues ? 'bg-gray-300 text-gray-500 cursor-not-allowed'
                                                        : 'bg-brand-500 text-white hover:bg-brand-600' %>">
                                                        Proceed to Checkout
                                        </button>

                        </div>
                    </div>
                    <% } %>

            </div>

        </main>

        <%- include('../partials/footer') %>

            <script>
                async function updateQuantity(variantId, change, currentQty, maxStock) {

                    const newQty = currentQty + change;
                    const limit = Math.min(maxStock, 10);

                    if (newQty < 1) return;

                    if (newQty > limit) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Limit Reached',
                            text: `Maximum limit is ${limit} items for this product`,
                            timer: 2000,
                            showConfirmButton: false
                        });
                        return;
                    }

                    try {
                        const res = await fetch('/cart/update', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ variantId, quantity: newQty }) // Send absolute quantity, or change if backend expects change
                        });

                        const data = await res.json();

                        if (!data.success) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Could not update quantity'
                            });
                            return;
                        }

                        if (data.cartCount !== undefined && typeof window.updateCartCount === 'function') {
                            window.updateCartCount(data.cartCount);
                        }

                        location.reload();

                    } catch (err) {
                        console.error(err);
                    }
                }

                async function removeItem(variantId) {
                    const result = await Swal.fire({
                        title: 'Remove item?',
                        text: 'This item will be removed from your cart.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, remove it',
                        cancelButtonText: 'Cancel',
                        reverseButtons: true,
                        customClass: {
                            popup: 'rounded-3xl',
                            confirmButton: 'bg-red-500 text-white px-6 py-2 rounded-xl font-bold',
                            cancelButton: 'bg-gray-200 text-gray-700 px-6 py-2 rounded-xl font-bold'
                        },
                        buttonsStyling: false
                    });

                    if (!result.isConfirmed) return;

                    const res = await fetch('/cart/remove', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ variantId })
                    });

                    const data = await res.json();

                    if (data.success) {
                        if (data.cartCount !== undefined && typeof window.updateCartCount === 'function') {
                            window.updateCartCount(data.cartCount);
                        }

                        Swal.fire({
                            icon: 'success',
                            title: 'Removed!',
                            text: 'Item removed from cart.',
                            timer: 1200,
                            showConfirmButton: false
                        });

                        setTimeout(() => location.reload(), 1200);
                    }
                }
            </script>

</body>

</html>