<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | PawPalace</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-accent-cream font-sans text-accent-navy font-medium">

    <%- include('../partials/header') %>

        <main class="flex-grow max-w-7xl mx-auto py-12 px-6 w-full">

            <h1 class="text-4xl md:text-5xl font-extrabold mb-12 hidden">Checkout</h1>

            <!-- Main Layout: Left Column (Steps) & Right Column (Summary) -->
            <div class="flex flex-col lg:flex-row gap-8 items-start">

                <!-- LEFT COLUMN -->
                <div class="w-full lg:flex-1 space-y-8">

                    <!-- STEP 1: DELIVERY ADDRESS -->
                    <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100">
                        <div class="flex justify-between items-center mb-6">
                            <div class="flex items-center gap-4">
                                <span
                                    class="w-10 h-10 rounded-full bg-accent-navy text-white flex items-center justify-center font-bold text-lg">1</span>
                                <h2 class="text-xl font-bold">Delivery Address</h2>
                            </div>
                        </div>

                        <div id="selectedAddressContainer">
                            <!-- Populated by JS -->
                        </div>

                        <% if (!addresses || addresses.length===0) { %>
                            <div
                                class="text-center py-8 text-gray-500 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200">
                                <p class="mb-4">No addresses found.</p>
                                <button onclick="openAddAddressModal()"
                                    class="text-brand-500 font-bold hover:underline">
                                    + Add New Address
                                </button>
                            </div>
                            <% } %>
                    </div>

                    <!-- STEP 2: PAYMENT METHOD -->
                    <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100">
                        <div class="flex items-center gap-4 mb-6">
                            <span
                                class="w-10 h-10 rounded-full bg-accent-navy text-white flex items-center justify-center font-bold text-lg">2</span>
                            <h2 class="text-xl font-bold">Payment Method</h2>
                        </div>

                        <div class="space-y-4">

                            <label class="block relative cursor-pointer group">
                                <input type="radio" name="paymentDetails" value="WALLET" class="peer sr-only">
                                <div
                                    class="p-4 sm:p-6 rounded-3xl border-2 border-gray-100 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 transition-all flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center text-emerald-600 text-xl flex-shrink-0">
                                        <i class="fa-solid fa-wallet"></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-lg">PawPalace Wallet</h4>
                                        <p class="text-sm text-emerald-600 font-bold">Available Balance: ₹125.00</p>
                                    </div>
                                    <div
                                        class="ml-auto w-6 h-6 rounded-full border-2 border-gray-300 peer-checked:border-emerald-500 flex items-center justify-center">
                                        <div
                                            class="w-3 h-3 rounded-full bg-emerald-500 opacity-0 peer-checked:opacity-100 transition-opacity">
                                        </div>
                                    </div>
                                </div>
                            </label>


                            <!-- Pay Online -->
                            <label class="block relative cursor-pointer group">
                                <input type="radio" name="paymentDetails" value="ONLINE" class="peer sr-only" checked>
                                <div
                                    class="p-4 sm:p-6 rounded-3xl border-2 border-gray-100 peer-checked:border-brand-500 peer-checked:bg-brand-50 transition-all flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-500 text-xl flex-shrink-0">
                                        <i class="fa-solid fa-credit-card"></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-lg">Pay Online</h4>
                                        <p class="text-xs text-gray-500 max-w-[200px] sm:max-w-none">UPI, Netbanking, or
                                            Wallets (GPay, PhonePe)</p>
                                    </div>
                                    <div
                                        class="ml-auto w-6 h-6 rounded-full border-2 border-gray-300 peer-checked:border-brand-500 flex items-center justify-center">
                                        <div
                                            class="w-3 h-3 rounded-full bg-brand-500 opacity-0 peer-checked:opacity-100 transition-opacity">
                                        </div>
                                    </div>
                                </div>
                            </label>

                            <!-- COD -->
                            <label class="block relative cursor-pointer group">
                                <input type="radio" name="paymentDetails" value="COD" class="peer sr-only">
                                <div
                                    class="p-4 sm:p-6 rounded-3xl border-2 border-gray-100 peer-checked:border-brand-500 peer-checked:bg-brand-50 transition-all flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-500 text-xl flex-shrink-0">
                                        <i class="fa-solid fa-money-bill-wave"></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-lg">Cash on Delivery</h4>
                                        <p class="text-xs text-gray-500">Pay in cash when your order arrives.</p>
                                    </div>
                                    <div
                                        class="ml-auto w-6 h-6 rounded-full border-2 border-gray-300 peer-checked:border-brand-500 flex items-center justify-center">
                                        <div
                                            class="w-3 h-3 rounded-full bg-brand-500 opacity-0 peer-checked:opacity-100 transition-opacity">
                                        </div>
                                    </div>
                                </div>
                            </label>

                        </div>

                    </div>

                </div>

                <!-- RIGHT COLUMN: SUMMARY & COUPON -->
                <div class="w-full lg:w-[32rem] flex-shrink-0 space-y-6">

                    <!-- STEP 3: COUPON -->
                    <div class="bg-white rounded-[2.5rem] p-6 sm:p-8 shadow-sm border border-gray-100">
                        <div class="flex justify-between items-center mb-4">
                            <div class="flex items-center gap-3">
                                <span
                                    class="w-8 h-8 rounded-full bg-accent-navy text-white flex items-center justify-center font-bold text-sm">3</span>
                                <h2 class="font-bold text-lg">Apply coupon</h2>
                            </div>
                            <!-- <span class="text-xs text-gray-400 font-bold uppercase tracking-wider">remove coupon</span> -->
                        </div>

                        <!-- SELECT DROPDOWN FOR COUPONS -->
                        <div class="flex gap-3">
                            <div class="relative flex-1">
                                <select id="couponSelect"
                                    class="w-full bg-white border border-gray-200 text-gray-700 font-bold py-3 pl-4 pr-10 rounded-xl appearance-none focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all cursor-pointer">
                                    <option value="">Select a coupon</option>
                                    <% if (coupons && coupons.length> 0) { %>
                                        <% coupons.forEach(coupon=> { %>
                                            <option value="<%= coupon.code %>">
                                                <%= coupon.code %> - <%= coupon.discountValue %>
                                                        <%= coupon.discountType==='percentage' ? '%' : ' OFF' %>
                                            </option>
                                            <% }) %>
                                                <% } %>
                                </select>
                                <div
                                    class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-gray-500">
                                    <i class="fa-solid fa-chevron-down text-xs"></i>
                                </div>
                            </div>
                            <button type="button" onclick="applyCoupon()"
                                class="bg-brand-500 text-white px-6 rounded-xl font-bold hover:bg-brand-600 transition shadow-lg shadow-brand-500/20">
                                Apply
                            </button>
                        </div>
                    </div>


                    <form action="/checkout/place-order" method="POST" id="checkoutForm">
                        <input type="hidden" name="paymentDetails" id="paymentDetailsInput">
                        <% if (stockIssues.length) { %>
                            <div
                                class="mb-6 bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-sm font-bold">
                                <i class="fa-solid fa-triangle-exclamation mr-2"></i>
                                Some items in your cart are unavailable or exceed stock limits.
                                Please update or remove them to continue.
                            </div>
                            <% } %>
                                <!-- ORDER SUMMARY -->
                                <div class="bg-white rounded-[2.5rem] p-6 sm:p-8 shadow-sm border border-gray-100">
                                    <h2 class="text-xl font-bold mb-6">Order Summary</h2>

                                    <!-- Items List -->
                                    <div class="space-y-6 mb-8 max-h-60 overflow-y-auto pr-2 custom-scrollbar">
                                        <% if (cart && cart.items) { %>
                                            <% cart.items.forEach(item=> { %>
                                                <div class="flex items-center gap-4">
                                                    <div
                                                        class="w-14 h-14 rounded-xl bg-gray-50 flex-shrink-0 overflow-hidden relative">
                                                        <img src="<%= item.variant.coverImage || '/path/to/default.jpg' %>"
                                                            alt="<%= item.product.productName %>"
                                                            class="w-full h-full object-cover">
                                                        <span
                                                            class="absolute top-0 right-0 bg-gray-500 text-white text-[9px] font-bold w-4 h-4 flex items-center justify-center rounded-bl-lg">
                                                            <%= item.quantity %>
                                                        </span>
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <h4 class="font-bold text-sm text-accent-navy truncate">
                                                            <%= item.product.productName %>
                                                        </h4>

                                                        <% const issue=stockIssues.find(i=>
                                                            i.variantId.toString() === item.variant._id.toString()
                                                            );
                                                            %>

                                                            <% if (issue) { %>
                                                                <p class="text-xs font-bold text-red-500 mt-1">
                                                                    <i class="fa-solid fa-circle-exclamation"></i>
                                                                    <%= issue.message %>
                                                                </p>
                                                                <% } %>
                                                                    <p class="text-xs text-gray-400">
                                                                        <%= item.variant.size ? item.variant.size : ''
                                                                            %>
                                                                            <%= item.variant.color ? ' / ' +
                                                                                item.variant.color : '' %>
                                                                    </p>
                                                    </div>
                                                    <span class="font-bold text-sm text-accent-navy">
                                                        <div class="text-right">
                                                            <% if (item.variant.offerApplied) { %>
                                                                <span
                                                                    class="block text-xs text-gray-400 line-through font-bold">
                                                                    ₹<%= item.variant.price.toFixed(2) %>
                                                                </span>
                                                                <span class="block text-sm font-bold text-brand-500">
                                                                    ₹<%= item.variant.offerPrice.toFixed(2) %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span class="text-sm font-bold text-accent-navy">
                                                                        ₹<%= item.variant.price.toFixed(2) %>
                                                                    </span>
                                                                    <% } %>
                                                        </div>
                                                    </span>
                                                </div>
                                                <% }) %>
                                                    <% } %>
                                    </div>

                                    <!-- Totals -->
                                    <% const subtotal=cart.items.reduce((acc, item)=> {
                                        const price = item.variant.offerApplied
                                        ? item.variant.offerPrice
                                        : item.variant.price;
                                        return acc + price * item.quantity;
                                        }, 0);

                                        const offerDiscount = cart.items.reduce((acc, item) => {
                                        if (!item.variant.offerApplied) return acc;
                                        return acc + (item.variant.price - item.variant.offerPrice) * item.quantity;
                                        }, 0);

                                        const shipping = 50;
                                        const couponDiscount = 0; // updated via JS
                                        const total = subtotal + shipping - offerDiscount - couponDiscount;
                                        %>

                                        <div class="space-y-3 mb-6">
                                            <div
                                                class="flex justify-between items-center text-xs font-bold text-gray-400">
                                                <span>Subtotal</span>
                                                <span class="text-gray-600">₹<%= subtotal.toFixed(2) %></span>
                                            </div>
                                            <div
                                                class="flex justify-between items-center text-xs font-bold text-gray-400">
                                                <span>Shipping</span>
                                                <span class="text-gray-600">₹<%= shipping.toFixed(2) %></span>
                                            </div>
                                            <!-- Tax Removed -->
                                            <div
                                                class="flex justify-between items-center text-xs font-bold text-gray-400">
                                                <span>Offer discount</span>
                                                <span class="text-brand-500">-₹<%= offerDiscount.toFixed(2) %></span>
                                            </div>
                                            <!-- Coupon applied row (hidden by default) -->
                                            <!-- Coupon applied row -->
                                            <div id="couponRow" style="display: none;"
                                                class="justify-between items-center text-xs font-bold text-gray-400">
                                                <div class="flex items-center gap-2">
                                                    <span id="couponCodeDisplay">Coupon applied</span>
                                                    <button type="button" onclick="removeCoupon()"
                                                        class="text-xs text-red-500 hover:text-red-700 font-bold underline">Remove</button>
                                                </div>
                                                <span id="couponDiscountDisplay" class="text-brand-500">-₹0.00</span>
                                                <input type="hidden" name="couponCode" id="appliedCouponCode" value="">
                                            </div>
                                        </div>

                                        <div class="border-t border-gray-100 my-6"></div>

                                        <div class="flex justify-between items-end mb-8">
                                            <span class="font-bold text-lg text-accent-navy">Total to Pay</span>
                                            <span id="totalAmountDisplay" class="text-3xl font-black text-brand-500">₹
                                                <%= total.toFixed(2) %>
                                            </span>
                                        </div>

                                        <button type="button" <%=stockIssues.length ? 'disabled' : '' %>
                                            onclick="<%= stockIssues.length ? '' : 'openConfirmationModal()' %>"
                                                class="w-full py-4 rounded-2xl font-bold text-lg
                                                <%= stockIssues.length
                                                    ? 'bg-gray-300 text-gray-500 cursor-not-allowed pointer-events-none'
                                                    : 'bg-brand-500 text-white hover:bg-brand-600 shadow-xl shadow-brand-500/20 active:scale-95'
                                                    %>">
                                                    <%= stockIssues.length ? 'Fix cart items to continue'
                                                        : 'Place Order' %>
                                        </button>

                                        <p class="text-[10px] text-gray-400 text-center mt-4">
                                            All transactions are secure and encrypted.
                                        </p>

                                </div>
                    </form>

                </div>

            </div>

        </main>

        <%- include('../partials/footer') %>

            <!-- SELECT ADDRESS MODAL -->
            <div id="selectAddressModal" class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">
                <div class="bg-white w-full max-w-lg rounded-3xl p-8 relative max-h-[90vh] flex flex-col">
                    <div class="flex justify-between items-center mb-6 flex-shrink-0">
                        <h2 class="text-xl font-bold">Select Address</h2>
                        <button onclick="closeSelectAddressModal()"
                            class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200">
                            <i class="fa-solid fa-times"></i>
                        </button>
                    </div>

                    <div id="addressListContainer" class="flex-1 overflow-y-auto space-y-3 custom-scrollbar pr-2">
                        <!-- Addresses populated by JS -->
                    </div>
                </div>
            </div>

            <!-- ORDER CONFIRMATION MODAL -->
            <div id="orderConfirmationModal"
                class="fixed inset-0 bg-black/60 hidden items-end sm:items-center justify-center z-50 transition-all duration-300 backdrop-blur-sm">
                <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-8 relative flex flex-col shadow-2xl transform transition-transform duration-300 translate-y-full sm:translate-y-0 scale-95 opacity-0"
                    id="confirmModalContent">

                    <button onclick="closeConfirmationModal()"
                        class="absolute top-6 right-6 w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 transition">
                        <i class="fa-solid fa-times"></i>
                    </button>

                    <div class="text-center mb-6">
                        <div
                            class="w-16 h-16 bg-brand-50 rounded-full flex items-center justify-center mx-auto mb-4 text-brand-500">
                            <i class="fa-solid fa-clipboard-check text-3xl"></i>
                        </div>
                        <h2 class="text-2xl font-black text-accent-navy">Confirm Order</h2>
                        <p class="text-gray-500 text-sm mt-1">Please verify your order details</p>
                    </div>

                    <div class="space-y-4 bg-gray-50 p-5 rounded-2xl mb-6 border border-gray-100">
                        <div class="flex justify-between items-center">
                            <span class="text-gray-500 font-bold text-sm">Payment Method</span>
                            <span id="confirmPaymentMethod" class="font-bold text-accent-navy"></span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-500 font-bold text-sm">Total Amount</span>
                            <span id="confirmTotalAmount" class="font-black text-brand-500 text-lg"></span>
                        </div>
                        <div class="border-t border-gray-200"></div>
                        <div>
                            <span class="text-gray-500 font-bold text-sm block mb-1">Delivering To</span>
                            <p id="confirmAddress"
                                class="text-xs text-gray-600 font-medium leading-relaxed line-clamp-2"></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <button onclick="closeConfirmationModal()"
                            class="py-3.5 rounded-xl font-bold text-gray-500 hover:bg-gray-100 transition border border-gray-200">
                            Cancel
                        </button>
                        <button onclick="submitOrder()"
                            class="py-3.5 rounded-xl font-bold text-white bg-brand-500 hover:bg-brand-600 transition shadow-lg shadow-brand-500/20 flex items-center justify-center gap-2">
                            <span>Confirm</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>

                </div>
            </div>

            <div class="space-y-4 overflow-y-auto custom-scrollbar flex-1 pr-2" id="addressListContainer">
                <!-- Populated by JS -->
            </div>

            <div class="mt-6 pt-4 border-t border-gray-100 flex-shrink-0">
                <button onclick="openAddAddressModal()"
                    class="w-full py-3 rounded-xl border-2 border-brand-500 text-brand-500 font-bold hover:bg-brand-50 transition">
                    + Add New Address
                </button>
            </div>
            </div>
            </div>

            <!-- ADD / EDIT ADDRESS MODAL -->
            <div id="addressModal"
                class="fixed inset-0 z-50 hidden items-center justify-center bg-accent-navy/40 backdrop-blur-sm px-4">

                <div class="bg-white rounded-[2.5rem] p-8 w-full max-w-lg shadow-2xl relative">

                    <h3 id="addressModalTitle" class="text-2xl font-bold mb-6">
                        Add Address
                    </h3>

                    <!-- MESSAGE -->
                    <div id="addressMessage" class="hidden mb-4 px-4 py-3 rounded-xl text-sm font-semibold">
                    </div>

                    <form id="addressForm" class="space-y-4">
                        <input type="hidden" id="addressId">

                        <input id="addrFullName" class="w-full border rounded-xl p-3 font-medium"
                            placeholder="Full Name">

                        <input id="addrPhone" class="w-full border rounded-xl p-3 font-medium" placeholder="Phone">

                        <textarea id="addrAddress" class="w-full border rounded-xl p-3 font-medium"
                            placeholder="Address"></textarea>

                        <input id="addrLandmark" class="w-full border rounded-xl p-3 font-medium"
                            placeholder="Landmark (optional)">

                        <input id="addrCity" class="w-full border rounded-xl p-3 font-medium" placeholder="City">

                        <input id="addrState" class="w-full border rounded-xl p-3 font-medium" placeholder="State">

                        <input id="addrZip" class="w-full border rounded-xl p-3 font-medium" placeholder="Pincode">

                        <div class="flex gap-3">
                            <button type="button" class="addr-type-btn px-5 py-2 rounded-xl font-bold border"
                                data-type="Home">
                                Home
                            </button>

                            <button type="button" class="addr-type-btn px-5 py-2 rounded-xl font-bold border"
                                data-type="Work">
                                Work
                            </button>

                            <button type="button" class="addr-type-btn px-5 py-2 rounded-xl font-bold border"
                                data-type="Other">
                                Other
                            </button>
                        </div>

                        <input type="hidden" id="addrType" value="Home">

                        <div class="flex items-center gap-2 mt-4 ml-1">
                            <input type="checkbox" id="addrIsDefault"
                                class="w-5 h-5 accent-brand-500 rounded cursor-pointer">
                            <label for="addrIsDefault"
                                class="text-sm font-bold text-gray-500 cursor-pointer select-none">Set as
                                default address</label>
                        </div>

                        <div class="flex gap-3 pt-4">
                            <button type="button" onclick="closeAddressModal()"
                                class="flex-1 bg-gray-100 py-3 rounded-xl font-bold">
                                Cancel
                            </button>

                            <button type="submit" class="flex-1 bg-brand-500 text-white py-3 rounded-xl font-bold">
                                Save Address
                            </button>
                        </div>
                    </form>
                </div>
            </div>

</body>

<script>
    function openConfirmationModal() {
    <%if (stockIssues.length) {%>
            Swal.fire({
                icon: 'error',
                title: 'Stock issue',
                text: 'Please fix out-of-stock items before placing order.',
                confirmButtonColor: '#f43f5e'
            });
            return;
    <%}%>
    }
</script>

<script>
    const originalTotal = Number("<%= total.toFixed(2) %>");
    let currentDiscount = 0;

    // --- Data Initialization ---
    // Safe parse of addresses from server
    const allAddresses = <% - JSON.stringify(addresses || []) %>;
    let selectedAddressIndex = allAddresses.findIndex(a => a.isDefault);

    if (selectedAddressIndex === -1) {
        selectedAddressIndex = 0;
    }

    // --- DOM Elements ---
    const addressModal = document.getElementById("addressModal");
    const addressForm = document.getElementById("addressForm");
    // ===== Address Modal Elements (MISSING FIX) =====
    const titleEl = document.getElementById("addressModalTitle");

    const addrFullName = document.getElementById("addrFullName");
    const addrPhone = document.getElementById("addrPhone");
    const addrAddress = document.getElementById("addrAddress");
    const addrLandmark = document.getElementById("addrLandmark");
    const addrCity = document.getElementById("addrCity");
    const addrState = document.getElementById("addrState");
    const addrZip = document.getElementById("addrZip");
    const addrType = document.getElementById("addrType");

    const typeButtons = document.querySelectorAll(".addr-type-btn");

    const messageBox = document.getElementById("addressMessage");

    const selectAddressModal = document.getElementById("selectAddressModal");
    const selectedAddressContainer = document.getElementById("selectedAddressContainer");
    const addressListContainer = document.getElementById("addressListContainer");

    // --- Initialization ---
    // On load, render the initial state
    document.addEventListener("DOMContentLoaded", () => {
        renderSelectedAddress();
    });

    // --- Core Logic ---

    function renderSelectedAddress() {
        selectedAddressContainer.innerHTML = "";

        if (allAddresses.length === 0) return; // Handled by HTML fallback

        const addr = allAddresses[selectedAddressIndex];

        // Ensure hidden input for form submission
        // We look for an existing one or create it, but since we cleared innerHTML, we might need a persistent form Wrapper or append input here.
        // Actually, the payment form wraps everything? No, there is no main form wrapping the whole page. 
        // We need to ensure when "Place Order" is clicked, we know the address ID.
        // For now, let's assume we append the input here.

        const html = `
            <div class="p-6 rounded-3xl border-2 border-brand-500 bg-brand-50 transition-all relative group">
                <input type="hidden" name="addressId" value="${addr._id}">
                
                <div class="flex justify-between items-start mb-3">
                    <div class="flex items-center gap-3">
                        <span class="font-bold text-lg">${addr.fullName}</span>
                        <span class="bg-brand-100 text-brand-600 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wide">
                            ${addr.addressType || 'Home'}
                        </span>
                        ${addr.isDefault ? '<span class="bg-gray-200 text-gray-600 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wide">Default</span>' : ''}
                    </div>
                    
                    <% if (addresses && addresses.length > 1) { %>
                    <button onclick="openSelectAddressModal()" class="text-sm font-bold text-brand-500 hover:underline">
                        Change
                    </button>
                    <% } %>
                </div>

                <p class="text-gray-600 text-sm leading-relaxed mb-4">
                    ${addr.address}, ${addr.city}<br>
                    ${addr.state}, ${addr.zipCode}<br>
                    ${addr.phone}
                </p>

                <div class="flex gap-3 pt-2 border-t border-brand-200/50 mt-2">
                    <button onclick='openEditAddressModal("${encodeURIComponent(JSON.stringify(addr))}")'
                        class="flex-1 py-2 rounded-xl bg-white border border-gray-200 text-gray-600 font-bold text-sm hover:border-brand-500 hover:text-brand-500 transition">
                        Edit
                    </button>
                </div>
            </div>
        `;

        selectedAddressContainer.innerHTML = html;

        document.getElementById("checkoutForm")
            .querySelector("input[name='addressId']")?.remove();

        const hidden = document.createElement("input");
        hidden.type = "hidden";
        hidden.name = "addressId";
        hidden.value = addr._id;

        document.getElementById("checkoutForm").appendChild(hidden);
    }

    function renderAddressListModal() {
        addressListContainer.innerHTML = "";

        allAddresses.forEach((addr, index) => {
            const isSelected = index === selectedAddressIndex;
            const el = document.createElement("div");
            el.className = `p-4 rounded-2xl border-2 cursor-pointer transition flex items-center justify-between group ${isSelected ? 'border-brand-500 bg-brand-50' : 'border-gray-100 hover:border-brand-200'}`;
            el.onclick = () => selectAddress(index);

            el.innerHTML = `
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-bold ${isSelected ? 'text-brand-700' : 'text-gray-800'}">${addr.fullName}</span>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded uppercase ${isSelected ? 'bg-brand-200 text-brand-700' : 'bg-gray-100 text-gray-500'}">
                            ${addr.addressType}
                        </span>
                         ${addr.isDefault ? '<span class="bg-gray-200 text-gray-500 text-[10px] font-bold px-2 py-0.5 rounded uppercase">Default</span>' : ''}
                    </div>
                    <p class="text-xs text-gray-500 truncate max-w-[250px]">
                        ${addr.address}, ${addr.city}...
                    </p>
                </div>
                
                <div class="w-5 h-5 rounded-full border-2 ${isSelected ? 'border-brand-500 bg-brand-500' : 'border-gray-300'} flex items-center justify-center">
                    ${isSelected ? '<i class="fa-solid fa-check text-white text-xs"></i>' : ''}
                </div>
            `;
            addressListContainer.appendChild(el);
        });
    }

    function selectAddress(index) {
        selectedAddressIndex = index;
        renderSelectedAddress();
        closeSelectAddressModal();
    }

    // --- Modal Controls ---

    function openSelectAddressModal() {
        renderAddressListModal();
        selectAddressModal.classList.remove("hidden");
        selectAddressModal.classList.add("flex");
    }

    function closeSelectAddressModal() {
        selectAddressModal.classList.add("hidden");
        selectAddressModal.classList.remove("flex");
    }


    /* =========================================
       EXISTING ADDRESS FORM LOGIC (Refined)
       ========================================= */

    function showMsg(type, msg) {
        messageBox.className =
            `px-4 py-3 rounded-xl text-sm mb-4 font-medium ${type === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`;
        messageBox.innerText = msg;
        messageBox.classList.remove("hidden");

    }

    const addrTypeInput = document.getElementById("addrType");

    function openAddAddressModal() {
        addressForm.reset();
        document.getElementById("addressId").value = "";
        titleEl.innerText = "Add Address";
        messageBox.classList.add("hidden");

        addressModal.classList.remove("hidden");
        addressModal.classList.add("flex");
        document.body.style.overflow = "hidden";

        typeButtons.forEach(b =>
            b.classList.remove("bg-brand-500", "text-white", "border-brand-500")
        );

        typeButtons[0].classList.add("bg-brand-500", "text-white", "border-brand-500");
        addrTypeInput.value = "Home";
        document.getElementById("addrIsDefault").checked = false;

    }

    function openEditAddressModal(encodedAddr) {
        const addr = JSON.parse(decodeURIComponent(encodedAddr));

        titleEl.innerText = "Edit Address";
        messageBox.classList.add("hidden");

        document.getElementById("addressId").value = addr._id;
        document.getElementById("addrFullName").value = addr.fullName;
        document.getElementById("addrPhone").value = addr.phone;
        document.getElementById("addrAddress").value = addr.address;
        document.getElementById("addrLandmark").value = addr.landMark || "";
        document.getElementById("addrCity").value = addr.city;
        document.getElementById("addrState").value = addr.state;
        document.getElementById("addrZip").value = addr.zipCode;
        document.getElementById("addrType").value = addr.addressType || "Home";
        document.getElementById("addrIsDefault").checked = addr.isDefault || false;

        typeButtons.forEach(b => {
            b.classList.remove("bg-brand-500", "text-white", "border-brand-500");

            if (b.dataset.type === (addr.addressType || "Home")) {
                b.classList.add("bg-brand-500", "text-white", "border-brand-500");
                addrTypeInput.value = b.dataset.type;
            }
        });

        addressModal.classList.remove("hidden");
        addressModal.classList.add("flex");
        document.body.style.overflow = "hidden";
    }

    function closeAddressModal() {
        addressModal.classList.add("hidden");
        addressModal.classList.remove("flex");
        document.body.style.overflow = "auto";
    }

    addressForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("addressId").value;
        const data = {
            fullName: addrFullName.value.trim(),
            phone: addrPhone.value.trim(),
            address: addrAddress.value.trim(),
            landMark: addrLandmark.value.trim(),
            city: addrCity.value.trim(),
            state: addrState.value.trim(),
            zipCode: addrZip.value.trim(),
            addressType: addrType.value,
            isDefault: document.getElementById("addrIsDefault").checked
        };

        if (data.fullName.length < 3)
            return showMsg("error", "Name must be at least 3 characters");

        if (!/^\d{10}$/.test(data.phone))
            return showMsg("error", "Enter a valid 10-digit phone number");

        if (data.address.length < 10)
            return showMsg("error", "Address must be at least 10 characters");

        if (data.city.length < 2)
            return showMsg("error", "Enter a valid city name");

        if (data.state.length < 2)
            return showMsg("error", "Enter a valid state name");

        if (!/^\d{6}$/.test(data.zipCode))
            return showMsg("error", "Enter a valid 6-digit pincode");

        const url = id
            ? `/profile/address/${id}/edit`
            : `/address/add`;

        const method = id ? "PUT" : "POST";

        const res = await fetch(url, {
            method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
            showMsg("success", "Address saved successfully");
            setTimeout(() => {
                window.location.href = "/checkout";
            }, 700);
        }
    });

    typeButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            typeButtons.forEach(b =>
                b.classList.remove("bg-brand-500", "text-white", "border-brand-500")
            );

            btn.classList.add("bg-brand-500", "text-white", "border-brand-500");
            addrTypeInput.value = btn.dataset.type;
        });
    });

    async function applyCoupon() {
        const couponCode = document.getElementById("couponSelect").value;
        if (!couponCode) {
            Swal.fire({
                icon: 'warning',
                title: 'Oops...',
                text: 'Please select a coupon first!',
                confirmButtonColor: '#f43f5e'
            });
            return;
        }

        try {
            const response = await fetch('/checkout/apply-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ couponCode })
            });
            const data = await response.json();

            if (data.success) {
                // Update UI
                const couponRow = document.getElementById('couponRow');
                couponRow.style.display = 'flex';
                // couponRow.classList.remove('hidden'); // legacy
                // couponRow.classList.add('flex');      // legacy

                document.getElementById('couponCodeDisplay').innerText = `Coupon (${data.couponCode})`;
                document.getElementById('couponDiscountDisplay').innerText = `-₹${data.discount.toFixed(2)}`;

                // Update Total Logic
                currentDiscount = data.discount;
                const newTotal = originalTotal - currentDiscount;
                document.getElementById('totalAmountDisplay').innerText = `₹${newTotal.toFixed(2)}`;

                // Set Hidden Input
                document.getElementById('appliedCouponCode').value = data.couponCode;

                Swal.fire({
                    icon: 'success',
                    title: 'Coupon Applied!',
                    text: `You saved ₹${data.discount.toFixed(2)}`,
                    timer: 2000,
                    showConfirmButton: false
                });

            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Coupon',
                    text: data.message,
                    confirmButtonColor: '#f43f5e'
                });
            }

        } catch (error) {
            console.error('Error applying coupon:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Something went wrong. Please try again.',
                confirmButtonColor: '#f43f5e'
            });
        }
    }

    function removeCoupon() {
        // Hide coupon row
        const couponRow = document.getElementById('couponRow');
        couponRow.style.display = 'none';
        // couponRow.classList.add('hidden');
        // couponRow.classList.remove('flex');

        // Reset totals
        currentDiscount = 0;
        document.getElementById('totalAmountDisplay').innerText =
            `₹${originalTotal.toFixed(2)}`;

        // Clear coupon input (IMPORTANT)
        document.getElementById('appliedCouponCode').value = "";

        // Reset dropdown
        document.getElementById("couponSelect").value = "";

        Swal.fire({
            icon: 'info',
            title: 'Coupon Removed',
            text: 'The coupon has been removed successfully.',
            timer: 1500,
            showConfirmButton: false
        });
    }

    // --- Confirmation Modal Logic ---
    const orderConfirmationModal = document.getElementById("orderConfirmationModal");
    const confirmModalContent = document.getElementById("confirmModalContent");

    function openConfirmationModal() {
        // Validate Address
        const addressId = document.querySelector("input[name='addressId']");
        if (!addressId || !addressId.value) {
            Swal.fire({
                icon: 'warning',
                title: 'Address Required',
                text: 'Please select a delivery address.',
                confirmButtonColor: '#F59E0B'
            });
            return;
        }

        // Validate Payment Method
        // Radio buttons are outside form, so we grab them here
        const paymentRadio = document.querySelector("input[name='paymentDetails']:checked");
        const paymentValue = paymentRadio ? paymentRadio.value : "COD"; // Default to COD

        // Update Hidden Input in Form (Crucial for submission)
        const hiddenInput = document.getElementById("paymentDetailsInput");
        if (hiddenInput) {
            hiddenInput.value = paymentValue;
        }

        // Determine Display Text
        let paymentText = "Cash on Delivery";
        if (paymentValue === 'ONLINE') {
            paymentText = "Pay Online";
        } else if (paymentValue === 'WALLET') {
            paymentText = "Wallet";
        }

        // Dynamic Button Logic
        const confirmBtn = document.querySelector("#confirmModalContent button[onclick='submitOrder()']");
        const confirmBtnText = confirmBtn.querySelector("span");
        const confirmBtnIcon = confirmBtn.querySelector("i");

        // Visuals based on payment type
        if (paymentValue === 'COD') {
            confirmBtnText.innerText = "Place Order";
            confirmBtnIcon.className = "fa-solid fa-check";
        } else {
            confirmBtnText.innerText = "Confirm & Pay";
            confirmBtnIcon.className = "fa-solid fa-arrow-right";
        }

        const totalAmount = document.getElementById("totalAmountDisplay").innerText;

        // Get Address Text
        const addrContainer = document.getElementById("selectedAddressContainer").querySelector("p");
        const addressText = addrContainer ? addrContainer.innerText.replace(/\n/g, ", ") : "Selected Address";

        // Populate Modal
        document.getElementById("confirmPaymentMethod").innerText = paymentText;
        document.getElementById("confirmTotalAmount").innerText = totalAmount;
        document.getElementById("confirmAddress").innerText = addressText;

        // Show Modal
        orderConfirmationModal.classList.remove("hidden");
        orderConfirmationModal.classList.add("flex");

        // Animation
        setTimeout(() => {
            confirmModalContent.classList.remove("translate-y-full", "scale-95", "opacity-0");
        }, 10);
    }

    function closeConfirmationModal() {
        confirmModalContent.classList.add("translate-y-full", "scale-95", "opacity-0");
        setTimeout(() => {
            orderConfirmationModal.classList.add("hidden");
            orderConfirmationModal.classList.remove("flex");
        }, 300);
    }

    function submitOrder() {
        document.getElementById("checkoutForm").submit();
    }

    // Close modal on click outside
    orderConfirmationModal.addEventListener("click", (e) => {
        if (e.target === orderConfirmationModal) {
            closeConfirmationModal();
        }
    });

</script>

</html>