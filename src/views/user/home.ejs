<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop Our Collection | PawPalace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-accent-cream font-sans text-accent-navy antialiased min-h-screen">

    <%- include('../partials/header') %>

        <section class="bg-[#fff1f2] py-16 px-6 text-center">
            <span
                class="text-[10px] font-bold uppercase tracking-widest text-brand-500 bg-white px-3 py-1 rounded-full shadow-sm mb-4 inline-block">Premium
                Selection</span>
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Shop Our Collection</h1>
            <p class="text-gray-500 max-w-2xl mx-auto font-medium">Discover the happiest toys, tastiest treats, and
                coziest beds. Filter by category to find exactly what your furry friend needs.</p>
        </section>

        <main class="max-w-7xl mx-auto py-12 px-6">

            <div class="flex flex-col lg:flex-row gap-12">

                <!-- SIDEBAR FILTER FORM -->
                <aside class="w-full lg:w-64 space-y-8">

                    <form method="GET" action="/home" id="filterForm" onsubmit="return cleanFilterForm(this)">
                        <!-- Preserve Search & Sort & Price in Side Filters -->
                        <% Object.keys(query || {}).forEach(key=> {
                            if (
                            key !== 'page' &&
                            key !== 'category' &&
                            key !== 'minPrice' &&
                            key !== 'maxPrice' &&
                            !key.startsWith('petType')
                            ) {
                            if (Array.isArray(query[key])) {
                            query[key].forEach(val => { %>
                            <input type="hidden" name="<%= key %>" value="<%= val %>">
                            <% }) } else { %>
                                <input type="hidden" name="<%= key %>" value="<%= query[key] %>">
                                <% } } }); %>

                                    <!-- PET TYPE FILTER -->
                                    <div class="mb-8">
                                        <h3 class="font-bold mb-4 flex justify-between items-center">Pet Type <i
                                                aria-hidden="true" class="fa-solid fa-chevron-up text-[10px]"></i></h3>
                                        <div class="space-y-3">
                                            <% const petTypes=['Dogs', 'Cats' , 'Puppies' , 'Kittens' ]; %>

                                                <% petTypes.forEach(type=> {
                                                    const isChecked = Array.isArray(query.petType)
                                                    ? query.petType.includes(type)
                                                    : query.petType === type;
                                                    %>
                                                    <label class="flex items-center gap-3 cursor-pointer group">
                                                        <input type="checkbox" name="petType" value="<%= type %>"
                                                            onchange="this.form.submit()" <%=isChecked ? 'checked' : ''
                                                            %>
                                                        class="w-5 h-5 rounded border-gray-300 text-brand-500
                                                        accent-brand-500"
                                                        >
                                                        <span
                                                            class="<%= isChecked ? 'text-accent-navy' : 'text-gray-500' %> font-bold">
                                                            <%= type %>
                                                        </span>
                                                    </label>
                                                    <% }) %>
                                        </div>
                                    </div>

                                    <!-- CATEGORIES FILTER -->
                                    <div>
                                        <h3 class="font-bold mb-4 flex justify-between items-center">Categories <i
                                                aria-hidden="true" class="fa-solid fa-chevron-up text-[10px]"></i></h3>
                                        <div class="space-y-3">
                                            <label class="flex items-center gap-3 cursor-pointer group">
                                                <input type="radio" name="category" value=""
                                                    onchange="this.form.submit()" <%=!query.category ? 'checked' : '' %>
                                                class="w-5 h-5 rounded border-gray-300 text-brand-500
                                                focus:ring-brand-500 accent-brand-500">
                                                <span
                                                    class="text-sm font-bold text-gray-500 group-hover:text-accent-navy transition <%= !query.category ? 'text-accent-navy' : '' %>">
                                                    All Categories
                                                </span>
                                            </label>
                                            <% if (locals.categories) { %>
                                                <% categories.forEach(cat=> { %>
                                                    <label class="flex items-center gap-3 cursor-pointer group">
                                                        <input type="radio" name="category" value="<%= cat._id %>"
                                                            onchange="this.form.submit()"
                                                            <%=query.category===cat._id.toString() ? 'checked' : '' %>
                                                        class="w-5 h-5 rounded border-gray-300 text-brand-500
                                                        focus:ring-brand-500 accent-brand-500">
                                                        <span
                                                            class="text-sm font-bold text-gray-500 group-hover:text-accent-navy transition <%= query.category === cat._id.toString() ? 'text-accent-navy' : '' %>">
                                                            <%= cat.categoryName %>
                                                        </span>
                                                    </label>
                                                    <% }) %>
                                                        <% } %>
                                        </div>
                                    </div>
                                    <!-- PRICE RANGE FILTER -->
                                    <div class="mt-8">
                                        <h3 class="font-bold mb-4 flex justify-between items-center">
                                            Price Range
                                            <i class="fa-solid fa-chevron-up text-[10px]"></i>
                                        </h3>

                                        <div class="flex gap-2 items-center mb-3">
                                            <input type="number" name="minPrice" placeholder="Min ₹"
                                                value="<%= query.minPrice || '' %>"
                                                class="w-24 px-3 py-2 rounded-xl bg-white border border-gray-200 text-sm" />

                                            <input type="number" name="maxPrice" placeholder="Max ₹"
                                                value="<%= query.maxPrice || '' %>"
                                                class="w-24 px-3 py-2 rounded-xl bg-white border border-gray-200 text-sm" />
                                        </div>

                                        <div class="flex gap-2">
                                            <button type="submit"
                                                class="flex-1 bg-brand-500 text-white py-2 rounded-xl text-sm font-bold hover:bg-brand-600 transition">
                                                Apply
                                            </button>

                                            <% if (query.minPrice || query.maxPrice) { %>
                                                <a href="/home?<%= Object.keys(query)
          .filter(k => k !== 'minPrice' && k !== 'maxPrice')
          .map(k => {
            const v = query[k];
            if (Array.isArray(v)) {
              return v.map(val => `${k}=${encodeURIComponent(val)}`).join('&');
            }
            return `${k}=${encodeURIComponent(v)}`;
          })
          .join('&') %>" class="flex-1 text-center py-2 rounded-xl text-sm font-bold border border-gray-300 hover:bg-gray-50">
                                                    Clear
                                                </a>
                                                <% } %>
                                        </div>
                                    </div>
                    </form>

                </aside>


                <div class="flex-1">
                    <div class="flex items-center justify-between mb-8 gap-4 flex-wrap">

                        <!-- 🔍 SEARCH (LEFT SIDE) -->
                        <form method="GET" action="/home" class="relative w-full max-w-md"
                            onsubmit="return cleanFilterForm(this)">

                            <input type="text" name="search" value="<%= query.search || '' %>"
                                placeholder="Search products..."
                                class="w-full pl-12 pr-10 py-3 rounded-2xl bg-white shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />

                            <i
                                class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>

                            <% if (query.search) { %>
                                <a href="/home"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                    ✕
                                </a>
                                <% } %>

                                    <!-- Preserve filters -->
                                    <% Object.keys(query || {}).forEach(key=> {
                                        if (key !== 'search' && key !== 'page') {
                                        if (Array.isArray(query[key])) {
                                        query[key].forEach(val => { %>
                                        <input type="hidden" name="<%= key %>" value="<%= val %>">
                                        <% }) } else { %>
                                            <input type="hidden" name="<%= key %>" value="<%= query[key] %>">
                                            <% } } }); %>

                        </form>

                        <!-- SORT FORM -->
                        <form method="GET" action="/home" onsubmit="return cleanFilterForm(this)">
                            <% Object.keys(query || {}).forEach(key=> {
                                if (key !== 'sort' && key !== 'page') {
                                if (Array.isArray(query[key])) {
                                query[key].forEach(val => { %>
                                <input type="hidden" name="<%= key %>" value="<%= val %>">
                                <% }) } else { %>
                                    <input type="hidden" name="<%= key %>" value="<%= query[key] %>">
                                    <% } } }); %>

                                        <select name="sort" onchange="this.form.submit()"
                                            class="bg-white px-4 py-2 rounded-xl font-bold text-sm border border-gray-200 cursor-pointer">
                                            <option value="featured" <%=!query.sort || query.sort==='featured'
                                                ? 'selected' : '' %>>Featured</option>
                                            <option value="price_asc" <%=query.sort==='price_asc' ? 'selected' : '' %>
                                                >Price: Low → High</option>
                                            <option value="price_desc" <%=query.sort==='price_desc' ? 'selected' : '' %>
                                                >Price: High → Low</option>
                                            <option value="name_asc" <%=query.sort==='name_asc' ? 'selected' : '' %>
                                                >Name A → Z</option>
                                            <option value="name_desc" <%=query.sort==='name_desc' ? 'selected' : '' %>
                                                >Name Z → A</option>
                                        </select>
                        </form>
                    </div>


                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                        <% if (products.length> 0) { %>
                            <% products.forEach(product=> { %>
                                <div class="bg-white rounded-[2.5rem] p-4 shadow-sm hover:shadow-xl
                    transition-all duration-500 group relative flex flex-col">

                                    <div class="relative aspect-square rounded-[2rem] overflow-hidden mb-6 bg-gray-50">

                                        <!-- PRODUCT IMAGE -->
                                        <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover transition duration-700
       <%= !product.inStock ? 'blur-sm scale-105' : 'group-hover:scale-110' %>">

                                        <% if (!product.inStock) { %>
                                            <!-- DARK OVERLAY -->
                                            <div class="absolute inset-0 bg-black/10 flex items-center justify-center">
                                                <span
                                                    class="bg-black/70 text-white text-xs font-bold px-4 py-2 rounded-full">
                                                    Restocking Soon
                                                </span>
                                            </div>
                                            <% } else if (product.offerApplied) { %>
                                                <!-- OFFER BADGE -->
                                                <div
                                                    class="absolute top-3 left-3 bg-brand-500 text-white text-[10px] font-bold px-3 py-1 rounded-full shadow-lg z-10">
                                                    <% if(product.offerDiscountType==='percentage' ) { %>
                                                        <%= product.offerDiscountVal %>% OFF
                                                            <% } else { %>
                                                                ₹<%= product.offerDiscountVal %> OFF
                                                                    <% } %>
                                                </div>
                                                <% } %>

                                                    <!-- WISHLIST BUTTON (FIXED TOP-RIGHT) -->
                                                    <button
                                                        onclick="toggleWishlist('<%= product._id %>', '<%= product.variantId %>', this)"
                                                        class="absolute top-3 right-3 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-md z-20 hover:scale-110 transition-transform duration-300 group/btn">
                                                        <i
                                                            class="<%= product.inWishlist ? 'fa-solid text-brand-500' : 'fa-regular text-gray-400' %> fa-heart text-xl transition-colors duration-300"></i>
                                                    </button>

                                                    <% if (product.offerApplied) { %>
                                                        <!-- OFFER BADGE -->
                                                        <div
                                                            class="absolute top-3 left-3 bg-brand-500 text-white text-[10px] font-bold px-3 py-1 rounded-full shadow-lg z-10">
                                                            <% if(product.offerDiscountType==='percentage' ) { %>
                                                                <%= product.offerDiscountVal %>% OFF
                                                                    <% } else { %>
                                                                        ₹<%= product.offerDiscountVal %> OFF
                                                                            <% } %>
                                                        </div>
                                                        <% } %>

                                    </div>

                                    <!-- HOVER ACTIONS REMOVED (WISHLIST MOVED UP) -->

                                    <!-- CONTENT -->
                                    <div class="px-2 pb-2 flex flex-col flex-grow justify-between">
                                        <div>
                                            <div
                                                class="inline-flex items-center gap-1 bg-green-100 text-green-700 px-2 py-0.5 rounded-full text-xs font-bold mb-2">
                                                <i class="fa-solid fa-star text-yellow-400"></i>
                                                4.6
                                            </div>

                                            <a href="/product/<%= product._id %>">
                                                <h3
                                                    class="font-extrabold text-lg mb-2 hover:text-brand-500 transition line-clamp-2 min-h-[3rem]">
                                                    <%= product.name %>
                                                </h3>
                                            </a>
                                        </div>


                                        <!-- PRICE -->
                                        <div class="flex justify-between items-center mt-4">

                                            <% if (product.inStock) { %>
                                                <% if (product.offerApplied) { %>
                                                    <div class="flex flex-col items-start leading-none">
                                                        <span class="text-xl font-black text-brand-500">₹<%=
                                                                product.offerPrice %></span>
                                                        <span
                                                            class="text-xs text-gray-400 line-through font-bold mt-1">₹
                                                            <%= product.price %>
                                                        </span>
                                                    </div>
                                                    <% } else { %>
                                                        <span class="text-xl font-black">₹<%= product.price %></span>
                                                        <% } %>
                                                            <% } else { %>
                                                                <button
                                                                    class="w-full py-2 rounded-xl bg-gray-100 text-gray-600 font-bold text-sm cursor-not-allowed">
                                                                    Out of Stock
                                                                </button>
                                                                <% } %>

                                        </div>
                                    </div>

                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="col-span-full text-center py-20">
                                            <div class="text-6xl mb-4">😿</div>
                                            <h2 class="text-2xl font-bold text-gray-400">No products found</h2>
                                            <p class="text-gray-400">Try adjusting your filters</p>
                                            <a href="/home"
                                                class="inline-block mt-4 text-brand-500 font-bold hover:underline">Clear
                                                all filters</a>
                                        </div>
                                        <% } %>

                    </div>

                    <!-- PAGINATION -->
                    <% if (totalPages> 1) { %>
                        <div class="flex justify-center gap-2 mt-16 col-span-full w-full">

                            <% const qs=Object.keys(query || {}).filter(k=> k !== 'page')
                                .map(k => {
                                const v = query[k];
                                if (Array.isArray(v)) {
                                return v.map(val => `${k}=${encodeURIComponent(val)}`).join('&');
                                }
                                return `${k}=${encodeURIComponent(v)}`;
                                })
                                .join('&');
                                %>

                                <!-- PREV -->
                                <% if (currentPage> 1) { %>
                                    <a href="/home?page=<%= currentPage - 1 %>&<%= qs %>"
                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white hover:bg-gray-50 border border-gray-200 transition">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </a>
                                    <% } %>

                                        <% for (let i=1; i <=totalPages; i++) { %>
                                            <a href="/home?page=<%= i %>&<%= qs %>"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl font-bold transition
                                <%= currentPage === i ? 'bg-brand-500 text-white shadow-lg shadow-brand-500/30' : 'bg-white text-gray-600 hover:bg-gray-50 border border-gray-200' %>">
                                                <%= i %>
                                            </a>
                                            <% } %>

                                                <!-- NEXT -->
                                                <% if (currentPage < totalPages) { %>
                                                    <a href="/home?page=<%= currentPage + 1 %>&<%= qs %>"
                                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white hover:bg-gray-50 border border-gray-200 transition">
                                                        <i class="fa-solid fa-chevron-right"></i>
                                                    </a>
                                                    <% } %>
                        </div>
                        <% } %>

                </div>

            </div>
        </main>

        <%- include('../partials/footer') %>
            <script>
                async function toggleWishlist(productId, variantId, btn) {
                    try {
                        const response = await fetch('/wishlist/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId, variantId })
                        });

                        if (response.status === 401) {
                            window.location.href = '/login';
                            return;
                        }

                        const data = await response.json();

                        if (data.success) {
                            const icon = btn.querySelector('i');
                            // data.added is returned by the controller if it was added
                            // if data.removed is true, then it was removed
                            if (data.added) {
                                icon.classList.remove('fa-regular', 'text-gray-400');
                                icon.classList.add('fa-solid', 'text-brand-500');
                            } else {
                                icon.classList.remove('fa-solid', 'text-brand-500');
                                icon.classList.add('fa-regular', 'text-gray-400');
                            }

                            // Update Header Badge
                            if (data.wishlistCount !== undefined && window.updateWishlistCount) {
                                window.updateWishlistCount(data.wishlistCount);
                            }
                        } else {
                            console.error(data.message || 'Failed to toggle wishlist');
                        }

                    } catch (error) {
                        console.error(error);
                    }
                }

                function cleanFilterForm(form) {
                    Array.from(form.elements).forEach(el => {
                        if (el.name && !el.value && el.type !== 'radio' && el.type !== 'checkbox') {
                            el.disabled = true;
                        }
                        if (el.type === 'radio' && el.checked && !el.value) {
                            el.disabled = true;
                        }
                    });
                    return true;
                }
            </script>
</body>

</html>