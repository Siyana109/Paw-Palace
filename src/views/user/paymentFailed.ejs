<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Failed | PawPalace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-accent-cream font-sans text-accent-navy flex flex-col min-h-screen">

    <%- include('../partials/header') %>

        <main class="flex-grow flex items-center justify-center p-6">
            <div
                class="max-w-md w-full bg-white rounded-[2.5rem] p-8 md:p-12 text-center shadow-xl shadow-brand-500/5 border border-red-100">

                <div
                    class="w-24 h-24 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-6 text-red-500 animate-pulse">
                    <i class="fa-solid fa-circle-xmark text-5xl"></i>
                </div>

                <h1 class="text-3xl font-black mb-3 text-accent-navy">Payment Failed</h1>
                <p class="text-gray-500 font-medium mb-8 leading-relaxed">
                    Oops! Something went wrong with your transaction. Don't worry, no funds have been deducted from your
                    account.
                </p>

                <div class="space-y-4">
                    <a href="/checkout"
                        class="block w-full py-4 rounded-2xl bg-brand-500 text-white font-bold text-lg hover:bg-brand-600 transition shadow-lg shadow-brand-500/20">
                        Try Again
                    </a>

                    <a href="/cart"
                        class="block w-full py-4 rounded-2xl bg-gray-100 text-gray-600 font-bold hover:bg-gray-200 transition">
                        Return to Cart
                    </a>
                </div>

                <div class="mt-8 pt-6 border-t border-gray-100">
                    <p class="text-xs text-gray-400 font-bold">
                        Need help? <a href="/contact" class="text-brand-500 hover:underline">Contact Support</a>
                    </p>
                </div>
            </div>
        </main>

        <%- include('../partials/footer') %>

</body>

</html>