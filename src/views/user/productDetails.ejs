<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.productName %> | PawPalace
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Quicksand', 'sans-serif'],
                        display: ['Quicksand', 'sans-serif'] // Using Quicksand for display as well for now
                    },
                    colors: {
                        brand: { 500: '#ff4d6d', 50: '#fff0f3' }, // Slightly pinker red based on image
                        accent: {
                            navy: '#0f172a',
                            cream: '#fffdf9', // Warmer cream
                            teal: '#99f6e4', // Lighter teal for selection
                            tealText: '#0d9488'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        #zoomContainer:hover img {
            transform: scale(2);
            /* zoom level */
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="bg-accent-cream font-sans text-gray-700 antialiased min-h-screen flex flex-col">

    <%- include('../partials/header') %>

        <!-- BREADCRUMBS -->
        <nav class="py-6 px-6 md:px-12 max-w-7xl mx-auto w-full">
            <ol class="flex items-center gap-2 text-sm font-medium text-gray-400">

                <!-- Home -->
                <li>
                    <a href="/home" class="hover:text-brand-500 transition">
                        Home
                    </a>
                </li>

                <% if (product.categoryId && product.categoryId.name) { %>

                    <li class="text-gray-300">/</li>

                    <!-- Category -->
                    <li>
                        <a href="/home?category=<%= product.categoryId._id %>" class="hover:text-brand-500 transition">
                            <%= product.categoryId.name %>
                        </a>
                    </li>

                    <% } %>



                        <li class="text-gray-300">/</li>

                        <!-- Current Product -->
                        <li class="text-brand-500 font-semibold line-clamp-1 max-w-[220px]">
                            <%= product.productName %>
                        </li>

            </ol>
        </nav>

        <main class="flex-grow max-w-7xl mx-auto px-6 md:px-12 w-full pb-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

                <!-- LEFT COLUMN: IMAGES -->
                <div class="space-y-6 select-none relative animate-fade-in-up">
                    <!-- Main Image -->
                    <div id="zoomContainer"
                        class="relative w-full aspect-square bg-white rounded-[2rem] overflow-hidden group cursor-zoom-in shadow-xl shadow-gray-200/50 border border-gray-100">
                        <img id="mainImage" src="<%= defaultVariant.coverImage %>" alt="<%= product.productName %>"
                            class="w-full h-full object-cover transition-transform duration-300" />

                        <!-- Zoom Hint -->
                        <div
                            class="absolute top-4 right-4 bg-white/80 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-bold text-gray-500 opacity-0 group-hover:opacity-100 transition duration-300 pointer-events-none">
                            <i class="fa-solid fa-magnifying-glass-plus mr-1"></i> Hover to Zoom
                        </div>
                    </div>


                    <!-- Thumbnails -->
                    <div class="flex gap-4 justify-center md:justify-start" id="thumbnailContainer">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- RIGHT COLUMN: PRODUCT DETAILS -->
                <div class="flex flex-col pt-4 animate-fade-in-up delay-75">

                    <!-- Breadcrumb/Category Tag -->
                    <div class="mb-4">
                        <% if (product.categoryId) { %>
                            <a href="/home?category=<%= product.categoryId._id %>"
                                class="inline-block px-4 py-1.5 rounded-full bg-brand-50 text-brand-500 text-[11px] font-bold uppercase tracking-wider hover:bg-brand-100 transition">
                                <%= product.categoryId.categoryName || product.categoryId.name %>
                            </a>
                            <% } %>
                    </div>

                    <!-- Title -->
                    <h1 class="text-3xl md:text-5xl font-bold text-accent-navy mb-4 leading-tight tracking-tight">
                        <%= product.productName %>
                    </h1>

                    <!-- Price & Rating -->
                    <div class="flex items-center gap-6 mb-8 border-b border-gray-100 pb-8">
                        <div class="flex items-baseline gap-3">
                            <span id="priceDisplay"
                                class="text-4xl font-black <%= defaultVariant.offerApplied ? 'text-brand-500' : 'text-accent-navy' %>">
                                ₹<%= defaultVariant.offerApplied ? defaultVariant.offerPrice : defaultVariant.price %>
                            </span>
                            <span id="originalPriceDisplay"
                                class="text-xl text-gray-400 line-through decoration-2 font-medium <%= defaultVariant.offerApplied ? '' : 'hidden' %>">
                                ₹<%= defaultVariant.price %>
                            </span>
                        </div>

                        <!-- Rating -->
                        <% if (product.reviewCount> 0) { %>
                            <div
                                class="flex items-center gap-2 bg-yellow-50 px-3 py-1.5 rounded-lg border border-yellow-100">
                                <div class="flex text-yellow-400 text-xs">
                                    <% for(let i=1; i<=5; i++) { %>
                                        <% if (i <=Math.floor(product.averageRating)) { %>
                                            <i class="fa-solid fa-star"></i>
                                            <% } else if (i - 0.5 <=product.averageRating) { %>
                                                <i class="fa-solid fa-star-half-stroke"></i>
                                                <% } else { %>
                                                    <i class="fa-regular fa-star text-gray-300"></i>
                                                    <% } %>
                                                        <% } %>
                                </div>
                                <span class="text-xs font-bold text-yellow-700">
                                    <%= product.averageRating %> (<%= product.reviewCount %> reviews)
                                </span>
                            </div>
                            <% } else { %>
                                <div
                                    class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-100 bg-gray-50/50">
                                    <div class="flex text-gray-300 text-xs">
                                        <i class="fa-regular fa-star"></i>
                                        <i class="fa-regular fa-star"></i>
                                        <i class="fa-regular fa-star"></i>
                                        <i class="fa-regular fa-star"></i>
                                        <i class="fa-regular fa-star"></i>
                                    </div>
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">No
                                        reviews yet</span>
                                </div>
                                <% } %>
                    </div>

                    <!-- STOCK MESSAGE -->
                    <p id="stockMessage"
                        class="hidden mb-4 text-xs font-bold text-red-500 bg-red-50 inline-block px-3 py-1 rounded-lg self-start">
                        Only <span id="stockCount"></span> items left!
                    </p>


                    <!-- SELECTORS GRID -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                        <!-- SIZE -->
                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="text-sm font-bold text-gray-900">Select Size</label>
                            </div>
                            <div class="flex flex-wrap gap-3" id="sizeSelectors">
                                <!-- Populated by JS -->
                            </div>
                        </div>

                        <!-- COLOR -->
                        <div>
                            <label class="block text-sm font-bold text-gray-900 mb-3">Select Color</label>
                            <div class="flex flex-wrap gap-3" id="colorSelectors">
                                <!-- Populated by JS -->
                            </div>
                        </div>
                    </div>

                    <!-- ACTIONS ROW -->
                    <div
                        class="mt-auto bg-white border border-gray-100 rounded-[1.5rem] p-4 shadow-xl shadow-gray-100/50">
                        <form id="addToCartForm" class="flex flex-col md:flex-row gap-4">
                            <input type="hidden" name="productId" value="<%= product._id %>">
                            <input type="hidden" name="variantId" id="cartVariantId" value="<%= defaultVariant._id %>">
                            <input type="hidden" name="quantity" id="formQuantity" value="1">

                            <!-- QUANTITY -->
                            <div id="quantityWrapper"
                                class="flex items-center justify-between bg-gray-50 rounded-xl px-4 h-14 w-full md:w-40 border border-gray-200">
                                <button type="button" onclick="updateQuantity(-1)"
                                    class="text-gray-400 hover:text-accent-navy transition font-black text-lg p-2">-</button>
                                <input type="number" id="quantityInput" value="1" min="1"
                                    class="w-12 text-center font-bold text-accent-navy bg-transparent outline-none"
                                    readonly>
                                <button type="button" id="qtyPlusBtn" onclick="updateQuantity(1)"
                                    class="text-gray-400 hover:text-accent-navy transition font-black text-lg p-2">+</button>
                            </div>

                            <% if (!hasStock) { %>

                                <button disabled
                                    class="w-full h-12 bg-gray-300 text-gray-500 rounded-xl font-bold cursor-not-allowed">
                                    Out of Stock
                                </button>

                                <% } else { %>

                                    <div class="flex-1 flex gap-3">

                                        <button type="submit" id="addToCartBtn"
                                            class="flex-1 h-12 bg-brand-500 text-white rounded-xl font-bold hover:bg-brand-600 transition shadow-lg shadow-brand-500/30">
                                            Add to Cart
                                        </button>

                                        <button type="button" onclick="buyNow()"
                                            class="flex-1 h-12 bg-accent-navy text-white rounded-xl font-bold hover:bg-black transition shadow-lg shadow-accent-navy/30">
                                            Buy Now
                                        </button>

                                    </div>

                                    <% } %>

                                        <!-- WISHLIST -->
                                        <button type="button" id="wishlistBtn" data-variant="<%= defaultVariant._id %>"
                                            class="h-14 w-14 rounded-xl border-2 flex items-center justify-center transition
                                <%= inWishlist ? 'border-red-100 bg-red-50 text-brand-500' : 'border-gray-100 hover:border-gray-200 text-gray-400 hover:text-gray-600' %>">
                                            <i id="wishlistIcon"
                                                class="<%= inWishlist ? 'fa-solid' : 'fa-regular' %> fa-heart text-xl"></i>
                                        </button>

                        </form>
                    </div>

                    <!-- Delivery Promises -->
                    <div class="grid grid-cols-2 gap-4 mt-8 pt-6 border-t border-gray-100">
                        <div class="flex items-center gap-3 text-sm font-medium text-gray-500">
                            <div
                                class="w-10 h-10 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center">
                                <i class="fa-solid fa-truck-fast"></i>
                            </div>
                            <div>
                                <p class="text-accent-navy font-bold">Free Delivery</p>
                                <p class="text-[10px] text-gray-400">On orders over ₹999</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 text-sm font-medium text-gray-500">
                            <div
                                class="w-10 h-10 rounded-full bg-purple-50 text-purple-500 flex items-center justify-center">
                                <i class="fa-solid fa-rotate-left"></i>
                            </div>
                            <div>
                                <p class="text-accent-navy font-bold">Easy Returns</p>
                                <p class="text-[10px] text-gray-400">10-day replacement policy</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- TABS SECTION -->
            <div class="mt-8 max-w-4xl mx-auto">
                <div class="flex justify-center gap-12 mb-8 border-b border-gray-100 relative">
                    <button onclick="switchTab('description')" id="tab-description"
                        class="pb-4 text-sm font-bold text-brand-500 border-b-2 border-brand-500 transition-all">
                        Description
                    </button>
                    <button onclick="switchTab('reviews')" id="tab-reviews"
                        class="pb-4 text-sm font-medium text-gray-400 border-b-2 border-transparent hover:text-gray-600 transition-all">
                        Reviews
                    </button>
                </div>

                <!-- Description Content -->
                <div id="content-description"
                    class="text-center max-w-2xl mx-auto text-sm leading-relaxed text-gray-500 space-y-4 animate-fade-in">
                    <!-- <p>Designed for the ultimate napper, the <%= product.productName %> provides a safe haven for your
                            pet. The raised rim creates a sense of security and provides head and neck support, while
                            the super-soft filling offers joint and muscle pain relief.</p>
                    <p>Perfect for pets who love to curl up! The deep crevices allow your pet to burrow, and the
                        synthetic faux fur mimics the comfort of a mother's fur coat.</p> -->
                    <ul class="list-disc list-inside pt-4 space-y-2 text-gray-400">
                        <%= product.description %>
                            <!-- Fallback descriptive bullets if description is short -->
                            <!-- <li>Machine washable and dryer safe</li>
                            <li>Water-resistant and dirt-resistant bottom</li>
                            <li>Available in natural colors to seamlessly blend with decor</li> -->
                    </ul>
                </div>

            </div>


            <!-- Reviews Content (Hidden) -->
            <div id="content-reviews" class="hidden max-w-3xl mx-auto py-10">
                <div id="reviews-loader" class="flex justify-center py-10">
                    <div class="w-8 h-8 border-4 border-brand-500/20 border-t-brand-500 rounded-full animate-spin">
                    </div>
                </div>
                <div id="reviews-list" class="space-y-8">
                    <!-- Reviews will be loaded here -->
                </div>

                <!-- Load More Button -->
                <div id="reviews-pagination" class="mt-12 text-center hidden">
                    <button onclick="loadMoreReviews()"
                        class="px-8 py-3 bg-white border-2 border-brand-500 text-brand-500 font-bold rounded-2xl hover:bg-brand-500 hover:text-white transition-all shadow-lg shadow-brand-500/10">
                        Load More Reviews
                    </button>
                </div>
            </div>


            <!-- RELATED PRODUCTS -->
            <section class="mt-24">
                <h2 class="text-xl font-bold text-accent-navy mb-8">You might also like</h2>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    <% relatedProducts.forEach(item=> { %>
                        <% if (item.variant) { %>
                            <a href="/product/<%= item.product._id %>"
                                class="group block bg-white rounded-3xl p-3 shadow-sm hover:shadow-lg transition-all duration-300">

                                <div class="aspect-[4/3] rounded-2xl bg-gray-100 overflow-hidden mb-3">
                                    <img src="<%= item.variant.coverImage %>"
                                        class="w-full h-full object-cover group-hover:scale-105 transition">
                                </div>

                                <div class="px-1">
                                    <p class="text-xs uppercase text-brand-500 font-bold mb-1">
                                        <%= item.product.petType %>
                                    </p>

                                    <h3 class="font-bold text-gray-800 text-sm line-clamp-1 mb-2
              group-hover:text-brand-500 transition">
                                        <%= item.product.productName %>
                                    </h3>

                                    <span class="font-bold text-sm text-brand-500">
                                        ₹<%= item.variant.offerApplied ? item.variant.offerPrice : item.variant.price %>
                                    </span>
                                </div>

                            </a>
                            <% } %>
                                <% }) %>
                </div>
            </section>


        </main>

        <%- include('../partials/footer') %>

            <!-- CLIENT SIDE LOGIC -->
            <script>
                const isLoggedIn = <%= !!locals.user %>;
                const variants = <%- JSON.stringify(variants) %>;
                let activeVariant = <%- JSON.stringify(defaultVariant) %>;

                // Color Mapping Helper
                const colorMap = {
                    'White': '#ffffff',
                    'Black': '#1a1a1a',
                    'Red': '#ef4444',
                    'Blue': '#3b82f6',
                    'Green': '#22c55e',
                    'Yellow': '#eab308',
                    'Grey': '#9ca3af',
                    'Gray': '#9ca3af',
                    'Pink': '#f472b6',
                    'Brown': '#78350f',
                    'Beige': '#e5e5e5', // Used lighter beige
                    'Cream': '#fef3c7',
                    'Purple': '#a855f7',
                    'Navy': '#1e3a8a'
                };

                const cartVariantIds = <%- JSON.stringify(cartVariantIds || []) %>;
                let wishlistVariantIds = <%- JSON.stringify(wishlistVariantIds || []) %>;

                function getHexColor(colorName) {
                    return colorMap[colorName] || colorName; // Fallback to name if hex not found or is already hex
                }

                function initSelectors() {
                    if (!variants.length) return;

                    const sizes = [...new Set(variants.map(v => v.size).filter(Boolean))];
                    const colors = [...new Set(variants.map(v => v.color).filter(Boolean))];

                    renderSizeSelectors(sizes);
                    renderColorSelectors(colors);

                    // Auto-select the default variant initially as requested
                    if (variants.length > 0) {
                        const defaultId = (activeVariant && activeVariant._id) ? activeVariant._id : variants[0]._id;
                        selectVariant(defaultId);
                    }
                }


                function renderSizeSelectors(sizes) {
                    const container = document.getElementById('sizeSelectors');
                    container.innerHTML = sizes.map(size => `
                <button type="button" onclick="filterVariant('size', '${size}')" 
                    id="size-btn-${size}"
                    class="h-10 px-6 rounded-lg border font-bold text-sm transition-all shadow-sm
                           bg-white text-gray-500 border-gray-200 hover:border-gray-300">
                    ${size}
                </button>
            `).join('');
                }

                function renderColorSelectors(colors) {
                    const container = document.getElementById('colorSelectors');
                    container.innerHTML = colors.map(color => `
                <button type="button" onclick="filterVariant('color', '${color}')" 
                    id="color-btn-${color}"
                    class="w-10 h-10 rounded-full border border-gray-100 shadow-sm transition-transform hover:scale-110 focus:ring-4 focus:ring-gray-100 relative items-center justify-center flex"
                    style="background-color: ${getHexColor(color)}"
                    title="${color}">
                    <!-- Checkmark for active state (hidden by default) -->
                    <i class="fa-solid fa-check text-white text-xs drop-shadow-md hidden" id="color-icon-${color}"></i>
                </button>
            `).join('');
                }

                // Logic to find best match or specific variant
                function filterVariant(type, value) {
                    let targetSize = activeVariant?.size || '';
                    let targetColor = activeVariant?.color || '';

                    if (type === 'size') targetSize = value;
                    if (type === 'color') targetColor = value;

                    let match = variants.find(v => (v.size == targetSize || !v.size) && (v.color == targetColor || !v.color));

                    if (!match) {
                        // Fallback
                        match = variants.find(v => type === 'size' ? v.size === value : v.color === value);
                    }

                    if (match) {
                        selectVariant(match._id);
                    }
                }

                function updateCartButton(variantId) {
                    const btn = document.getElementById("addToCartBtn");
                    if (!btn || !activeVariant) return;

                    // 🚨 If out of stock, do not allow cart state change
                    if (activeVariant.stock === 0) {
                        btn.innerText = "Out of Stock";
                        btn.disabled = true;

                        btn.classList.remove('bg-brand-500', 'hover:bg-brand-600', 'bg-gray-900', 'hover:bg-black');
                        btn.classList.add('bg-gray-300', 'text-gray-500', 'cursor-not-allowed');

                        btn.dataset.state = "oos";
                        return;
                    }

                    // Normal cart logic
                    if (cartVariantIds.includes(variantId)) {
                        btn.innerText = "Go to Cart";

                        btn.classList.remove('bg-brand-500', 'hover:bg-brand-600');
                        btn.classList.add('bg-gray-900', 'hover:bg-black', 'text-white');

                        btn.dataset.state = "go";
                    } else {
                        btn.innerText = "Add to Cart";

                        btn.classList.remove('bg-gray-900', 'hover:bg-black');
                        btn.classList.add('bg-brand-500', 'hover:bg-brand-600', 'text-white');

                        btn.dataset.state = "add";
                    }
                }

                function selectVariant(id) {
                    activeVariant = variants.find(v => v._id === id);
                    if (!activeVariant) return;

                    document.getElementById('cartVariantId').value = activeVariant._id;
                    document.getElementById('wishlistBtn').dataset.variant = activeVariant._id;

                    // THEN UI updates
                    updatePrice(activeVariant);
                    updateImages(activeVariant);
                    updateCartButton(activeVariant._id);
                    updateStock(activeVariant);

                    // Reset Quantity
                    document.getElementById('quantityInput').value = 1;
                    document.getElementById('formQuantity').value = 1;
                    updateQuantity(0); // Trigger button state update

                    // Update styling for selectors
                    document.querySelectorAll('#sizeSelectors button').forEach(btn => {
                        btn.className = 'h-10 px-6 rounded-lg border font-bold text-sm transition-all shadow-sm bg-white text-gray-500 border-gray-200 hover:border-gray-300';
                    });
                    const activeSizeBtn = document.getElementById(`size-btn-${activeVariant.size}`);
                    if (activeSizeBtn) {
                        activeSizeBtn.className = 'h-10 px-6 rounded-lg border font-bold text-sm transition-all shadow-sm bg-teal-50 text-accent-teal border-accent-teal';
                    }

                    // Update color checkmarks
                    document.querySelectorAll('#colorSelectors i').forEach(icon => icon.classList.add('hidden'));
                    const activeColorIcon = document.getElementById(`color-icon-${activeVariant.color}`);
                    if (activeColorIcon) {
                        activeColorIcon.classList.remove('hidden');

                    }
                    
                    // Update Wishlist Icon State
                    const icon = document.getElementById("wishlistIcon");
                    const wishlistBtn = document.getElementById("wishlistBtn");
                    if (icon && wishlistBtn) {
                        if (wishlistVariantIds.includes(activeVariant._id)) {
                            icon.classList.remove("fa-regular", "text-gray-400");
                            icon.classList.add("fa-solid", "text-brand-500");
                            wishlistBtn.classList.add("border-brand-500");
                        } else {
                            icon.classList.remove("fa-solid", "text-brand-500");
                            icon.classList.add("fa-regular", "text-gray-400");
                            wishlistBtn.classList.remove("border-brand-500");
                        }
                    }
                }



                function updatePrice(variant) {
                    const priceEl = document.getElementById('priceDisplay');
                    const origPriceEl = document.getElementById('originalPriceDisplay');

                    if (variant.offerApplied) {
                        priceEl.innerText = '₹' + variant.offerPrice;
                        priceEl.classList.remove('text-accent-navy');
                        priceEl.classList.add('text-brand-500');

                        origPriceEl.innerText = '₹' + variant.price;
                        origPriceEl.classList.remove('hidden');
                    } else {
                        priceEl.innerText = '₹' + variant.price;
                        priceEl.classList.remove('text-brand-500');
                        priceEl.classList.add('text-accent-navy');

                        origPriceEl.classList.add('hidden');
                    }
                }

                function updateImages(variant) {
                    // Update Main
                    const mainImg = document.getElementById('mainImage');

                    // Fade out effect properly
                    mainImg.style.opacity = '0.5';
                    setTimeout(() => {
                        mainImg.src = variant.coverImage;
                        mainImg.style.opacity = '1';
                    }, 200);

                    // Update Thumbnails
                    const container = document.getElementById('thumbnailContainer');
                    const images = [variant.coverImage, ...(variant.subImages || [])];

                    container.innerHTML = images.map((src, idx) => `
                <button onclick="changeMainImage('${src}', this)" 
                        class="w-16 h-16 md:w-20 md:h-20 rounded-xl overflow-hidden border-2 transition-all p-0.5
                        ${idx === 0 ? 'border-brand-500 shadow-md scale-105' : 'border-gray-100 hover:border-gray-300 bg-white'}">
                    <img src="${src}" class="w-full h-full object-cover rounded-lg">
                </button>
            `).join('');
                }

                function changeMainImage(src, btn) {
                    const main = document.getElementById('mainImage');
                    main.style.opacity = '0.8';
                    main.src = src;
                    main.onload = () => main.style.opacity = '1';

                    // Update Active Thumb Border
                    document.querySelectorAll('#thumbnailContainer button').forEach(b => {
                        b.className = 'w-16 h-16 md:w-20 md:h-20 rounded-xl overflow-hidden border-2 transition-all p-0.5 border-gray-100 hover:border-gray-300 bg-white';
                    });
                    btn.className = 'w-16 h-16 md:w-20 md:h-20 rounded-xl overflow-hidden border-2 transition-all p-0.5 border-brand-500 shadow-md scale-105';
                }

                function updateStock(variant) {
                    const btn = document.getElementById('addToCartBtn');
                    const qtyWrapper = document.getElementById('quantityWrapper');
                    const stockMsg = document.getElementById('stockMessage');
                    const stockCount = document.getElementById('stockCount');

                    if (variant.stock > 0) {

                        qtyWrapper.classList.remove('opacity-50', 'pointer-events-none');

                        if (btn) {
                            btn.disabled = false;

                            // ✅ Check if variant already in cart
                            if (cartVariantIds.includes(variant._id)) {

                                btn.innerText = "Go to Cart";
                                btn.dataset.state = "go";

                                btn.classList.remove('bg-brand-500', 'hover:bg-brand-600');
                                btn.classList.add('bg-gray-900', 'hover:bg-black', 'text-white');

                            } else {

                                btn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> Add to Cart';
                                btn.dataset.state = "add";

                                btn.classList.remove('bg-gray-200', 'text-gray-400', 'cursor-not-allowed');
                                btn.classList.add('bg-brand-500', 'text-white', 'hover:bg-brand-600');

                            }
                        }

                        stockMsg.classList.add('hidden');

                    } else {

                        qtyWrapper.classList.add('opacity-50', 'pointer-events-none');

                        if (btn) {
                            btn.disabled = true;
                            btn.innerHTML = 'Out of Stock';
                            btn.dataset.state = "oos";

                            btn.classList.add('bg-gray-200', 'text-gray-400', 'cursor-not-allowed');
                            btn.classList.remove('bg-brand-500', 'text-white', 'hover:bg-brand-600');
                        }

                        stockMsg.classList.add('hidden');
                    }

                    // Low stock warning
                    if (variant.stock > 0 && variant.stock < 5) {
                        stockMsg.classList.remove('hidden');
                        stockCount.innerText = variant.stock;
                    } else {
                        stockMsg.classList.add('hidden');
                    }
                }

                function updateQuantity(change) {
                    if (!activeVariant || activeVariant.stock === 0) return;

                    const input = document.getElementById('quantityInput');
                    const formInput = document.getElementById('formQuantity');
                    const stockMsg = document.getElementById('stockMessage');
                    const stockCount = document.getElementById('stockCount');
                    const plusBtn = document.getElementById('qtyPlusBtn');

                    let val = parseInt(input.value) + change;
                    const maxStock = Math.min(activeVariant.stock, 10); // Limit to 10 or stock

                    // Helper to update button states
                    const updateButtons = (currentVal) => {
                        // Disable + if we reached limit
                        if (currentVal >= maxStock) {
                            plusBtn.classList.add('text-gray-300', 'cursor-not-allowed');
                            plusBtn.disabled = true;
                        } else {
                            plusBtn.classList.remove('text-gray-300', 'cursor-not-allowed');
                            plusBtn.disabled = false;
                        }
                    };

                    if (val < 1) val = 1;
                    if (val > maxStock) val = maxStock;

                    // Update UI
                    input.value = val;
                    formInput.value = val;
                    updateButtons(val);

                    // Show messages
                    if (activeVariant.stock < 10 && val >= activeVariant.stock) {
                        // Near stock limit
                        stockCount.innerText = activeVariant.stock;
                        stockMsg.innerHTML = `Only <span id="stockCount">${activeVariant.stock}</span> items left!`;
                        stockMsg.classList.remove('hidden');
                    } else if (val === 10 && activeVariant.stock >= 10) {
                        // Hit max per order limit
                        stockMsg.innerHTML = "Maximum limit is 10 items";
                        stockMsg.classList.remove('hidden');
                    } else {
                        stockMsg.classList.add('hidden');
                    }
                }


                function switchTab(tab) {
                    // Buttons
                    document.getElementById('tab-description').className = tab === 'description'
                        ? 'pb-4 text-sm font-bold text-brand-500 border-b-2 border-brand-500 transition-all'
                        : 'pb-4 text-sm font-medium text-gray-400 border-b-2 border-transparent hover:text-gray-600 transition-all';

                    document.getElementById('tab-reviews').className = tab === 'reviews'
                        ? 'pb-4 text-sm font-bold text-brand-500 border-b-2 border-brand-500 transition-all'
                        : 'pb-4 text-sm font-medium text-gray-400 border-b-2 border-transparent hover:text-gray-600 transition-all';

                    // Content
                    document.getElementById('content-description').className = tab === 'description' ? 'text-center max-w-2xl mx-auto text-sm leading-relaxed text-gray-500 space-y-4 animate-fade-in' : 'hidden';
                    document.getElementById('content-reviews').className = tab === 'reviews' ? 'max-w-3xl mx-auto py-10 animate-fade-in' : 'hidden';

                    if (tab === 'reviews') {
                        loadReviews();
                    }
                }

                let currentReviewPage = 1;
                const reviewsPerPage = 5;
                const currentUserId = '<%= locals.user ? locals.user.id || locals.user._id : "" %>';

                async function loadReviews(page = 1, append = false) {
                    const loader = document.getElementById('reviews-loader');
                    const reviewsList = document.getElementById('reviews-list');
                    const paginationContainer = document.getElementById('reviews-pagination');
                    const productId = '<%= product._id %>';

                    if (!append) {
                        loader.classList.remove('hidden');
                        reviewsList.innerHTML = '';
                        currentReviewPage = 1;
                    }

                    try {
                        const response = await fetch(`/reviews/${productId}?page=${page}&limit=${reviewsPerPage}`);
                        const data = await response.json();

                        if (!data.success) throw new Error(data.message);

                        loader.classList.add('hidden');

                        if (data.reviews.length === 0 && !append) {
                            reviewsList.innerHTML = `
                                <div class="text-center py-12">
                                    <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <i class="fa-regular fa-comment-dots text-gray-300 text-2xl"></i>
                                    </div>
                                    <p class="text-gray-500 font-medium">No reviews yet. Be the first to review!</p>
                                </div>`;
                            paginationContainer.classList.add('hidden');
                            return;
                        }

                        const reviewsHtml = data.reviews.map(review => `
                            <div class="bg-gray-50/50 rounded-3xl p-6 sm:p-8 border border-gray-100 transition-hover hover:border-brand-500/20">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-sm border border-gray-100">
                                            <span class="text-brand-500 font-bold">${(review.userId?.fullName || 'U').charAt(0)}</span>
                                        </div>
                                        <div>
                                            <h4 class="font-bold text-accent-navy text-sm">${review.userId?.fullName || 'Anonymous Pet Parent'}</h4>
                                            <div class="flex items-center gap-2 mt-0.5">
                                                <div class="flex text-amber-400 text-[10px]">
                                                    ${Array.from({ length: 5 }, (_, i) => `
                                                        <i class="fa-${i < review.rating ? 'solid' : 'regular'} fa-star"></i>
                                                    `).join('')}
                                                </div>
                                                <span class="text-[10px] text-gray-400 font-medium uppercase tracking-widest">• ${new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                                                ${review.userId?._id === currentUserId ? `
                                                    <span class="text-[10px] text-gray-300 mx-2">|</span>
                                                    <button onclick="deleteReview('${review._id}')" class="text-[10px] font-bold text-rose-500 hover:text-rose-600 transition-colors uppercase tracking-widest">
                                                        <i class="fa-solid fa-trash-can mr-1"></i> Delete
                                                    </button>
                                                ` : ''}
                                            </div>
                                        </div>
                                    </div>
                                    ${review.variantId ? `
                                        <div class="inline-flex items-center px-3 py-1 rounded-full bg-white border border-gray-100 text-[9px] font-bold text-gray-400 uppercase tracking-widest shadow-sm">
                                            ${review.variantId.size ? `Size: ${review.variantId.size}` : ''} 
                                            ${review.variantId.size && review.variantId.color ? ' • ' : ''}
                                            ${review.variantId.color ? `Color: ${review.variantId.color}` : ''}
                                        </div>
                                    ` : ''}
                                </div>
                                <p class="text-gray-600 leading-relaxed text-sm italic">"${review.comment || 'No comment provided.'}"</p>
                            </div>
                        `).join('');

                        if (append) {
                            reviewsList.insertAdjacentHTML('beforeend', reviewsHtml);
                        } else {
                            reviewsList.innerHTML = reviewsHtml;
                        }

                        // Handle "Load More" visibility
                        if (data.pagination.hasNextPage) {
                            paginationContainer.classList.remove('hidden');
                        } else {
                            paginationContainer.classList.add('hidden');
                        }

                        currentReviewPage = data.pagination.currentPage;

                    } catch (error) {
                        console.error('Load Reviews Error:', error);
                        loader.classList.add('hidden');
                        reviewsList.innerHTML = `<p class="text-red-500 text-center py-8">Failed to load reviews.</p>`;
                    }
                }

                function loadMoreReviews() {
                    loadReviews(currentReviewPage + 1, true);
                }

                async function deleteReview(reviewId) {
                    const result = await Swal.fire({
                        title: 'Delete Review?',
                        text: "This action cannot be undone.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ff4d6d',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, delete it!'
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/reviews/${reviewId}`, {
                                method: 'DELETE',
                                headers: { 'Content-Type': 'application/json' }
                            });
                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: data.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                loadReviews(1, false); // Reload reviews
                            } else {
                                Swal.fire('Error', data.message || 'Failed to delete review', 'error');
                            }
                        } catch (error) {
                            console.error('Delete Review Error:', error);
                            Swal.fire('Error', 'Something went wrong', 'error');
                        }
                    }
                }

                // Init
                document.addEventListener('DOMContentLoaded', initSelectors);
            </script>

            <script>

                document.getElementById("wishlistBtn").addEventListener("click", async () => {
                    if (!isLoggedIn) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Login Required',
                            text: 'Please login to add items to wishlist',
                            confirmButtonText: 'Login',
                            confirmButtonColor: '#ff4d6d'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/login';
                            }
                        });
                        return;
                    }

                    const btn = document.getElementById("wishlistBtn");
                    const variantId = btn.dataset.variant;

                    if (!variantId) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Select Variant',
                            text: 'Please select a size/color before adding to wishlist',
                            confirmButtonColor: '#3b82f6'
                        });
                        return;
                    }

                    const icon = document.getElementById("wishlistIcon");
                    const productId = "<%= product._id %>";

                    try {
                        const res = await fetch("/wishlist/add", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ productId, variantId })
                        });

                        const data = await res.json();

                        // Not logged in → redirect to login
                        if (res.status === 401) {
                            window.location.href = '/login';
                            return;
                        }

                        // Product/variant inactive → show error, do not add
                        if (!data.success) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Cannot Add to Wishlist',
                                text: data.message || 'This product is no longer available.',
                                confirmButtonColor: '#ff4d6d',
                                customClass: {
                                    popup: 'rounded-2xl font-sans',
                                    confirmButton: 'rounded-xl font-bold'
                                }
                            }).then(() => {
                                if (data.reason === 'product') {
                                    window.location.href = data.redirect || '/home';
                                } else if (data.reason === 'variant') {
                                    location.reload();
                                }
                            });
                            return;
                        }

                        // 🤍 → ❤️ Added
                        if (data.added) {
                            if (!wishlistVariantIds.includes(variantId)) wishlistVariantIds.push(variantId);
                            icon.classList.remove("fa-regular", "text-gray-400");
                            icon.classList.add("fa-solid", "text-brand-500");
                            btn.classList.add("border-brand-500");
                        }

                        // ❤️ → 🤍 Removed
                        if (data.removed) {
                            wishlistVariantIds = wishlistVariantIds.filter(id => id !== variantId);
                            icon.classList.remove("fa-solid", "text-brand-500");
                            icon.classList.add("fa-regular", "text-gray-400");
                            btn.classList.remove("border-brand-500");
                        }

                        // Update Badge
                        if (typeof window.updateWishlistCount === 'function' && data.wishlistCount !== undefined) {
                            window.updateWishlistCount(data.wishlistCount);
                        }

                    } catch (err) {
                        console.error("Wishlist toggle error:", err);
                    }
                });







                // Dead code removed - specific handlers added above and below

            </script>

            <script>
                document.getElementById('addToCartForm').addEventListener('submit', async (e) => {
                    e.preventDefault();

                    if (!isLoggedIn) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Login Required',
                            text: 'Please login to add items to cart',
                            confirmButtonText: 'Login',
                            confirmButtonColor: '#ff4d6d'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/login';
                            }
                        });
                        return;
                    }

                    const variantId = document.getElementById('cartVariantId').value;
                    if (!variantId) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Select Variant',
                            text: 'Please select a size and color before adding to cart',
                            confirmButtonColor: '#3b82f6'
                        });
                        return;
                    }

                    const btn = document.getElementById('addToCartBtn');

                    // If already converted → go to cart
                    if (btn.dataset.state === 'go') {
                        window.location.href = '/cart';
                        return;
                    }

                    const payload = {
                        productId: "<%= product._id %>",
                        variantId: document.getElementById('cartVariantId').value,
                        quantity: document.getElementById('formQuantity').value
                    };

                    try {
                        const res = await fetch('/cart/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json();

                        // Not logged in → redirect
                        if (res.status === 401 && data.redirect) {
                            window.location.href = data.redirect;
                            return;
                        }

                        if (!data.success && data.redirect) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Product Unavailable',
                                text: data.message || 'This product is no longer available',
                                confirmButtonColor: '#ff4d6d'
                            }).then(() => {
                                if (data.reason === 'product') {
                                    window.location.href = data.redirect;
                                } else if (data.reason === 'variant') {
                                    location.reload();
                                } else {
                                    window.location.href = data.redirect;
                                }
                            });
                            return;
                        }

                        if (data.success) {
                            // Update header badge
                            if (typeof window.updateCartCount === 'function' && data.cartCount !== undefined) {
                                window.updateCartCount(data.cartCount);
                            }

                            Swal.fire({
                                icon: 'success',
                                title: 'Added to Cart',
                                text: 'Item successfully added to your cart',
                                timer: 1600,
                                showConfirmButton: false
                            });

                            cartVariantIds.push(payload.variantId);

                            btn.innerText = 'Go to Cart';
                            btn.dataset.state = 'go';

                            btn.classList.remove(
                                'bg-brand-500',
                                'hover:bg-brand-600'
                            );

                            btn.classList.add(
                                'bg-gray-900',
                                'hover:bg-black',
                                'text-white'
                            );

                            btn.dataset.state = 'go';
                        }

                    } catch (err) {
                        console.error(err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops!',
                            text: 'Something went wrong'
                        });
                    }
                });


                async function buyNow() {
                    if (!isLoggedIn) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Login Required',
                            text: 'Please login to purchase items',
                            confirmButtonText: 'Login',
                            confirmButtonColor: '#ff4d6d'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/login';
                            }
                        });
                        return;
                    }

                    const variantId = document.getElementById('cartVariantId').value;
                    if (!variantId) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Select Variant',
                            text: 'Please select a size and color before buying',
                            confirmButtonColor: '#3b82f6'
                        });
                        return;
                    }

                    const payload = {
                        productId: "<%= product._id %>",
                        variantId: document.getElementById('cartVariantId').value,
                        quantity: document.getElementById('formQuantity').value
                    };

                    try {
                        const res = await fetch('/checkout/buy-now-init', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        const data = await res.json();

                        // Not logged in → redirect
                        if (res.status === 401 && data.redirect) {
                            window.location.href = data.redirect;
                            return;
                        }

                        if (!data.success && data.message) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Product Unavailable',
                                text: data.message,
                                confirmButtonColor: '#ff4d6d'
                            });
                            return;
                        }

                        // Success -> Go to Checkout natively
                        if (data.success) {
                            window.location.href = '/checkout?buyNow=true';
                        } else {
                            // If add-to-cart failed for some reason (e.g., stock limit)
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops!',
                                text: data.message || 'Something went wrong'
                            });
                        }

                    } catch (err) {
                        console.error("Buy Now Error:", err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops!',
                            text: 'Could not process Buy Now request'
                        });
                    }
                }

            </script>



            <script>
                const zoomContainer = document.getElementById("zoomContainer");
                const zoomImage = document.getElementById("mainImage");

                zoomContainer.addEventListener("mousemove", (e) => {
                    const rect = zoomContainer.getBoundingClientRect();
                    const x = ((e.clientX - rect.left) / rect.width) * 100;
                    const y = ((e.clientY - rect.top) / rect.height) * 100;

                    zoomImage.style.transformOrigin = `${x}% ${y}%`;
                });

                zoomContainer.addEventListener("mouseleave", () => {
                    zoomImage.style.transformOrigin = "center center";
                });

                // Force reload when navigating backward (bypasses browser cache)
                window.addEventListener("pageshow", function (event) {
                    const historyTraversal = event.persisted ||
                        (typeof window.performance != "undefined" &&
                            window.performance.navigation.type === 2);
                    if (historyTraversal) {
                        // Handle page restore.
                        window.location.reload();
                    }
                });
            </script>

