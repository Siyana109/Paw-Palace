<script>
    const deleteModal = document.getElementById('deleteModal');
    const deleteForm = document.getElementById('deleteForm');
    const modalAddrName = document.getElementById('modalAddrName');
    const modalAddrText = document.getElementById('modalAddrText');

    function openDeleteModal(id, name, address) {
        deleteForm.dataset.action = `/profile/address/${id}/delete`;
        modalAddrName.textContent = name;
        modalAddrText.textContent = address;

        deleteModal.classList.remove('hidden');
        deleteModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        deleteModal.classList.add('hidden');
        deleteModal.classList.remove('flex');
        document.body.style.overflow = 'auto';
    }

    deleteModal.addEventListener('click', (e) => {
        if (e.target === deleteModal) closeDeleteModal();
    });

    async function handleDelete(e) {
        e.preventDefault();
        const url = deleteForm.dataset.action;
        if (!url) return;

        try {
            const res = await fetch(url, { method: 'POST' });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                alert('Failed to delete address');
            }
        } catch (err) {
            console.error(err);
            alert('Error deleting address');
        }
    }
</script>

<script>
    const nameInput = document.querySelector('input[name="name"]');
    const phoneInput = document.querySelector('input[name="phone"]');
    const saveBtn = document.querySelector('button[type="submit"]');

    function showError(input, message) {
        clearError(input);
        const p = document.createElement('p');
        p.className = 'text-xs text-red-500 mt-1 font-bold';
        p.textContent = message;
        input.parentElement.appendChild(p);
        input.classList.add('border-red-500', 'bg-red-50');
    }

    function clearError(input) {
        const err = input.parentElement.querySelector('p.text-red-500');
        if (err) err.remove();
        input.classList.remove('border-red-500', 'bg-red-50');
    }

    function validateName() {
        const value = nameInput.value.trim();

        const nameRegex = /^[A-Za-z]+(?:[ '-][A-Za-z]+)*$/;

        if (value.length < 3) {
            showError(nameInput, 'Name must be at least 3 characters');
            return false;
        }

        if (value.length > 50) {
            showError(nameInput, 'Name cannot exceed 50 characters');
            return false;
        }

        if (!nameRegex.test(value)) {
            showError(nameInput, 'Name can contain only letters, spaces, hyphens, or apostrophes');
            return false;
        }

        clearError(nameInput);
        return true;
    }

    function validatePhone() {
        const value = phoneInput.value.trim();
        if (value === '') {
            clearError(phoneInput); // optional phone
            return true;
        }
        if (!/^\d{10}$/.test(value)) {
            showError(phoneInput, 'Phone number must be 10 digits');
            return false;
        }
        clearError(phoneInput);
        return true;
    }

    function updateSaveState() {
        const valid = validateName() && validatePhone();
        saveBtn.disabled = !valid;
        saveBtn.classList.toggle('opacity-50', !valid);
        saveBtn.classList.toggle('cursor-not-allowed', !valid);
    }

    if (nameInput && phoneInput) {
        nameInput.addEventListener('input', updateSaveState);
        phoneInput.addEventListener('input', updateSaveState);

        // initial check
        updateSaveState();
    }
</script>

<script>
    let cropper;
    const input = document.getElementById('profilePicInput');
    const cropModal = document.getElementById('cropModal');
    const cropImage = document.getElementById('cropImage');
    const saveButton = cropModal.querySelector('button[onclick="applyCrop()"]');
    const initialButtonText = saveButton ? saveButton.innerText : 'Crop & Upload';

    input.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (!file.type.startsWith('image/')) {
            alert('Only images allowed');
            input.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = () => {
            // Destroy existing cropper BEFORE updating the image
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }

            cropImage.src = reader.result;

            cropModal.classList.remove('hidden');
            cropModal.classList.add('flex');

            // Initialize new cropper
            cropper = new Cropper(cropImage, {
                aspectRatio: 1,
                viewMode: 1,
                dragMode: 'move',
                autoCropArea: 1,
                restore: false,
                guides: true,
                center: true,
                highlight: false,
                cropBoxMovable: true,
                cropBoxResizable: true,
                toggleDragModeOnDblclick: false,
                background: false
            });
        };

        reader.readAsDataURL(file);
    });

    function closeCrop() {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
        cropModal.classList.add('hidden');
        cropModal.classList.remove('flex');
        input.value = '';
        if (saveButton) {
            saveButton.disabled = false;
            saveButton.innerText = initialButtonText;
        }
    }

    function applyCrop() {

        console.log("applyCrop");

        if (!cropper) return;

        saveButton.disabled = true;
        saveButton.innerText = "Uploading...";

        cropper.getCroppedCanvas({
            width: 300,
            height: 300,
            fillColor: '#fff',
        }).toBlob(async (blob) => {

            const formData = new FormData();
            formData.append("profilePic", blob, "profile.png");

            try {
                const res = await fetch("/profile/image/update", {
                    method: "POST",
                    body: formData,
                    credentials: "include" // 🔴 VERY IMPORTANT
                });

                if (!res.ok) throw new Error("Upload failed");

                window.location.reload();

            } catch (err) {
                console.error(err);
                alert("Failed to upload profile picture");
                saveButton.disabled = false;
                saveButton.innerText = "Crop & Upload";
            }

        }, "image/png");
    }
</script>

<script>
    const addressModal = document.getElementById("addressModal");
    const addressForm = document.getElementById("addressForm");
    const messageBox = document.getElementById("addressMessage");
    const titleEl = document.getElementById("addressModalTitle");
    // Explicit refs used by openEditAddressModal and the form submit handler
    const addrFullName = document.getElementById("addrFullName");
    const addrPhone    = document.getElementById("addrPhone");
    const addrAddress  = document.getElementById("addrAddress");
    const addrLandmark = document.getElementById("addrLandmark");
    const addrCity     = document.getElementById("addrCity");
    const addrState    = document.getElementById("addrState");
    const addrZip      = document.getElementById("addrZip");
    const addrType     = document.getElementById("addrType");
    // The scrollable body of the address modal (used to pull error into view)
    const addrModalBody = addressModal.querySelector('.overflow-y-auto');

    function showMsg(type, text) {
        messageBox.className =
            `mb-4 px-4 py-3 rounded-xl text-sm font-semibold ${type === "error"
                ? "bg-red-100 text-red-700"
                : "bg-green-100 text-green-700"
            }`;
        messageBox.textContent = text;
        messageBox.classList.remove("hidden");
        // Scroll the modal body back to the top so the message is always visible
        if (addrModalBody) addrModalBody.scrollTop = 0;
    }

    function openAddAddressModal() {
        addressForm.reset();
        document.getElementById("addressId").value = "";
        titleEl.innerText = "Add Address";
        messageBox.classList.add("hidden");

        addressModal.classList.remove("hidden");
        addressModal.classList.add("flex");
        document.body.style.overflow = "hidden";

        typeButtons.forEach(b =>
            b.classList.remove("bg-brand-500", "text-white", "border-brand-500")
        );

        typeButtons[0].classList.add("bg-brand-500", "text-white", "border-brand-500");
        addrTypeInput.value = "Home";
        document.getElementById("addrIsDefault").checked = false;

    }

    function openEditAddressModal(encodedAddr) {
        const addr = JSON.parse(decodeURIComponent(encodedAddr));

        titleEl.innerText = "Edit Address";
        messageBox.classList.add("hidden");

        document.getElementById("addressId").value = addr._id;
        document.getElementById("addrFullName").value = addr.fullName;
        document.getElementById("addrPhone").value = addr.phone;
        document.getElementById("addrAddress").value = addr.address;
        document.getElementById("addrLandmark").value = addr.landMark || "";
        document.getElementById("addrCity").value = addr.city;
        document.getElementById("addrState").value = addr.state;
        document.getElementById("addrZip").value = addr.zipCode;
        document.getElementById("addrType").value = addr.addressType || "Home";
        document.getElementById("addrIsDefault").checked = addr.isDefault || false;

        typeButtons.forEach(b => {
            b.classList.remove("bg-brand-500", "text-white", "border-brand-500");

            if (b.dataset.type === (addr.addressType || "Home")) {
                b.classList.add("bg-brand-500", "text-white", "border-brand-500");
                addrTypeInput.value = b.dataset.type;
            }
        });

        addressModal.classList.remove("hidden");
        addressModal.classList.add("flex");
        document.body.style.overflow = "hidden";
    }

    function closeAddressModal() {
        addressModal.classList.add("hidden");
        addressModal.classList.remove("flex");
        document.body.style.overflow = "auto";
    }

    addressForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("addressId").value;
        const data = {
            fullName: addrFullName.value.trim(),
            phone: addrPhone.value.trim(),
            address: addrAddress.value.trim(),
            landMark: addrLandmark.value.trim(),
            city: addrCity.value.trim(),
            state: addrState.value.trim(),
            zipCode: addrZip.value.trim(),
            addressType: addrType.value,
            isDefault: document.getElementById("addrIsDefault").checked
        };

        const nameRegex = /^[A-Za-z]+(?:[ '-][A-Za-z]+)*$/;

        if (data.fullName.length < 3)
            return showMsg("error", "Name must be at least 3 characters");

        if (data.fullName.length > 50)
            return showMsg("error", "Name cannot exceed 50 characters");

        if (!nameRegex.test(data.fullName))
            return showMsg("error", "Name can contain only letters, spaces, hyphens, or apostrophes");

        if (!/^\d{10}$/.test(data.phone))
            return showMsg("error", "Enter a valid 10-digit phone number");

        if (data.address.length < 10)
            return showMsg("error", "Address must be at least 10 characters");

        if (data.city.length < 2)
            return showMsg("error", "Enter a valid city name");

        if (data.state.length < 2)
            return showMsg("error", "Enter a valid state name");

        if (!/^\d{6}$/.test(data.zipCode))
            return showMsg("error", "Enter a valid 6-digit pincode");

        const url = id
            ? `/profile/address/${id}/edit`
            : `/address/add`;

        const method = id ? "PUT" : "POST";

        const res = await fetch(url, {
            method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
            showMsg("success", "Address saved successfully");
            setTimeout(() => location.reload(), 700);
        } else {
            showMsg("error", "Failed to save address");
        }
    });

    const typeButtons = document.querySelectorAll(".addr-type-btn");
    const addrTypeInput = document.getElementById("addrType");

    typeButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            typeButtons.forEach(b =>
                b.classList.remove("bg-brand-500", "text-white", "border-brand-500")
            );

            btn.classList.add("bg-brand-500", "text-white", "border-brand-500");
            addrTypeInput.value = btn.dataset.type;
        });
    });

</script>


