<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | PawPalace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css" />

    <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { teal: '#2dd4bf', tealDark: '#0d9488', navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-accent-cream font-sans text-accent-navy antialiased min-h-screen">

    <%- include('../partials/header') %>

        <main class="max-w-7xl mx-auto py-12 px-6 grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-3 space-y-6">
                <div class="bg-white rounded-[2rem] p-8 text-center shadow-sm">
                    <div class="relative inline-block mb-4">
                        <img id="profilePreview" src="<%= user.profilePic || 'https://via.placeholder.com/150' %>"
                            class="w-24 h-24 rounded-full object-cover border-4 border-brand-50" alt="Profile">

                        <!-- ALWAYS visible camera -->
                        <form action="/profile/image/update" method="POST" enctype="multipart/form-data"
                            class="absolute bottom-0 right-0">
                            <!-- <label class="bg-white shadow-md rounded-full w-8 h-8 flex items-center justify-center
             text-xs text-brand-500 border border-gray-100 cursor-pointer
             hover:bg-brand-50 transition">
                                <i class="fa-solid fa-camera"></i>
                                <input type="file" name="profilePic" accept="image/*" hidden
                                    onchange="this.form.submit()">
                            </label> -->
                            <label class="absolute bottom-0 right-0 bg-white shadow-md rounded-full w-8 h-8
         flex items-center justify-center text-xs text-brand-500 border border-gray-100
         cursor-pointer hover:bg-brand-50 transition">
                                <i class="fa-solid fa-camera"></i>
                                <input type="file" id="profilePicInput" accept="image/*" hidden>
                            </label>
                        </form>

                        <!-- REMOVE BUTTON -->
                        <% if (user.profilePic) { %>
                            <form action="/profile/image/remove" method="POST"
                                class="absolute -bottom-3 left-1/2 -translate-x-1/2">
                                <button type="submit" class="text-[10px] text-red-400 hover:text-red-500 font-bold">
                                    Remove
                                </button>
                            </form>
                            <% } %>
                    </div>


                    <h2 class="text-xl font-bold">
                        <%= user.fullName %>
                    </h2>
                    <!-- <p class="text-gray-400 text-sm font-medium">PawParent since 2023</p> -->
                    <div class="mt-4 p-2 bg-brand-50 rounded-xl">
                        <p class="text-[10px] font-bold text-brand-500 uppercase">Referral Code</p>
                        <p class="font-bold text-xs">
                            <%= user.referralCode %>
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-[2rem] p-4 shadow-sm space-y-2">
                    <a href="/profile"
                        class="flex items-center gap-4 p-4 rounded-2xl bg-brand-50 text-brand-500 font-bold transition">
                        <i class="fa-regular fa-user"></i> Profile Details
                    </a>
                    <a href="/wallet"
                        class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 text-gray-400 font-bold transition">
                        <i class="fa-solid fa-wallet"></i> Wallet
                    </a>
                    <a href="/orders"
                        class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 text-gray-400 font-bold transition">
                        <i class="fa-solid fa-box"></i> Orders
                    </a>
                    <button type="button" onclick="openLogoutModal()"
                        class="w-full flex items-center gap-4 p-4 rounded-2xl hover:bg-red-50 text-red-400 font-bold transition text-left">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
                    </button>

                    <form id="logoutForm" action="/logout" method="POST"></form>

                </div>
            </div>

            <div class="lg:col-span-9 space-y-6">
                <form action="/profile/update" method="POST" class="bg-white rounded-[2.5rem] p-10 shadow-sm relative">

                    <div class="flex justify-between items-center mb-8">
                        <h3 class="text-2xl font-bold">Personal Information</h3>
                        <% if (!isEditing) { %>
                            <a href="/profile?edit=true" class="text-brand-500 font-bold text-sm hover:underline">Edit
                                Details</a>
                            <% } else { %>
                                <div class="flex gap-4">
                                    <a href="/profile"
                                        class="text-gray-400 font-bold text-sm flex items-center">Cancel</a>
                                    <button type="submit"
                                        class="bg-brand-500 text-white px-6 py-2 rounded-xl font-bold text-sm shadow-lg shadow-brand-500/20">Save
                                        Changes</button>
                                </div>
                                <% } %>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">

                        <!-- FULL NAME -->
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">
                                Full Name
                            </label>

                            <div class="relative">
                                <i
                                    class="fa-regular fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-300"></i>

                                <input type="text" name="name" value="<%= user.fullName %>" <%=!isEditing ? 'disabled'
                                    : '' %>
                                class="w-full pl-11 pr-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl
                                focus:border-brand-500 focus:bg-white transition outline-none font-medium
                                disabled:opacity-60"
                                >
                            </div>
                        </div>

                        <!-- PHONE NUMBER -->
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-2 ml-1">
                                Phone Number
                            </label>

                            <div class="relative">
                                <i class="fa-solid fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-gray-300"></i>

                                <input type="text" name="phone" value="<%= user.phone || '' %>" <%=!isEditing
                                    ? 'disabled' : '' %>
                                placeholder="Optional"
                                class="w-full pl-11 pr-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl
                                focus:border-brand-500 focus:bg-white transition outline-none font-medium
                                disabled:opacity-60"
                                >
                            </div>
                        </div>

                    </div>


                    <div class="border-t border-gray-50 pt-8">
                        <div class="flex justify-between items-center mb-6">
                            <h4 class="font-bold text-gray-400 uppercase text-[10px]">Shipping Address</h4>
                            <a href="javascript:void(0)" onclick="openAddAddressModal()"
                                class="text-brand-500 font-bold text-xs">
                                + Add New
                                Address</a>

                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% (addresses || []).forEach(addr=> { %>
                                <div class="relative group">
                                    <div
                                        class="p-6 border-2 border-gray-100 rounded-2xl hover:border-brand-500 transition-all">

                                        <div class="flex justify-between items-center mb-2">
                                            <div class="flex items-center gap-2 max-w-[70%]">
                                                <span class="font-bold truncate">
                                                    <%= addr.fullName %>
                                                </span>

                                                <% if (addr.isDefault) { %>
                                                    <span
                                                        class="bg-brand-50 text-brand-500 text-[10px] font-bold px-2 py-0.5 rounded">
                                                        DEFAULT
                                                    </span>
                                                    <% } %>
                                            </div>

                                            <div class="flex gap-3 items-center whitespace-nowrap">
                                                <a href="javascript:void(0)"
                                                    onclick="event.stopPropagation(); openEditAddressModal('<%= encodeURIComponent(JSON.stringify(addr)) %>')"
                                                    class="text-xs text-gray-400 hover:text-brand-500">
                                                    Edit
                                                </a>

                                                <button type="button"
                                                    onclick="event.stopPropagation(); openDeleteModal('<%= addr._id %>', '<%= addr.fullName %>', '<%= addr.address %>')"
                                                    class="text-xs text-red-400 hover:text-red-500">
                                                    Delete
                                                </button>
                                            </div>
                                        </div>

                                        <p class="text-xs text-gray-500 leading-relaxed">
                                            <%= addr.address %><br>
                                                <%= addr.city %>, <%= addr.state %>
                                                        <%= addr.zipCode %><br>
                                                            <%= addr.phone %>
                                        </p>

                                        <!-- <% if (addr.isDefault) { %>
                                            <div
                                                class="absolute top-4 right-4 bg-brand-50 text-brand-500 text-[10px] font-bold px-2 py-1 rounded">
                                                DEFAULT
                                            </div>
                                            <% } %> -->

                                    </div>
                                </div>
                                <% }) %>

                        </div>
                    </div>
                </form>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <div class="bg-white rounded-[2rem] p-8 shadow-sm">
                        <div class="flex items-center gap-3 mb-4">
                            <div
                                class="text-brand-500 bg-brand-50 w-10 h-10 rounded-xl flex items-center justify-center">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <h3 class="font-bold text-lg">Email Address</h3>
                        </div>

                        <p class="text-gray-400 text-sm mb-4">
                            Current email:
                            <span class="font-medium text-accent-navy">
                                <%= user.email %>
                            </span>
                        </p>

                        <% if (!user.googleId) { %>
                            <!-- NORMAL USER -->
                            <a href="/change-email"
                                class="block text-center w-full border-2 border-gray-100 py-3 rounded-xl font-bold hover:bg-gray-50 transition">
                                Change Email
                            </a>
                            <% } else { %>
                                <!-- GOOGLE USER -->
                                <p class="text-xs text-gray-400 text-center italic">

                                </p>
                                <% } %>
                    </div>
                    <div class="bg-white rounded-[2rem] p-8 shadow-sm">
                        <div class="flex items-center gap-3 mb-4">
                            <div
                                class="text-brand-500 bg-brand-50 w-10 h-10 rounded-xl flex items-center justify-center">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <h3 class="font-bold text-lg">Security</h3>
                        </div>
                        <p class="text-gray-400 text-sm mb-6">Update your password to keep your account safe.</p>
                        <a href="/change-password"
                            class="block text-center w-full border-2 border-gray-100 py-3 rounded-xl font-bold hover:bg-gray-50 transition">Change
                            Password</a>
                    </div>

                    <div class="bg-white rounded-[2rem] p-8 shadow-sm">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="text-red-500 bg-red-50 w-10 h-10 rounded-xl flex items-center justify-center"><i
                                    class="fa-solid fa-triangle-exclamation"></i></div>
                            <h3 class="font-bold text-lg">Danger Zone</h3>
                        </div>
                        <p class="text-gray-400 text-sm mb-6">Once you delete your account, there is no going back.</p>
                        <button type="button"
                            class="block w-full bg-red-50 text-red-500 py-3 rounded-xl font-bold hover:bg-red-100 transition">
                            Delete Account
                        </button>
                    </div>
                </div>
            </div>
        </main>
        <!-- Delete Address Modal -->
        <div id="deleteModal"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-accent-navy/40 backdrop-blur-sm px-4">

            <div class="bg-white rounded-[2.5rem] p-8 w-full max-w-md shadow-2xl relative">

                <!-- Icon -->
                <div
                    class="w-20 h-20 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl">
                    <i class="fa-solid fa-trash-can"></i>
                </div>

                <!-- Title -->
                <h3 class="text-2xl font-extrabold text-center mb-2">
                    Delete Address?
                </h3>

                <p class="text-gray-400 text-sm text-center mb-6">
                    This address will be permanently removed. This action cannot be undone.
                </p>

                <!-- Address Preview -->
                <div class="bg-gray-50 border border-gray-100 rounded-2xl p-4 mb-6">
                    <p id="modalAddrName" class="font-bold text-sm text-accent-navy"></p>
                    <p id="modalAddrText" class="text-xs text-gray-400 mt-1"></p>
                </div>

                <!-- Actions -->
                <form id="deleteForm" method="POST" class="space-y-3" onsubmit="handleDelete(event)">
                    <button type="submit"
                        class="w-full bg-red-500 text-white py-4 rounded-xl font-bold hover:bg-red-600 transition">
                        Yes, Delete Address
                    </button>

                    <button type="button" onclick="closeDeleteModal()"
                        class="w-full bg-gray-100 text-gray-500 py-4 rounded-xl font-bold hover:bg-gray-200 transition">
                        Cancel
                    </button>
                </form>

            </div>
        </div>

        <div id="cropModal" class="fixed inset-0 z-50 bg-black/60 items-center justify-center hidden">

            <div class="bg-white rounded-2xl p-6 w-[320px]">
                <img id="cropImage" class="max-w-full">

                <div class="flex gap-3 mt-4">
                    <button onclick="applyCrop()" class="flex-1 bg-brand-500 text-white py-2 rounded-xl font-bold">
                        Crop & Upload
                    </button>

                    <button onclick="closeCrop()" class="flex-1 bg-gray-100 py-2 rounded-xl font-bold">
                        Cancel
                    </button>
                </div>
            </div>
        </div>

        <div id="logoutModal"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">

            <div class="bg-white rounded-2xl p-8 w-full max-w-sm shadow-2xl text-center">
                <div
                    class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </div>

                <h3 class="text-xl font-bold mb-2">Log out?</h3>
                <p class="text-gray-400 text-sm mb-6">
                    Are you sure you want to log out of your account?
                </p>

                <div class="flex gap-3">
                    <button onclick="submitLogout()"
                        class="flex-1 bg-red-500 text-white py-3 rounded-xl font-bold hover:bg-red-600 transition">
                        Yes, Log out
                    </button>

                    <button onclick="closeLogoutModal()"
                        class="flex-1 bg-gray-100 text-gray-500 py-3 rounded-xl font-bold hover:bg-gray-200 transition">
                        Cancel
                    </button>
                </div>
            </div>
        </div>

        <!-- ADD / EDIT ADDRESS MODAL -->
        <div id="addressModal"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-accent-navy/40 backdrop-blur-sm px-4">

            <div class="bg-white rounded-[2.5rem] p-8 w-full max-w-lg shadow-2xl relative">

                <h3 id="addressModalTitle" class="text-2xl font-bold mb-6">
                    Add Address
                </h3>

                <!-- MESSAGE -->
                <div id="addressMessage" class="hidden mb-4 px-4 py-3 rounded-xl text-sm font-semibold">
                </div>

                <form id="addressForm" class="space-y-4">
                    <input type="hidden" id="addressId">

                    <input id="addrFullName" class="w-full border rounded-xl p-3 font-medium" placeholder="Full Name">

                    <input id="addrPhone" class="w-full border rounded-xl p-3 font-medium" placeholder="Phone">

                    <textarea id="addrAddress" class="w-full border rounded-xl p-3 font-medium"
                        placeholder="Address"></textarea>

                    <input id="addrLandmark" class="w-full border rounded-xl p-3 font-medium"
                        placeholder="Landmark (optional)">

                    <input id="addrCity" class="w-full border rounded-xl p-3 font-medium" placeholder="City">

                    <input id="addrState" class="w-full border rounded-xl p-3 font-medium" placeholder="State">

                    <input id="addrZip" class="w-full border rounded-xl p-3 font-medium" placeholder="Pincode">

                    <div class="flex gap-3">
                        <button type="button" class="addr-type-btn px-5 py-2 rounded-xl font-bold border"
                            data-type="Home">
                            Home
                        </button>

                        <button type="button" class="addr-type-btn px-5 py-2 rounded-xl font-bold border"
                            data-type="Work">
                            Work
                        </button>

                        <button type="button" class="addr-type-btn px-5 py-2 rounded-xl font-bold border"
                            data-type="Other">
                            Other
                        </button>
                    </div>

                    <input type="hidden" id="addrType" value="Home">

                    <div class="flex items-center gap-2 mt-4 ml-1">
                        <input type="checkbox" id="addrIsDefault"
                            class="w-5 h-5 accent-brand-500 rounded cursor-pointer">
                        <label for="addrIsDefault"
                            class="text-sm font-bold text-gray-500 cursor-pointer select-none">Set as
                            default address</label>
                    </div>

                    <div class="flex gap-3 pt-4">
                        <button type="button" onclick="closeAddressModal()"
                            class="flex-1 bg-gray-100 py-3 rounded-xl font-bold">
                            Cancel
                        </button>

                        <button type="submit" class="flex-1 bg-brand-500 text-white py-3 rounded-xl font-bold">
                            Save Address
                        </button>
                    </div>
                </form>
            </div>
        </div>

</body>

<script>
    const logoutModal = document.getElementById('logoutModal');
    const logoutForm = document.getElementById('logoutForm');

    function openLogoutModal() {
        logoutModal.classList.remove('hidden');
        logoutModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeLogoutModal() {
        logoutModal.classList.add('hidden');
        logoutModal.classList.remove('flex');
        document.body.style.overflow = 'auto';
    }

    function submitLogout() {
        logoutForm.submit();
    }

    logoutModal.addEventListener('click', (e) => {
        if (e.target === logoutModal) closeLogoutModal();
    });
</script>

<script>
    const deleteModal = document.getElementById('deleteModal');
    const deleteForm = document.getElementById('deleteForm');
    const modalAddrName = document.getElementById('modalAddrName');
    const modalAddrText = document.getElementById('modalAddrText');

    function openDeleteModal(id, name, address) {
        deleteForm.dataset.action = `/profile/address/${id}/delete`; // Store in dataset
        modalAddrName.textContent = name;
        modalAddrText.textContent = address;

        deleteModal.classList.remove('hidden');
        deleteModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    async function handleDelete(e) {
        e.preventDefault();
        const url = deleteForm.dataset.action;
        if (!url) return;

        try {
            const res = await fetch(url, { method: 'POST' });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                alert('Failed to delete address');
            }
        } catch (err) {
            console.error(err);
            alert('Error deleting address');
        }
    }
</script>

<script>
    const nameInput = document.querySelector('input[name="name"]');
    const phoneInput = document.querySelector('input[name="phone"]');
    const saveBtn = document.querySelector('button[type="submit"]');

    function showError(input, message) {
        clearError(input);
        const p = document.createElement('p');
        p.className = 'text-xs text-red-500 mt-1 font-bold';
        p.textContent = message;
        input.parentElement.appendChild(p);
        input.classList.add('border-red-500', 'bg-red-50');
    }

    function clearError(input) {
        const err = input.parentElement.querySelector('p.text-red-500');
        if (err) err.remove();
        input.classList.remove('border-red-500', 'bg-red-50');
    }

    function validateName() {
        const value = nameInput.value.trim();
        if (value.length < 3) {
            showError(nameInput, 'Name must be at least 3 characters');
            return false;
        }
        clearError(nameInput);
        return true;
    }

    function validatePhone() {
        const value = phoneInput.value.trim();
        if (value === '') {
            clearError(phoneInput); // optional phone
            return true;
        }
        if (!/^\d{10}$/.test(value)) {
            showError(phoneInput, 'Phone number must be 10 digits');
            return false;
        }
        clearError(phoneInput);
        return true;
    }

    function updateSaveState() {
        const valid = validateName() && validatePhone();
        saveBtn.disabled = !valid;
        saveBtn.classList.toggle('opacity-50', !valid);
        saveBtn.classList.toggle('cursor-not-allowed', !valid);
    }

    if (nameInput && phoneInput) {
        nameInput.addEventListener('input', updateSaveState);
        phoneInput.addEventListener('input', updateSaveState);

        // initial check
        updateSaveState();
    }
</script>

<script>
    let cropper;
    const input = document.getElementById('profilePicInput');
    const cropModal = document.getElementById('cropModal');
    const cropImage = document.getElementById('cropImage');
    const saveButton = cropModal.querySelector('button[onclick="applyCrop()"]');
    const initialButtonText = saveButton ? saveButton.innerText : 'Crop & Upload';

    input.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (!file.type.startsWith('image/')) {
            alert('Only images allowed');
            input.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = () => {
            // Destroy existing cropper BEFORE updating the image
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }

            cropImage.src = reader.result;

            cropModal.classList.remove('hidden');
            cropModal.classList.add('flex');

            // Initialize new cropper
            cropper = new Cropper(cropImage, {
                aspectRatio: 1,
                viewMode: 1,
                dragMode: 'move',
                autoCropArea: 1,
                restore: false,
                guides: true,
                center: true,
                highlight: false,
                cropBoxMovable: true,
                cropBoxResizable: true,
                toggleDragModeOnDblclick: false,
                background: false
            });
        };

        reader.readAsDataURL(file);
    });

    function closeCrop() {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
        cropModal.classList.add('hidden');
        cropModal.classList.remove('flex');
        input.value = '';
        if (saveButton) {
            saveButton.disabled = false;
            saveButton.innerText = initialButtonText;
        }
    }

    function applyCrop() {

        console.log("applyCrop");

        if (!cropper) return;

        saveButton.disabled = true;
        saveButton.innerText = "Uploading...";

        cropper.getCroppedCanvas({
            width: 300,
            height: 300,
            fillColor: '#fff',
        }).toBlob(async (blob) => {

            const formData = new FormData();
            formData.append("profilePic", blob, "profile.png");

            try {
                const res = await fetch("/profile/image/update", {
                    method: "POST",
                    body: formData,
                    credentials: "include" // 🔴 VERY IMPORTANT
                });

                if (!res.ok) throw new Error("Upload failed");

                window.location.reload();

            } catch (err) {
                console.error(err);
                alert("Failed to upload profile picture");
                saveButton.disabled = false;
                saveButton.innerText = "Crop & Upload";
            }

        }, "image/png");
    }
</script>

<script>
    const addressModal = document.getElementById("addressModal");
    const addressForm = document.getElementById("addressForm");
    const messageBox = document.getElementById("addressMessage");
    const titleEl = document.getElementById("addressModalTitle");

    function showMsg(type, text) {
        messageBox.className =
            `mb-4 px-4 py-3 rounded-xl text-sm font-semibold ${type === "error"
                ? "bg-red-100 text-red-700"
                : "bg-green-100 text-green-700"
            }`;
        messageBox.textContent = text;
        messageBox.classList.remove("hidden");
    }

    function openAddAddressModal() {
        addressForm.reset();
        document.getElementById("addressId").value = "";
        titleEl.innerText = "Add Address";
        messageBox.classList.add("hidden");

        addressModal.classList.remove("hidden");
        addressModal.classList.add("flex");
        document.body.style.overflow = "hidden";

        typeButtons.forEach(b =>
            b.classList.remove("bg-brand-500", "text-white", "border-brand-500")
        );

        typeButtons[0].classList.add("bg-brand-500", "text-white", "border-brand-500");
        addrTypeInput.value = "Home";
        document.getElementById("addrIsDefault").checked = false;

    }

    function openEditAddressModal(encodedAddr) {
        const addr = JSON.parse(decodeURIComponent(encodedAddr));

        titleEl.innerText = "Edit Address";
        messageBox.classList.add("hidden");

        document.getElementById("addressId").value = addr._id;
        document.getElementById("addrFullName").value = addr.fullName;
        document.getElementById("addrPhone").value = addr.phone;
        document.getElementById("addrAddress").value = addr.address;
        document.getElementById("addrLandmark").value = addr.landMark || "";
        document.getElementById("addrCity").value = addr.city;
        document.getElementById("addrState").value = addr.state;
        document.getElementById("addrZip").value = addr.zipCode;
        document.getElementById("addrType").value = addr.addressType || "Home";
        document.getElementById("addrIsDefault").checked = addr.isDefault || false;

        typeButtons.forEach(b => {
            b.classList.remove("bg-brand-500", "text-white", "border-brand-500");

            if (b.dataset.type === (addr.addressType || "Home")) {
                b.classList.add("bg-brand-500", "text-white", "border-brand-500");
                addrTypeInput.value = b.dataset.type;
            }
        });

        addressModal.classList.remove("hidden");
        addressModal.classList.add("flex");
        document.body.style.overflow = "hidden";
    }

    function closeAddressModal() {
        addressModal.classList.add("hidden");
        addressModal.classList.remove("flex");
        document.body.style.overflow = "auto";
    }

    addressForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("addressId").value;
        const data = {
            fullName: addrFullName.value.trim(),
            phone: addrPhone.value.trim(),
            address: addrAddress.value.trim(),
            landMark: addrLandmark.value.trim(),
            city: addrCity.value.trim(),
            state: addrState.value.trim(),
            zipCode: addrZip.value.trim(),
            addressType: addrType.value,
            isDefault: document.getElementById("addrIsDefault").checked
        };

        if (data.fullName.length < 3)
            return showMsg("error", "Name must be at least 3 characters");

        if (!/^\d{10}$/.test(data.phone))
            return showMsg("error", "Enter a valid 10-digit phone number");

        if (data.address.length < 10)
            return showMsg("error", "Address must be at least 10 characters");

        if (data.city.length < 2)
            return showMsg("error", "Enter a valid city name");

        if (data.state.length < 2)
            return showMsg("error", "Enter a valid state name");

        if (!/^\d{6}$/.test(data.zipCode))
            return showMsg("error", "Enter a valid 6-digit pincode");

        const url = id
            ? `/profile/address/${id}/edit`
            : `/address/add`;

        const method = id ? "PUT" : "POST";

        const res = await fetch(url, {
            method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
            showMsg("success", "Address saved successfully");
            setTimeout(() => location.reload(), 700);
        } else {
            showMsg("error", "Failed to save address");
        }
    });

    const typeButtons = document.querySelectorAll(".addr-type-btn");
    const addrTypeInput = document.getElementById("addrType");

    typeButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            typeButtons.forEach(b =>
                b.classList.remove("bg-brand-500", "text-white", "border-brand-500")
            );

            btn.classList.add("bg-brand-500", "text-white", "border-brand-500");
            addrTypeInput.value = btn.dataset.type;
        });
    });

</script>


</html>