<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | PawPalace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css" />

    <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { teal: '#2dd4bf', tealDark: '#0d9488', navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-accent-cream font-sans text-accent-navy antialiased min-h-screen">

    <%- include('../partials/header') %>

        <main class="max-w-7xl mx-auto py-12 px-6 grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-3 space-y-6">
                <div class="bg-white rounded-3xl p-8 text-center shadow-sm border border-gray-100 relative overflow-hidden">
                    <div class="absolute top-0 w-full h-24 bg-gradient-to-b from-brand-50 to-transparent opacity-50 left-0"></div>
                    <div class="relative z-10">
                        <div class="relative inline-block mb-4">
                            <img id="profilePreview" src="<%= user.profilePic || 'https://via.placeholder.com/150' %>"
                                class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-md" alt="Profile">

                            <!-- ALWAYS visible camera -->
                            <label class="absolute bottom-0 right-0 bg-white shadow-md rounded-full w-8 h-8
                                flex items-center justify-center text-xs text-brand-500 border border-gray-100
                                cursor-pointer hover:bg-brand-50 transition shadow-sm">
                                <i class="fa-solid fa-camera"></i>
                                <input type="file" id="profilePicInput" accept="image/*" hidden>
                            </label>

                            <!-- REMOVE BUTTON -->
                            <% if (user.profilePic) { %>
                                <form action="/profile/image/remove" method="POST"
                                    class="absolute -bottom-6 left-1/2 -translate-x-1/2">
                                    <button type="submit" class="text-[10px] text-red-400 hover:text-red-500 font-bold whitespace-nowrap">
                                        Remove Photo
                                    </button>
                                </form>
                            <% } %>
                        </div>

                        <h2 class="text-xl font-black text-accent-navy tracking-tight mt-2">
                            <%= user.fullName %>
                        </h2>
                        <p class="text-xs text-brand-500 font-bold uppercase tracking-wider mt-1">
                            <%= user.role || 'Member' %>
                        </p>

                        <div class="mt-8 p-3 bg-gray-50 rounded-2xl border border-gray-100">
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Referral Code</p>
                            <div class="flex items-center justify-center gap-2 cursor-pointer group/ref"
                                onclick="navigator.clipboard.writeText('<%= user.referralCode %>'); Swal.fire({title: 'Copied!', text: 'Referral code copied to clipboard', icon: 'success', timer: 1500, showConfirmButton: false})">
                                <span class="font-mono font-bold text-accent-navy text-sm group-hover/ref:text-brand-500 transition-colors">
                                    <%= user.referralCode %>
                                </span>
                                <i class="fa-regular fa-copy text-xs text-gray-300 group-hover/ref:text-brand-500 transition-colors"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-3xl p-4 shadow-sm border border-gray-100 space-y-1">
                    <a href="/profile"
                        class="flex items-center gap-4 p-4 rounded-2xl bg-brand-50 text-brand-600 font-bold transition shadow-sm border border-brand-100">
                        <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center text-brand-500 shadow-sm">
                            <i class="fa-regular fa-user"></i>
                        </div>
                        Profile Details
                    </a>
                    <a href="/wallet"
                        class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 text-gray-600 font-bold transition group">
                        <div class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center text-gray-400 group-hover:bg-white group-hover:text-brand-500 group-hover:shadow-sm transition">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <span class="group-hover:text-accent-navy transition">Wallet</span>
                    </a>
                    <a href="/orders"
                        class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 text-gray-600 font-bold transition group">
                        <div class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center text-gray-400 group-hover:bg-white group-hover:text-brand-500 group-hover:shadow-sm transition">
                            <i class="fa-solid fa-box"></i>
                        </div>
                        <span class="group-hover:text-accent-navy transition">My Orders</span>
                    </a>
                    <button type="button" onclick="openLogoutModal()"
                        class="w-full flex items-center gap-4 p-4 rounded-2xl hover:bg-red-50 text-red-500 font-bold transition text-left group">
                        <div class="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center text-red-500 group-hover:bg-white group-hover:shadow-sm transition">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        </div>
                        <span class="group-hover:text-red-600 transition">Log Out</span>
                    </button>

                    <form id="logoutForm" action="/logout" method="POST" class="hidden"></form>
                </div>
            </div>

            <div class="lg:col-span-9 space-y-6">
                <form action="/profile/update" method="POST" class="bg-white rounded-[2.5rem] p-10 shadow-sm relative">

                    <div class="flex justify-between items-center mb-8">
                        <h3 class="text-2xl font-bold">Personal Information</h3>
                        <% if (!isEditing) { %>
                            <a href="/profile?edit=true" class="text-brand-500 font-bold text-sm hover:underline">Edit
                                Details</a>
                            <% } else { %>
                                <div class="flex gap-4">
                                    <a href="/profile"
                                        class="text-gray-400 font-bold text-sm flex items-center">Cancel</a>
                                    <button type="submit"
                                        class="bg-brand-500 text-white px-6 py-2 rounded-xl font-bold text-sm shadow-lg shadow-brand-500/20">Save
                                        Changes</button>
                                </div>
                                <% } %>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">

                        <!-- FULL NAME -->
                        <div>
                            <label class="block text-[10px] font-bold text-gray-700 uppercase mb-2 ml-1">
                                Full Name
                            </label>

                            <div class="relative">
                                <i
                                    class="fa-regular fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-300"></i>

                                <input type="text" name="name" value="<%= user.fullName %>" <%=!isEditing ? 'disabled'
                                    : '' %>
                                class="w-full pl-11 pr-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl
                                focus:border-brand-500 focus:bg-white transition outline-none font-medium
                                disabled:opacity-80"
                                >
                            </div>
                        </div>

                        <!-- PHONE NUMBER -->
                        <div>
                            <label class="block text-[10px] font-bold text-gray-700 uppercase mb-2 ml-1">
                                Phone Number
                            </label>

                            <div class="relative">
                                <i class="fa-solid fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-gray-300"></i>

                                <input type="text" name="phone" value="<%= user.phone || '' %>" <%=!isEditing
                                    ? 'disabled' : '' %>
                                placeholder="Optional"
                                class="w-full pl-11 pr-4 py-3 bg-gray-50 border-2 border-gray-50 rounded-xl
                                focus:border-brand-500 focus:bg-white transition outline-none font-medium
                                disabled:opacity-80"
                                >
                            </div>
                        </div>

                    </div>


                    <div class="border-t border-gray-50 pt-8">
                        <div class="flex justify-between items-center mb-6">
                            <h4 class="font-bold text-gray-600 uppercase text-[10px]">Shipping Address</h4>
                            <a href="javascript:void(0)" onclick="openAddAddressModal()"
                                class="text-brand-500 font-bold text-xs">
                                + Add New
                                Address</a>

                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% (addresses || []).forEach(addr=> { %>
                                <div class="relative group">
                                    <div
                                        class="p-6 border-2 border-gray-100 rounded-2xl hover:border-brand-500 transition-all">

                                        <div class="flex justify-between items-center mb-2">
                                            <div class="flex items-center gap-2 max-w-[70%]">
                                                <span class="font-bold truncate">
                                                    <%= addr.fullName %>
                                                </span>

                                                <% if (addr.isDefault) { %>
                                                    <span
                                                        class="bg-brand-50 text-brand-500 text-[10px] font-bold px-2 py-0.5 rounded">
                                                        DEFAULT
                                                    </span>
                                                    <% } %>
                                            </div>

                                            <div class="flex gap-3 items-center whitespace-nowrap">
                                                <a href="javascript:void(0)"
                                                    class="addr-edit-btn text-xs text-gray-600 hover:text-brand-700"
                                                    data-addr="<%= encodeURIComponent(JSON.stringify(addr)) %>">
                                                    Edit
                                                </a>

                                                <button type="button"
                                                    class="addr-delete-btn text-xs text-red-600 hover:text-red-700"
                                                    data-id="<%= addr._id %>"
                                                    data-name="<%= encodeURIComponent(addr.fullName) %>"
                                                    data-address="<%= encodeURIComponent(addr.address) %>">
                                                    Delete
                                                </button>
                                            </div>
                                        </div>

                                        <p class="text-sm text-gray-800 leading-relaxed">
                                            <%= addr.address %><br>
                                                <%= addr.city %>, <%= addr.state %>
                                                        <%= addr.zipCode %><br>
                                                            <%= addr.phone %>
                                        </p>
                                    </div>
                                </div>
                                <% }) %>

                        </div>
                    </div>
                </form>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <div class="bg-white rounded-[2rem] p-8 shadow-sm">
                        <div class="flex items-center gap-3 mb-4">
                            <div
                                class="text-brand-500 bg-brand-50 w-10 h-10 rounded-xl flex items-center justify-center">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <h3 class="font-bold text-lg">Email Address</h3>
                        </div>

                        <p class="text-gray-400 text-sm mb-4">
                            Current email:
                            <span class="font-medium text-accent-navy">
                                <%= user.email %>
                            </span>
                        </p>

                        <% if (!user.googleId) { %>
                            <!-- NORMAL USER -->
                            <a href="/change-email"
                                class="block text-center w-full border-2 border-gray-100 py-3 rounded-xl font-bold hover:bg-gray-50 transition">
                                Change Email
                            </a>
                            <% } else { %>
                                <!-- GOOGLE USER -->
                                <p class="text-xs text-gray-400 text-center italic">

                                </p>
                                <% } %>
                    </div>
                    <div class="bg-white rounded-[2rem] p-8 shadow-sm">
                        <div class="flex items-center gap-3 mb-4">
                            <div
                                class="text-brand-500 bg-brand-50 w-10 h-10 rounded-xl flex items-center justify-center">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <h3 class="font-bold text-lg">Security</h3>
                        </div>
                        <p class="text-gray-400 text-sm mb-6">Update your password to keep your account safe.</p>
                        <a href="/change-password"
                            class="block text-center w-full border-2 border-gray-100 py-3 rounded-xl font-bold hover:bg-gray-50 transition">Change
                            Password</a>
                    </div>

                    <div class="bg-white rounded-[2rem] p-8 shadow-sm">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="text-red-500 bg-red-50 w-10 h-10 rounded-xl flex items-center justify-center"><i
                                    class="fa-solid fa-triangle-exclamation"></i></div>
                            <h3 class="font-bold text-lg">Danger Zone</h3>
                        </div>
                        <p class="text-gray-400 text-sm mb-6">Once you delete your account, there is no going back.</p>
                        <button type="button"
                            class="block w-full bg-red-50 text-red-500 py-3 rounded-xl font-bold hover:bg-red-100 transition">
                            Delete Account
                        </button>
                    </div>
                </div>
            </div>
        </main>
        <!-- Delete Address Modal -->
        <div id="deleteModal"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-accent-navy/40 backdrop-blur-sm px-4">

            <div class="bg-white rounded-[2.5rem] p-8 w-full max-w-md shadow-2xl relative">

                <!-- Icon -->
                <div
                    class="w-20 h-20 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl">
                    <i class="fa-solid fa-trash-can"></i>
                </div>

                <!-- Title -->
                <h3 class="text-2xl font-extrabold text-center mb-2">
                    Delete Address?
                </h3>

                <p class="text-gray-400 text-sm text-center mb-6">
                    This address will be permanently removed. This action cannot be undone.
                </p>

                <!-- Address Preview -->
                <div class="bg-gray-50 border border-gray-100 rounded-2xl p-4 mb-6">
                    <p id="modalAddrName" class="font-bold text-sm text-accent-navy"></p>
                    <p id="modalAddrText" class="text-xs text-gray-400 mt-1"></p>
                </div>

                <!-- Actions -->
                <form id="deleteForm" method="POST" class="space-y-3" onsubmit="handleDelete(event)">
                    <button type="submit"
                        class="w-full bg-red-500 text-white py-4 rounded-xl font-bold hover:bg-red-600 transition">
                        Yes, Delete Address
                    </button>

                    <button type="button" onclick="closeDeleteModal()"
                        class="w-full bg-gray-100 text-gray-500 py-4 rounded-xl font-bold hover:bg-gray-200 transition">
                        Cancel
                    </button>
                </form>

            </div>
        </div>

        <div id="cropModal" class="fixed inset-0 z-50 bg-black/60 items-center justify-center hidden px-4">
            <div class="bg-white rounded-[2rem] p-8 w-full max-w-lg h-[70vh] flex flex-col shadow-2xl transition-all scale-100">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-500">
                        <i class="fa-solid fa-crop"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-accent-navy tracking-tight">Crop Profile Picture</h3>
                </div>
                
                <div class="flex-1 overflow-hidden relative bg-gray-50 rounded-3xl flex items-center justify-center border-2 border-dashed border-gray-200">
                    <img id="cropImage" class="max-w-full max-h-full block">
                </div>

                <div class="flex gap-4 mt-8 shrink-0">
                    <button onclick="closeCrop()" class="flex-1 bg-gray-100 text-gray-500 py-4 rounded-2xl font-bold hover:bg-gray-200 transition">
                        Cancel
                    </button>
                    <button onclick="applyCrop()" class="flex-1 bg-brand-500 text-white py-4 rounded-2xl font-bold hover:bg-rose-600 shadow-lg shadow-brand-500/20 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check"></i> Crop & Upload
                    </button>
                </div>
            </div>
        </div>

        <div id="logoutModal"
            class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">

            <div class="bg-white rounded-2xl p-8 w-full max-w-sm shadow-2xl text-center">
                <div
                    class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </div>

                <h3 class="text-xl font-bold mb-2">Log out?</h3>
                <p class="text-gray-400 text-sm mb-6">
                    Are you sure you want to log out of your account?
                </p>

                <div class="flex gap-3">
                    <button onclick="submitLogout()"
                        class="flex-1 bg-red-500 text-white py-3 rounded-xl font-bold hover:bg-red-600 transition">
                        Yes, Log out
                    </button>

                    <button onclick="closeLogoutModal()"
                        class="flex-1 bg-gray-100 text-gray-500 py-3 rounded-xl font-bold hover:bg-gray-200 transition">
                        Cancel
                    </button>
                </div>
            </div>
        </div>

        <!-- ADD / EDIT ADDRESS MODAL -->
        <div id="addressModal"
            class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-accent-navy/50 backdrop-blur-sm p-0 sm:px-4">

            <!-- Panel -->
            <div class="bg-white w-full sm:max-w-lg sm:rounded-[2rem] rounded-t-[2rem] shadow-2xl flex flex-col max-h-[92vh] sm:max-h-[90vh] overflow-hidden">

                <!-- Sticky Header -->
                <div class="flex items-center justify-between px-7 pt-7 pb-5 border-b border-gray-100 flex-shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-500">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <h3 id="addressModalTitle" class="text-xl font-extrabold text-accent-navy tracking-tight">
                            Add Address
                        </h3>
                    </div>
                    <button onclick="closeAddressModal()"
                        class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Scrollable Body -->
                <div class="flex-1 overflow-y-auto px-7 py-6 space-y-1">

                    <!-- Alert message -->
                    <div id="addressMessage" class="hidden mb-4 px-4 py-3 rounded-xl text-sm font-semibold"></div>

                    <form id="addressForm" class="space-y-4">
                        <input type="hidden" id="addressId">

                        <!-- Name + Phone -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Full Name</label>
                                <div class="relative">
                                    <i class="fa-regular fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-300 text-sm"></i>
                                    <input id="addrFullName" placeholder="John Doe"
                                        class="w-full pl-9 pr-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl text-sm font-semibold text-accent-navy focus:border-brand-500 focus:bg-white outline-none transition placeholder-gray-300">
                                </div>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Phone</label>
                                <div class="relative">
                                    <i class="fa-solid fa-phone absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-300 text-sm"></i>
                                    <input id="addrPhone" placeholder="10-digit number"
                                        class="w-full pl-9 pr-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl text-sm font-semibold text-accent-navy focus:border-brand-500 focus:bg-white outline-none transition placeholder-gray-300">
                                </div>
                            </div>
                        </div>

                        <!-- Address -->
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Street Address</label>
                            <textarea id="addrAddress" rows="2" placeholder="House no., Street, Area..."
                                class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl text-sm font-semibold text-accent-navy focus:border-brand-500 focus:bg-white outline-none transition resize-none placeholder-gray-300"></textarea>
                        </div>

                        <!-- Landmark + City -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Landmark <span class="normal-case font-medium">(optional)</span></label>
                                <input id="addrLandmark" placeholder="Near..."
                                    class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl text-sm font-semibold text-accent-navy focus:border-brand-500 focus:bg-white outline-none transition placeholder-gray-300">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">City</label>
                                <input id="addrCity" placeholder="City"
                                    class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl text-sm font-semibold text-accent-navy focus:border-brand-500 focus:bg-white outline-none transition placeholder-gray-300">
                            </div>
                        </div>

                        <!-- State + Pincode -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">State</label>
                                <input id="addrState" placeholder="State"
                                    class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl text-sm font-semibold text-accent-navy focus:border-brand-500 focus:bg-white outline-none transition placeholder-gray-300">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Pincode</label>
                                <input id="addrZip" placeholder="6-digit pincode"
                                    class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-100 rounded-xl text-sm font-semibold text-accent-navy focus:border-brand-500 focus:bg-white outline-none transition placeholder-gray-300">
                            </div>
                        </div>

                        <!-- Address Type -->
                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2 ml-1">Address Type</label>
                            <div class="flex gap-2">
                                <button type="button"
                                    class="addr-type-btn flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-sm border-2 border-gray-100 text-gray-400 hover:border-brand-300 hover:text-brand-500 transition"
                                    data-type="Home">
                                    <i class="fa-solid fa-house text-xs"></i> Home
                                </button>
                                <button type="button"
                                    class="addr-type-btn flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-sm border-2 border-gray-100 text-gray-400 hover:border-brand-300 hover:text-brand-500 transition"
                                    data-type="Work">
                                    <i class="fa-solid fa-briefcase text-xs"></i> Work
                                </button>
                                <button type="button"
                                    class="addr-type-btn flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-sm border-2 border-gray-100 text-gray-400 hover:border-brand-300 hover:text-brand-500 transition"
                                    data-type="Other">
                                    <i class="fa-solid fa-location-dot text-xs"></i> Other
                                </button>
                            </div>
                            <input type="hidden" id="addrType" value="Home">
                        </div>

                        <!-- Default checkbox -->
                        <label class="flex items-center gap-3 p-3 rounded-xl border-2 border-gray-100 hover:border-brand-200 hover:bg-brand-50 transition cursor-pointer group">
                            <input type="checkbox" id="addrIsDefault" class="w-4 h-4 accent-brand-500 cursor-pointer">
                            <div>
                                <p class="text-sm font-bold text-accent-navy group-hover:text-brand-600 transition">Set as default address</p>
                                <p class="text-xs text-gray-400">Use this address by default at checkout</p>
                            </div>
                        </label>

                    </form>
                </div>

                <!-- Sticky Footer -->
                <div class="flex gap-3 px-7 py-5 border-t border-gray-100 bg-white flex-shrink-0">
                    <button type="button" onclick="closeAddressModal()"
                        class="flex-1 bg-gray-100 text-gray-600 py-3.5 rounded-xl font-bold hover:bg-gray-200 transition text-sm">
                        Cancel
                    </button>
                    <button type="submit" form="addressForm"
                        class="flex-1 bg-brand-500 text-white py-3.5 rounded-xl font-bold hover:bg-rose-600 transition shadow-lg shadow-brand-500/20 text-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i> Save Address
                    </button>
                </div>

            </div>
        </div>

<script>
    // Delegated listeners for Edit / Delete buttons on address cards
    // Using data-attributes avoids any quoting issues with special characters in addresses
    document.addEventListener('click', function (e) {
        const editBtn = e.target.closest('.addr-edit-btn');
        if (editBtn) {
            e.preventDefault();
            e.stopPropagation();
            openEditAddressModal(editBtn.dataset.addr);
            return;
        }

        const deleteBtn = e.target.closest('.addr-delete-btn');
        if (deleteBtn) {
            e.preventDefault();
            e.stopPropagation();
            const id      = deleteBtn.dataset.id;
            const name    = decodeURIComponent(deleteBtn.dataset.name);
            const address = decodeURIComponent(deleteBtn.dataset.address);
            openDeleteModal(id, name, address);
        }
    });
</script>

