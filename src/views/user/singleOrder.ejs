            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
                // ... Existing Return Modal Functions (openReturnModal, etc) ... 

                function openReturnModal(orderId, itemId, productName, variantName, imageUrl, maxQty) {
                    document.getElementById('returnOrderId').value = orderId;
                    document.getElementById('returnItemId').value = itemId;
                    document.getElementById('returnItemName').textContent = productName;
                    document.getElementById('returnItemVariant').textContent = variantName || '';
                    document.getElementById('returnItemImage').src = imageUrl || '/assets/images/default-product.png';

                    const qtyInput = document.getElementById('returnQuantity');
                    qtyInput.max = maxQty;
                    qtyInput.value = maxQty;

                    document.getElementById('returnModal').classList.remove('hidden');
                }

                function closeReturnModal() {
                    document.getElementById('returnModal').classList.add('hidden');
                    document.getElementById('returnForm').reset();
                }

                // ... Existing Toggle Other Reason ...

                async function submitReturnRequest(event) {

                    event.preventDefault();

                    const form = event.target;

                    const quantity = parseInt(form.returnQuantity.value, 10);
                    const reasonSelect = form.returnReason.value;
                    const commentsValue = form.comments.value.trim();

                    if (!reasonSelect) {
                        return Swal.fire({
                            icon: "warning",
                            title: "Reason Required",
                            text: "Please select a return reason.",
                            confirmButtonColor: "#f43f5e"
                        });
                    }

                    const maxQty = parseInt(form.returnQuantity.max);

                    if (isNaN(quantity)) {
                        return Swal.fire({
                            icon: "warning",
                            title: "Quantity Required",
                            text: "Please enter a quantity to return.",
                            confirmButtonColor: "#f43f5e"
                        });
                    }

                    if (quantity <= 0) {
                        return Swal.fire({
                            icon: "warning",
                            title: "Invalid Quantity",
                            text: "Quantity must be greater than 0.",
                            confirmButtonColor: "#f43f5e"
                        });
                    }

                    if (quantity > maxQty) {
                        return Swal.fire({
                            icon: "warning",
                            title: "Quantity Too Large",
                            text: `You can return only up to ${maxQty} item(s).`,
                            confirmButtonColor: "#f43f5e"
                        });
                    }

                    // Validation for optional comments
                    if (commentsValue.length > 0 && commentsValue.length < 10) {
                        return Swal.fire({
                            icon: 'warning',
                            title: 'Validation Error',
                            text: 'If provided, additional comments must be at least 10 characters long.',
                            confirmButtonColor: '#f43f5e'
                        });
                    }

                    if (reasonSelect === 'Other' && commentsValue.length < 10) {
                        return Swal.fire({
                            icon: 'warning',
                            title: 'Validation Error',
                            text: 'Please provide a valid reason (at least 10 characters) in the comments when "Other" is selected.',
                            confirmButtonColor: '#f43f5e'
                        });
                    }

                    let finalReason = reasonSelect;
                    if (commentsValue) {
                        finalReason = `${reasonSelect}: ${commentsValue}`;
                    }

                    try {
                        const orderId = form.orderId.value;
                        const itemId = form.itemId.value;
                        const response = await fetch(`/orders/${orderId}/items/${itemId}/return`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ reason: finalReason, quantity })
                        });
                        const data = await response.json();

                        if (data.success) {
                            closeReturnModal();
                            Swal.fire({
                                icon: 'success',
                                title: 'Return Requested',
                                text: 'Your return request has been submitted successfully.',
                                confirmButtonColor: '#f43f5e'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to submit request',
                                confirmButtonColor: '#f43f5e'
                            });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An unexpected error occurred',
                            confirmButtonColor: '#f43f5e'
                        });
                    }
                }

                // ... Existing cancelReturnItem function ...

                async function cancelReturnItem(orderId, itemId) {
                    const result = await Swal.fire({
                        title: 'Cancel Return Request?',
                        text: "Are you sure you want to cancel this return request?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#f43f5e',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, cancel it!'
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/orders/${orderId}/items/${itemId}/return/cancel`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' }
                            });
                            const data = await response.json();

                            if (data.success) {
                                Swal.fire(
                                    'Cancelled!',
                                    'Your return request has been cancelled.',
                                    'success'
                                ).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Error!',
                                    data.message || 'Failed to cancel request.',
                                    'error'
                                );
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            Swal.fire(
                                'Error!',
                                'Something went wrong.',
                                'error'
                            );
                        }
                    }
                }


                // NEW CANCEL FUNCTIONS
                function openCancelModal(orderId, itemId = null, productName = null, variantName = null, imageUrl = null, maxQty = 1) {
                    document.getElementById('cancelOrderId').value = orderId;
                    document.getElementById('cancelItemId').value = itemId || '';

                    if (itemId) {
                        document.getElementById('cancelModalTitle').textContent = 'Cancel Item';
                        document.getElementById('cancelItemDetails').classList.remove('hidden');
                        document.getElementById('cancelItemName').textContent = productName;
                        document.getElementById('cancelItemVariant').textContent = variantName || '';
                        document.getElementById('cancelItemImage').src = imageUrl || '/assets/images/default-product.png';

                        document.getElementById('cancelQuantityContainer').classList.remove('hidden');
                        const qtyInput = document.getElementById('cancelQuantity');
                        qtyInput.max = maxQty;
                        qtyInput.value = maxQty;
                    } else {
                        document.getElementById('cancelModalTitle').textContent = 'Cancel Order';
                        document.getElementById('cancelItemDetails').classList.add('hidden');
                        document.getElementById('cancelQuantityContainer').classList.add('hidden');
                    }

                    document.getElementById('cancelModal').classList.remove('hidden');
                }

                function closeCancelModal() {
                    document.getElementById('cancelModal').classList.add('hidden');
                    document.getElementById('cancelForm').reset();
                }

                async function submitCancelRequest(event) {

                    event.preventDefault();

                    const form = event.target;

                    const orderId = form.orderId.value;
                    const itemId = form.itemId.value;
                    const quantity = parseInt(form.cancelQuantity.value, 10);
                    const reasonSelect = form.cancelReason.value;
                    const additionalComments = form.otherReason.value.trim();

                    if (!reasonSelect) {
                        return Swal.fire({
                            icon: "warning",
                            title: "Reason Required",
                            text: "Please select a cancellation reason.",
                            confirmButtonColor: "#f43f5e"
                        });
                    }

                    if (itemId && (!quantity || quantity <= 0)) {
                        return Swal.fire({
                            icon: "warning",
                            title: "Invalid Quantity",
                            text: "Please enter a valid quantity to cancel.",
                            confirmButtonColor: "#f43f5e"
                        });
                    }

                    // Validation for optional comments
                    if (additionalComments.length > 0 && additionalComments.length < 10) {
                        return Swal.fire({
                            icon: 'warning',
                            title: 'Validation Error',
                            text: 'If provided, additional comments must be at least 10 characters long.',
                            confirmButtonColor: '#f43f5e'
                        });
                    }

                    if (reasonSelect === 'Other' && additionalComments.length < 10) {
                        return Swal.fire({
                            icon: 'warning',
                            title: 'Validation Error',
                            text: 'Please provide a valid reason (at least 10 characters) in the comments when "Other" is selected.',
                            confirmButtonColor: '#f43f5e'
                        });
                    }

                    let finalReason = reasonSelect;
                    if (additionalComments) {
                        finalReason = `${reasonSelect}: ${additionalComments}`;
                    }

                    try {
                        const response = await fetch(`/orders/${orderId}/cancel`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ itemId, reason: finalReason, quantity })
                        });
                        const data = await response.json();

                        if (data.success) {
                            closeCancelModal();
                            Swal.fire({
                                icon: 'success',
                                title: 'Cancelled',
                                text: 'Cancellation processed successfully.',
                                confirmButtonColor: '#f43f5e'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to cancel',
                                confirmButtonColor: '#f43f5e'
                            });
                        }
                    } catch (error) {
                        console.error('Cancel Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An unexpected error occurred',
                            confirmButtonColor: '#f43f5e'
                        });
                    }
                }

                // REVIEW MODAL FUNCTIONS
                function openReviewModal(orderId, variantId, productName, variantName, imageUrl, productId) {
                    document.getElementById('reviewOrderId').value = orderId;
                    document.getElementById('reviewVariantId').value = variantId;
                    document.getElementById('reviewProductId').value = productId;
                    
                    document.getElementById('reviewItemName').textContent = productName;
                    document.getElementById('reviewItemVariant').textContent = variantName || '';
                    document.getElementById('reviewItemImage').src = imageUrl || '/assets/images/default-product.png';

                    // Reset star buttons
                    setRating(0);
                    document.getElementById('reviewForm').reset();
                    
                    document.getElementById('reviewModal').classList.remove('hidden');
                }

                function closeReviewModal() {
                    document.getElementById('reviewModal').classList.add('hidden');
                }

                function setRating(val) {
                    document.getElementById('selectedRating').value = val > 0 ? val : '';
                    document.querySelectorAll('.star-btn').forEach(btn => {
                        const index = parseInt(btn.dataset.index);
                        if (index <= val) {
                            btn.classList.add('bg-yellow-50', 'border-yellow-200', 'text-yellow-400');
                            btn.classList.remove('text-gray-200', 'border-gray-100');
                        } else {
                            btn.classList.remove('bg-yellow-50', 'border-yellow-200', 'text-yellow-400');
                            btn.classList.add('text-gray-200', 'border-gray-100');
                        }
                    });
                }

                async function submitReview(event) {
                    event.preventDefault();
                    const form = event.target;
                    const rating = form.rating.value;
                    const comment = form.comment.value.trim();

                    if (!rating) {
                        return Swal.fire({
                            icon: 'warning',
                            title: 'Rating Required',
                            text: 'Please select a star rating before submitting.',
                            confirmButtonColor: '#ff4d6d'
                        });
                    }

                    if (comment.length < 5) {
                        return Swal.fire({
                            icon: 'warning',
                            title: 'Comment Too Short',
                            text: 'Please write a brief comment (at least 5 characters).',
                            confirmButtonColor: '#ff4d6d'
                        });
                    }

                    try {
                        const response = await fetch('/reviews/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                orderId: form.orderId.value,
                                productId: form.productId.value,
                                variantId: form.variantId.value,
                                rating,
                                comment
                            })
                        });

                        const data = await response.json();

                        if (data.success) {
                            closeReviewModal();
                            Swal.fire({
                                icon: 'success',
                                title: 'Review Submitted!',
                                text: 'Your feedback helps other pet parents.',
                                confirmButtonColor: '#10b981',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => window.location.reload());
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Submission Error',
                                text: data.message || 'We could not process your review at this time.',
                                confirmButtonColor: '#ff4d6d'
                            });
                        }
                    } catch (error) {
                        console.error('Review submission error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Connectivity Issue',
                            text: 'Please check your connection and try again.',
                            confirmButtonColor: '#ff4d6d'
                        });
                    }
                }

                function viewYourReview(comment, rating, reviewId) {
                    let stars = '';
                    for (let i = 1; i <= 5; i++) {
                        stars += `<i class="fa-${i <= rating ? 'solid' : 'regular'} fa-star text-amber-400 text-sm"></i>`;
                    }

                    Swal.fire({
                        title: 'Your Review',
                        html: `
                            <div class="mb-4">${stars}</div>
                            <div class="text-gray-600 italic mb-6">"${comment || 'No comment provided.'}"</div>
                            <div class="pt-4 border-t border-gray-100 flex justify-center">
                                <button onclick="deleteReviewFromOrder('${reviewId}')" class="text-xs font-bold text-rose-500 hover:text-rose-600 transition flex items-center gap-1">
                                    <i class="fa-solid fa-trash-can"></i> Delete This Review
                                </button>
                            </div>
                        `,
                        showConfirmButton: false,
                        showCloseButton: true
                    });
                }

                async function deleteReviewFromOrder(reviewId) {
                    const result = await Swal.fire({
                        title: 'Delete Review?',
                        text: "Are you sure you want to delete your review? This action cannot be undone.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#f43f5e',
                        cancelButtonColor: '#9ca3af',
                        confirmButtonText: 'Yes, delete it!'
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/reviews/${reviewId}`, {
                                method: 'DELETE',
                                headers: { 'Content-Type': 'application/json' }
                            });

                            const data = await response.json();

                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Your review has been removed.',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => window.location.reload());
                            } else {
                                throw new Error(data.message);
                            }
                        } catch (error) {
                            console.error('Delete review error:', error);
                            Swal.fire('Error', error.message || 'Failed to delete review', 'error');
                        }
                    }
                }
            </script>
            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
            <script>
                async function retryPayment(orderId) {
                    try {
                        const res = await fetch('/checkout/retry-payment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ orderId })
                        });
                        const data = await res.json();

                        if (!data.success) {
                            return Swal.fire("Error", data.message || "Something went wrong", "error");
                        }

                        const options = {
                            key: data.key,
                            amount: data.razorpayOrder.amount,
                            currency: "INR",
                            name: "PawPalace",
                            description: "Order Payment Retry",
                            order_id: data.razorpayOrder.id,
                            handler: async function (response) {
                                const verifyRes = await fetch('/verify-payment', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ ...response, orderId: data.orderId })
                                });
                                const verifyData = await verifyRes.json();
                                if (verifyData.success) {
                                    window.location.href = `/order-confirmation/${verifyData.orderId}`;
                                } else {
                                    window.location.reload();
                                }
                            },
                            theme: { color: "#f43f5e" }
                        };
                        const rzp = new Razorpay(options);
                        rzp.on('payment.failed', function (response) {
                            console.log(response.error);
                            Swal.fire("Payment Failed", "Please try again.", "error");
                        });
                        rzp.open();
                    } catch (err) {
                        console.error(err);
                        Swal.fire("Error", "Could not initiate payment", "error");
                    }
                }
            </script>
</body>

