<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body
    class="bg-gray-50 font-sans text-slate-800 antialiased min-h-screen selection:bg-rose-100 selection:text-rose-600">

    <%- include('../partials/header') %>

        <main class="container mx-auto px-4 py-8 max-w-7xl">

            <!-- BREADCRUMB & BACK LINK -->
            <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 animate-fade-in-up">
                <a href="/" class="hover:text-rose-500 transition-colors">Home</a>
                <span class="text-gray-300">/</span>
                <a href="/orders" class="hover:text-rose-500 transition-colors">My Orders</a>
                <span class="text-gray-300">/</span>
                <span class="font-semibold text-slate-800">Order #<%= order.orderId %></span>
            </nav>

            <!-- HEADER SECTION -->
            <div
                class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-100 mb-8 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 animate-fade-in-up delay-75">
                <div>
                    <div class="flex flex-wrap items-center gap-4 mb-2">
                        <h1 class="text-3xl font-black text-slate-800 tracking-tight">
                            Order #<%= order.orderId %>
                        </h1>
                        <% let statusConfig={ 'Pending' : { color: 'bg-amber-100 text-amber-700' , icon: 'fa-clock'
                            }, 'Processing' : { color: 'bg-blue-100 text-blue-700' , icon: 'fa-gears' }, 'Shipped' : {
                            color: 'bg-indigo-100 text-indigo-700' , icon: 'fa-truck' }, 'Out for Delivery' : {
                            color: 'bg-purple-100 text-purple-700' , icon: 'fa-truck-ramp-box' }, 'Delivered' : {
                            color: 'bg-emerald-100 text-emerald-700' , icon: 'fa-check-circle' }, 'Cancelled' : {
                            color: 'bg-rose-100 text-rose-700' , icon: 'fa-circle-xmark' }, 'Returned' : {
                            color: 'bg-orange-100 text-orange-700' , icon: 'fa-rotate-left' }, 'Failed' : {
                            color: 'bg-red-100 text-red-700' , icon: 'fa-circle-exclamation' } }; let
                            currentStatus=statusConfig[order.orderStatus] || { color: 'bg-gray-100 text-gray-700' ,
                            icon: 'fa-circle-info' }; %>
                            <span
                                class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider <%= currentStatus.color %>">
                                <i class="fa-solid <%= currentStatus.icon %>"></i>
                                <%= order.orderStatus %>
                            </span>
                    </div>
                    <p class="text-slate-500 font-medium">
                        Placed on <span class="text-slate-800 font-bold">
                            <%= new Date(order.createdAt).toLocaleDateString('en-US', { weekday: 'long' ,
                                year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                        </span> at <%= new Date(order.createdAt).toLocaleTimeString('en-US', { hour: '2-digit' ,
                            minute: '2-digit' }) %>
                    </p>
                </div>

                <div class="flex flex-wrap gap-3 w-full lg:w-auto">
                    <% if (order.orderStatus==='Delivered' ) { %>
                        <button
                            class="flex-1 lg:flex-none px-6 py-2.5 rounded-xl bg-white border border-gray-200 font-bold text-sm hover:bg-gray-50 hover:border-gray-300 text-slate-700 transition flex items-center justify-center gap-2 shadow-sm">
                            <i class="fa-solid fa-file-invoice"></i> Download Invoice
                        </button>
                        <button onclick="reorderItems('<%= order._id %>')"
                            class="flex-1 lg:flex-none px-6 py-2.5 rounded-xl bg-rose-500 text-white font-bold text-sm hover:bg-rose-600 transition flex items-center justify-center gap-2 shadow-lg shadow-rose-500/20 active:scale-95 transform duration-200">
                            <i class="fa-solid fa-cart-plus"></i> Buy Again
                        </button>
                        <% } else if (['Placed', 'Pending' , 'Processing' ].includes(order.orderStatus)) { %>
                            <button onclick="openCancelModal('<%= order._id %>')"
                                class="flex-1 lg:flex-none px-6 py-2.5 rounded-xl bg-white border border-rose-200 text-rose-600 font-bold text-sm hover:bg-rose-50 transition flex items-center justify-center gap-2 shadow-sm hover:shadow-md">
                                <i class="fa-regular fa-circle-xmark"></i> Cancel Order
                            </button>
                            <% } %>
                </div>
            </div>


            <!-- TRACKING BAR -->
            <% if (!['Cancelled', 'Returned' , 'Failed' ].includes(order.orderStatus)) { %>
                <div
                    class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100 mb-8 relative overflow-hidden animate-fade-in-up delay-100">
                    <div
                        class="absolute top-0 right-0 w-64 h-64 bg-rose-50 rounded-full opacity-20 -mr-16 -mt-16 pointer-events-none">
                    </div>

                    <div class="relative z-10">
                        <h2 class="text-lg font-bold text-slate-800 mb-8 flex items-center gap-2">
                            <i class="fa-solid fa-location-arrow text-rose-500"></i> Order Tracking
                        </h2>

                        <div class="relative px-4 sm:px-8">
                            <!-- Progress Bar Background -->
                            <div class="absolute top-5 left-0 w-full h-1 bg-gray-100 rounded-full"></div>

                            <!-- Active Progress -->
                            <% let progressWidth='5%' ; if (order.orderStatus==='Processing' ) progressWidth='38%' ; if
                                (['Shipped', 'Partially Shipped' ].includes(order.orderStatus)) progressWidth='70%' ; if
                                (order.orderStatus==='Out for Delivery' ) progressWidth='85%' ; if
                                (order.orderStatus==='Delivered' ) progressWidth='100%' ; %>
                                <div class="absolute top-5 left-0 h-1 bg-gradient-to-r from-rose-500 to-rose-400 rounded-full transition-all duration-1000 ease-out"
                                    style="width: <%= progressWidth %>"></div>

                                <!-- Steps -->
                                <div class="relative flex justify-between w-full">
                                    <!-- Step 1: Placed -->
                                    <div class="flex flex-col items-center gap-3 group cursor-default">
                                        <div
                                            class="w-10 h-10 rounded-full flex items-center justify-center bg-rose-500 text-white shadow-lg shadow-rose-500/30 font-bold text-sm z-10 ring-4 ring-white">
                                            <i class="fa-solid fa-check"></i>
                                        </div>
                                        <span
                                            class="text-xs font-bold text-slate-700 uppercase tracking-wide">Placed</span>
                                    </div>

                                    <!-- Step 2: Packed -->
                                    <% let s2Active=['Processing', 'Shipped' , 'Out for Delivery' , 'Delivered'
                                        ].includes(order.orderStatus); %>
                                        <div class="flex flex-col items-center gap-3 group cursor-default">
                                            <div
                                                class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-500 z-10 ring-4 ring-white <%= s2Active ? 'bg-rose-500 text-white shadow-lg shadow-rose-500/30' : 'bg-white border-2 border-gray-200 text-gray-300' %>">
                                                <i class="fa-solid fa-box-open"></i>
                                            </div>
                                            <span
                                                class="text-xs font-bold uppercase tracking-wide transition-colors <%= s2Active ? 'text-slate-700' : 'text-gray-400' %>">Packed</span>
                                        </div>

                                        <!-- Step 3: Shipped -->
                                        <% let s3Active=['Shipped', 'Out for Delivery' , 'Delivered'
                                            ].includes(order.orderStatus); %>
                                            <div class="flex flex-col items-center gap-3 group cursor-default">
                                                <div
                                                    class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-500 z-10 ring-4 ring-white <%= s3Active ? 'bg-rose-500 text-white shadow-lg shadow-rose-500/30' : 'bg-white border-2 border-gray-200 text-gray-300' %>">
                                                    <i class="fa-solid fa-truck-fast"></i>
                                                </div>
                                                <span
                                                    class="text-xs font-bold uppercase tracking-wide transition-colors <%= s3Active ? 'text-slate-700' : 'text-gray-400' %>">Shipped</span>
                                            </div>

                                            <!-- Step 4: Delivered -->
                                            <% let s4Active=order.orderStatus==='Delivered' ; %>
                                                <div class="flex flex-col items-center gap-3 group cursor-default">
                                                    <div
                                                        class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-500 z-10 ring-4 ring-white <%= s4Active ? 'bg-rose-500 text-white shadow-lg shadow-rose-500/30' : 'bg-white border-2 border-gray-200 text-gray-300' %>">
                                                        <i class="fa-solid fa-house-chimney"></i>
                                                    </div>
                                                    <span
                                                        class="text-xs font-bold uppercase tracking-wide transition-colors <%= s4Active ? 'text-slate-700' : 'text-gray-400' %>">Delivered</span>
                                                </div>
                                </div>
                        </div>

                        <% if (order.orderStatus !=='Delivered' ) { %>
                            <div class="mt-8 text-center">
                                <p
                                    class="text-sm font-medium text-slate-500 bg-gray-50 inline-block px-4 py-2 rounded-full border border-gray-100">
                                    Estimated Delivery: <span class="text-slate-800 font-bold">
                                        <%= new Date(Date.now() + 5 * 24 * 60 * 60 * 1000).toLocaleDateString('en-US', {
                                            month: 'short' , day: 'numeric' }) %> - <%= new Date(Date.now() + 7 * 24 *
                                                60 * 60 * 1000).toLocaleDateString('en-US', { month: 'short' ,
                                                day: 'numeric' }) %>
                                    </span>
                                </p>
                            </div>
                            <% } else { %>
                                <div class="mt-8 text-center">
                                    <p
                                        class="text-sm font-medium text-emerald-600 bg-emerald-50 inline-block px-4 py-2 rounded-full border border-emerald-100">
                                        <i class="fa-solid fa-check-double mr-1"></i> Item was delivered on <span
                                            class="font-bold">
                                            <%= new Date(order.updatedAt).toLocaleDateString() %>
                                        </span>
                                    </p>
                                </div>
                                <% } %>
                    </div>
                </div>
                <% } %>


                    <!-- MAIN GRID -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fade-in-up delay-200">

                        <!-- LEFT COLUMN: ITEMS -->
                        <div class="lg:col-span-2 space-y-6">
                            <h3 class="font-bold text-xl text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-bag-shopping text-rose-500"></i> Shipments
                            </h3>

                            <div class="space-y-4">
                                <% order.items.forEach(item=> { %>
                                    <div
                                        class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow group relative overflow-hidden">
                                        <% if (item.itemStatus==='Cancelled' ) { %>
                                            <div class="absolute inset-0 bg-gray-50/50 z-10 pointer-events-none"></div>
                                            <% } %>

                                                <div class="flex flex-col sm:flex-row gap-5">
                                                    <!-- Image Section -->
                                                    <div
                                                        class="w-full sm:w-28 h-28 rounded-xl bg-gray-50 p-2 border border-gray-100 flex-shrink-0 flex items-center justify-center relative">
                                                        <% let imageUrl='/assets/images/default-product.png' ; if
                                                            (item.variantId && item.variantId.coverImage) {
                                                            imageUrl=item.variantId.coverImage; } %>
                                                            <img src="<%= imageUrl %>" alt="<%= item.productName %>"
                                                                class="max-w-full max-h-full object-contain mix-blend-multiply">

                                                            <% if (item.itemStatus==='Cancelled' ) { %>
                                                                <span
                                                                    class="absolute inset-0 flex items-center justify-center bg-gray-900/10 rounded-xl backdrop-blur-[1px]">
                                                                    <span
                                                                        class="bg-white/90 text-rose-600 text-xs font-bold px-2 py-1 rounded shadow-sm">Cancelled</span>
                                                                </span>
                                                                <% } %>
                                                    </div>

                                                    <!-- Content Section -->
                                                    <div class="flex-1 min-w-0 flex flex-col justify-between">
                                                        <div
                                                            class="flex flex-col sm:flex-row justify-between items-start gap-2 mb-2">
                                                            <div>
                                                                <h4
                                                                    class="font-bold text-slate-800 text-lg leading-tight group-hover:text-rose-600 transition-colors line-clamp-2">
                                                                    <%= item.productName %>
                                                                </h4>
                                                                <div
                                                                    class="flex flex-wrap gap-3 mt-2 text-sm text-slate-500">
                                                                    <% if (item.variantName) { %>
                                                                        <span
                                                                            class="bg-gray-50 px-2 py-0.5 rounded text-xs font-semibold border border-gray-100">
                                                                            <%= item.variantName %>
                                                                        </span>
                                                                        <% } %>
                                                                            <span
                                                                                class="font-medium text-xs self-center">Qty:
                                                                                <%= item.quantity %>
                                                                            </span>
                                                                </div>
                                                            </div>
                                                            <div class="text-right flex-shrink-0">
                                                                <p class="text-lg font-black text-slate-800">₹<%=
                                                                        item.price.toFixed(2) %>
                                                                </p>
                                                                <% if (item.itemStatus==='Cancelled' ) { %>
                                                                    <p class="text-xs font-bold text-rose-500">Refunded
                                                                    </p>
                                                                    <% } %>
                                                            </div>
                                                        </div>

                                                        <!-- Actions Area -->
                                                        <div
                                                            class="pt-3 border-t border-gray-50 flex flex-wrap gap-2 mt-auto z-20 relative">
                                                            <% if (['Delivered'].includes(order.orderStatus) &&
                                                                !['Cancelled', 'Returned' ].includes(item.itemStatus)) {
                                                                %>
                                                                <% if (!item.returnRequest ||
                                                                    !item.returnRequest.isRequested) { %>
                                                                    <button
                                                                        onclick="openReturnModal('<%= order._id %>', '<%= item._id %>', '<%= item.productName %>', '<%= item.variantName %>', '<%= imageUrl %>')"
                                                                        class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-slate-600 text-xs font-bold hover:bg-gray-50 hover:text-slate-800 hover:border-gray-300 transition shadow-sm">
                                                                        <i class="fa-solid fa-rotate-left mr-1"></i>
                                                                        Return Item
                                                                    </button>
                                                                    <button
                                                                        class="px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-600 text-xs font-bold hover:bg-emerald-100 transition shadow-sm">
                                                                        <i class="fa-regular fa-star mr-1"></i> Review
                                                                    </button>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-50 border border-amber-100 text-amber-600 text-xs font-bold">
                                                                            <i
                                                                                class="fa-solid fa-clock-rotate-left"></i>
                                                                            Return <%= item.returnRequest.status %>
                                                                        </span>
                                                                        <% if (item.returnRequest.status==='Pending' ) {
                                                                            %>
                                                                            <button
                                                                                onclick="cancelReturnItem('<%= order._id %>', '<%= item._id %>')"
                                                                                class="text-xs font-semibold text-gray-400 hover:text-rose-500 hover:underline transition ml-2">
                                                                                Cancel Request
                                                                            </button>
                                                                            <% } %>
                                                                                <% } %>
                                                                                    <% } else if
                                                                                        (['Pending', 'Processing'
                                                                                        , 'Placed'
                                                                                        ].includes(order.orderStatus) &&
                                                                                        !['Cancelled', 'Returned'
                                                                                        , 'Failed'
                                                                                        ].includes(item.itemStatus)) {
                                                                                        %>
                                                                                        <button
                                                                                            onclick="openCancelModal('<%= order._id %>', '<%= item._id %>', '<%= item.productName %>', '<%= item.variantName %>', '<%= imageUrl %>')"
                                                                                            class="px-3 py-1.5 rounded-lg bg-white border border-rose-100 text-rose-600 text-xs font-bold hover:bg-rose-50 hover:border-rose-200 transition shadow-sm">
                                                                                            Cancel Item
                                                                                        </button>
                                                                                        <% } else if
                                                                                            (item.itemStatus==='Returned'
                                                                                            ) { %>
                                                                                            <span
                                                                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 border border-blue-100 text-blue-600 text-xs font-bold">
                                                                                                <i
                                                                                                    class="fa-solid fa-check-double"></i>
                                                                                                Returned
                                                                                            </span>
                                                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: WIDGETS -->
                        <div class="space-y-6">

                            <!-- Shipping Address Widget -->
                            <div
                                class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-rose-100 transition-colors">
                                <div class="flex items-center gap-3 mb-4 pb-4 border-b border-gray-50">
                                    <div
                                        class="w-10 h-10 rounded-full bg-rose-50 text-rose-500 flex items-center justify-center shadow-inner">
                                        <i class="fa-solid fa-location-dot"></i>
                                    </div>
                                    <h3 class="font-bold text-slate-800">Shipping Details</h3>
                                </div>
                                <div class="pl-2">
                                    <p class="font-bold text-slate-800 mb-1 text-lg">
                                        <%= order.address.fullName %>
                                    </p>
                                    <p class="text-sm text-slate-500 leading-relaxed mb-3">
                                        <%= order.address.addressLine %><br>
                                            <%= order.address.city %>, <%= order.address.state %>
                                                    <%= order.address.zipCode %><br>
                                                        <%= order.address.country %>
                                    </p>
                                    <div
                                        class="flex items-center gap-2 text-sm text-slate-600 font-medium bg-gray-50 px-3 py-2 rounded-lg inline-block">
                                        <i class="fa-solid fa-phone text-xs text-rose-400"></i>
                                        <%= order.address.phone %>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Widget -->
                            <div
                                class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-emerald-100 transition-colors">
                                <div class="flex items-center gap-3 mb-4 pb-4 border-b border-gray-50">
                                    <div
                                        class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-500 flex items-center justify-center shadow-inner">
                                        <i class="fa-solid fa-credit-card"></i>
                                    </div>
                                    <h3 class="font-bold text-slate-800">Payment Info</h3>
                                </div>
                                <div class="pl-2">
                                    <div class="flex justify-between items-center mb-2">
                                        <span
                                            class="text-xs font-bold text-gray-400 uppercase tracking-wider">Method</span>
                                        <span class="font-bold text-slate-800">
                                            <%= order.payment.method %>
                                        </span>
                                    </div>

                                    <% if (order.payment.status==='Paid' ) { %>
                                        <div
                                            class="w-full bg-emerald-50 border border-emerald-100 text-emerald-700 px-4 py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2">
                                            <i class="fa-solid fa-circle-check"></i> Payment Successful
                                        </div>
                                        <% } else if (order.payment.status==='Failed' ) { %>
                                            <div
                                                class="w-full bg-red-50 border border-red-100 text-red-700 px-4 py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2">
                                                <i class="fa-solid fa-circle-exclamation"></i> Payment Failed
                                            </div>
                                            <% } else if (order.payment.status==='Pending' ) { %>
                                                <div
                                                    class="w-full bg-amber-50 border border-amber-100 text-amber-700 px-4 py-3 rounded-xl text-sm font-bold flex items-center justify-center gap-2">
                                                    <i class="fa-solid fa-clock"></i> Payment Pending
                                                </div>
                                                <% } %>
                                </div>
                            </div>

                            <!-- Order Summary Widget -->
                            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                                <h3 class="font-bold text-slate-800 mb-6 flex items-center gap-2">
                                    <i class="fa-solid fa-receipt text-gray-400"></i> Order Summary
                                </h3>

                                <div class="space-y-3 text-sm">
                                    <div class="flex justify-between text-slate-500">
                                        <span>Subtotal</span>
                                        <span class="font-semibold text-slate-700">₹<%= (order.subtotal || 0).toFixed(2)
                                                %></span>
                                    </div>
                                    <div class="flex justify-between text-slate-500">
                                        <span>Discount</span>
                                        <span class="font-bold text-emerald-500">- ₹<%= (order.discount || 0).toFixed(2)
                                                %></span>
                                    </div>
                                    <div class="flex justify-between text-slate-500">
                                        <span>Shipping</span>
                                        <span class="font-semibold text-slate-700">₹50.00</span>
                                    </div>
                                    <div class="border-t border-dashed border-gray-200 my-4 pt-4">
                                        <div class="flex justify-between items-end">
                                            <span class="font-bold text-slate-800 text-base">Total Pay</span>
                                            <span class="text-2xl font-black text-rose-500">₹<%=
                                                    order.totalAmount.toFixed(2) %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Help Box -->
                            <div class="bg-indigo-50 rounded-2xl p-6 border border-indigo-100 text-center">
                                <h4 class="font-bold text-indigo-900 mb-2">Need Help?</h4>
                                <p class="text-xs text-indigo-700 mb-4">Issues with your order? We are here to help you.
                                </p>
                                <button
                                    class="w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-bold transition shadow-lg shadow-indigo-500/20">
                                    Contact Support
                                </button>
                            </div>

                        </div>
                    </div>

        </main>

        <!-- RETURN ITEM MODAL -->
        <div id="returnModal" class="fixed inset-0 z-50 hidden">
            <!-- Backdrop -->
            <div class="absolute inset-0 bg-gray-900/50 backdrop-blur-sm transition-opacity"
                onclick="closeReturnModal()">
            </div>

            <!-- Modal Content -->
            <div
                class="relative bg-white rounded-3xl w-full max-w-md mx-auto mt-20 p-6 shadow-2xl transform transition-all scale-100">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-xl font-bold text-accent-navy">Return Item</h3>
                    <button onclick="closeReturnModal()"
                        class="w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div id="returnItemDetails" class="mb-6 p-4 bg-gray-50 rounded-xl flex gap-4 items-center">
                    <img id="returnItemImage" src="" alt="Product" class="w-16 h-16 object-contain mix-blend-multiply">
                    <div>
                        <p id="returnItemName" class="font-bold text-accent-navy line-clamp-1"></p>
                        <p id="returnItemVariant" class="text-xs text-gray-500"></p>
                    </div>
                </div>

                <form id="returnForm" onsubmit="submitReturnRequest(event)">
                    <input type="hidden" id="returnOrderId" name="orderId">
                    <input type="hidden" id="returnItemId" name="itemId">

                    <div class="mb-4">
                        <label class="block text-sm font-bold text-gray-700 mb-2">Reason for Return</label>
                        <div class="relative">
                            <select name="returnReason" id="returnReasonSelect" required
                                onchange="toggleOtherReason(this)"
                                class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none appearance-none transition cursor-pointer">
                                <option value="" disabled selected>Select a reason</option>
                                <option value="Defective or Damaged">Defective or Damaged Product</option>
                                <option value="Wrong Item Received">Wrong Item Received</option>
                                <option value="Size or Fit Issue">Size or Fit Issue</option>
                                <option value="Quality Not as Expected">Quality Not as Expected</option>
                                <option value="Better Price Available">Better Price Available</option>
                                <option value="Other">Other</option>
                            </select>
                            <i
                                class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-xs"></i>
                        </div>
                    </div>

                    <div class="mb-6" id="otherReasonContainer">
                        <label class="block text-sm font-bold text-gray-700 mb-2">Additional Comments (Optional)</label>
                        <textarea name="comments" id="returnComments" rows="3"
                            class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10 outline-none transition resize-none"
                            placeholder="Please provide any extra details or concerns..."></textarea>
                    </div>

                    <button type="submit"
                        class="w-full bg-brand-500 text-white font-bold py-3.5 rounded-xl hover:bg-brand-600 transition shadow-lg shadow-brand-500/20">
                        Submit Request
                    </button>
                </form>
            </div>
        </div>

        <!-- CANCEL ORDER MODAL -->
        <div id="cancelModal" class="fixed inset-0 z-50 hidden">
            <!-- Backdrop -->
            <div class="absolute inset-0 bg-gray-900/50 backdrop-blur-sm transition-opacity"
                onclick="closeCancelModal()">
            </div>

            <!-- Modal Content -->
            <div
                class="relative bg-white rounded-3xl w-full max-w-md mx-auto mt-20 p-6 shadow-2xl transform transition-all scale-100">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-xl font-bold text-accent-navy" id="cancelModalTitle">Cancel Order</h3>
                    <button onclick="closeCancelModal()"
                        class="w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div id="cancelItemDetails" class="mb-6 p-4 bg-gray-50 rounded-xl flex gap-4 items-center hidden">
                    <img id="cancelItemImage" src="" alt="Product" class="w-16 h-16 object-contain mix-blend-multiply">
                    <div>
                        <p id="cancelItemName" class="font-bold text-accent-navy line-clamp-1"></p>
                        <p id="cancelItemVariant" class="text-xs text-gray-500"></p>
                    </div>
                </div>

                <form id="cancelForm" onsubmit="submitCancelRequest(event)">
                    <input type="hidden" id="cancelOrderId" name="orderId">
                    <input type="hidden" id="cancelItemId" name="itemId">

                    <div class="mb-4">
                        <label class="block text-sm font-bold text-gray-700 mb-2">Reason for Cancellation</label>
                        <div class="relative">
                            <select name="cancelReason" id="cancelReasonSelect" required
                                class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 focus:border-rose-500 focus:ring-4 focus:ring-rose-500/10 outline-none appearance-none transition cursor-pointer">
                                <option value="" disabled selected>Select a reason</option>
                                <option value="Found a better price">Found a better price</option>
                                <option value="Ordered by mistake">Ordered by mistake</option>
                                <option value="Shipping time is too long">Shipping time is too long</option>
                                <option value="Item not arrived on time">Item not arrived on time</option>
                                <option value="Changed my mind">Changed my mind</option>
                                <option value="Other">Other</option>
                            </select>
                            <i
                                class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-xs"></i>
                        </div>
                    </div>

                    <div class="mb-6" id="cancelCommentsContainer">
                        <label class="block text-sm font-bold text-gray-700 mb-2">Additional Comments (Optional)</label>
                        <textarea name="otherReason" id="cancelComments" rows="3"
                            class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-rose-500 focus:ring-4 focus:ring-rose-500/10 outline-none transition resize-none"
                            placeholder="Please provide any extra details or concerns..."></textarea>
                    </div>

                    <button type="submit"
                        class="w-full bg-rose-500 text-white font-bold py-3.5 rounded-xl hover:bg-rose-600 transition shadow-lg shadow-rose-500/20">
                        Confirm Cancellation
                    </button>
                </form>
            </div>
        </div>

        <%- include('../partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
                // ... Existing Return Modal Functions (openReturnModal, etc) ... 

                function openReturnModal(orderId, itemId, productName, variantName, imageUrl) {
                    document.getElementById('returnOrderId').value = orderId;
                    document.getElementById('returnItemId').value = itemId;
                    document.getElementById('returnItemName').textContent = productName;
                    document.getElementById('returnItemVariant').textContent = variantName || '';
                    document.getElementById('returnItemImage').src = imageUrl || '/assets/images/default-product.png';

                    document.getElementById('returnModal').classList.remove('hidden');
                }

                function closeReturnModal() {
                    document.getElementById('returnModal').classList.add('hidden');
                    document.getElementById('returnForm').reset();
                }

                // ... Existing Toggle Other Reason ...

                async function submitReturnRequest(event) {
                    // ... existing logic ...
                    event.preventDefault();
                    const form = event.target;
                    const orderId = form.orderId.value;
                    const itemId = form.itemId.value;

                    const reasonSelect = form.returnReason.value;
                    const comments = form.comments.value;

                    let finalReason = reasonSelect;
                    if (comments) {
                        finalReason = `${reasonSelect}: ${comments}`;
                    }

                    try {
                        const response = await fetch(`/orders/${orderId}/items/${itemId}/return`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ reason: finalReason })
                        });
                        const data = await response.json();

                        if (data.success) {
                            closeReturnModal();
                            Swal.fire({
                                icon: 'success',
                                title: 'Return Requested',
                                text: 'Your return request has been submitted successfully.',
                                confirmButtonColor: '#f43f5e'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to submit request',
                                confirmButtonColor: '#f43f5e'
                            });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An unexpected error occurred',
                            confirmButtonColor: '#f43f5e'
                        });
                    }
                }

                // ... Existing reorder function ...

                async function reorderItems(orderId) {
                    try {
                        const response = await fetch(`/orders/${orderId}/reorder`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await response.json();

                        if (data.success && data.redirect) {
                            window.location.href = data.redirect;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops...',
                                text: data.message || 'Failed to add items to cart',
                                confirmButtonColor: '#ff4d6d'
                            });
                        }
                    } catch (error) {
                        console.error('Reorder Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong',
                            confirmButtonColor: '#ff4d6d'
                        });
                    }
                }

                // ... Existing cancelReturnItem function ...

                async function cancelReturnItem(orderId, itemId) {
                    const result = await Swal.fire({
                        title: 'Cancel Return Request?',
                        text: "Are you sure you want to cancel this return request?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#f43f5e',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, cancel it!'
                    });

                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/orders/${orderId}/items/${itemId}/return/cancel`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' }
                            });
                            const data = await response.json();

                            if (data.success) {
                                Swal.fire(
                                    'Cancelled!',
                                    'Your return request has been cancelled.',
                                    'success'
                                ).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire(
                                    'Error!',
                                    data.message || 'Failed to cancel request.',
                                    'error'
                                );
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            Swal.fire(
                                'Error!',
                                'Something went wrong.',
                                'error'
                            );
                        }
                    }
                }


                // NEW CANCEL FUNCTIONS
                function openCancelModal(orderId, itemId = null, productName = null, variantName = null, imageUrl = null) {
                    document.getElementById('cancelOrderId').value = orderId;
                    document.getElementById('cancelItemId').value = itemId || '';

                    if (itemId) {
                        document.getElementById('cancelModalTitle').textContent = 'Cancel Item';
                        document.getElementById('cancelItemDetails').classList.remove('hidden');
                        document.getElementById('cancelItemName').textContent = productName;
                        document.getElementById('cancelItemVariant').textContent = variantName || '';
                        document.getElementById('cancelItemImage').src = imageUrl || '/assets/images/default-product.png';
                    } else {
                        document.getElementById('cancelModalTitle').textContent = 'Cancel Order';
                        document.getElementById('cancelItemDetails').classList.add('hidden');
                    }

                    document.getElementById('cancelModal').classList.remove('hidden');
                }

                function closeCancelModal() {
                    document.getElementById('cancelModal').classList.add('hidden');
                    document.getElementById('cancelForm').reset();
                }

                async function submitCancelRequest(event) {
                    event.preventDefault();
                    const form = event.target;
                    const orderId = form.orderId.value;
                    const itemId = form.itemId.value; // Can be empty for full order

                    const reasonSelect = form.cancelReason.value;
                    const additionalComments = form.otherReason.value.trim();

                    let finalReason = reasonSelect;
                    if (additionalComments) {
                        finalReason = `${reasonSelect}: ${additionalComments}`;
                    }

                    try {
                        const response = await fetch(`/orders/${orderId}/cancel`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ itemId, reason: finalReason })
                        });
                        const data = await response.json();

                        if (data.success) {
                            closeCancelModal();
                            Swal.fire({
                                icon: 'success',
                                title: 'Cancelled',
                                text: 'Cancellation processed successfully.',
                                confirmButtonColor: '#f43f5e'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Failed to cancel',
                                confirmButtonColor: '#f43f5e'
                            });
                        }
                    } catch (error) {
                        console.error('Cancel Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An unexpected error occurred',
                            confirmButtonColor: '#f43f5e'
                        });
                    }
                }
            </script>
</body>

</html>