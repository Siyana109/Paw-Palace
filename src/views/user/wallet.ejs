<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wallet | PawPalace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#f43f5e', 50: '#fff1f2' },
                        accent: { teal: '#2dd4bf', tealDark: '#0d9488', navy: '#0f172a', cream: '#fffdf5' }
                    }
                }
            }
        }
    </script>
</head>

<body
    class="bg-gray-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col selection:bg-rose-100 selection:text-rose-600">

    <%- include('../partials/header') %>

        <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 w-full flex-grow">

            <!-- BREADCRUMB -->
            <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8 animate-fade-in-up">
                <a href="/" class="hover:text-rose-500 transition-colors">Home</a>
                <span class="text-gray-300">/</span>
                <a href="/profile" class="hover:text-rose-500 transition-colors">Account</a>
                <span class="text-gray-300">/</span>
                <span class="font-semibold text-slate-800">Wallet</span>
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                <!-- SIDEBAR -->
                <div class="lg:col-span-3 space-y-6 animate-fade-in-up delay-75">
                <div class="bg-white rounded-3xl p-8 text-center shadow-sm border border-gray-100 relative overflow-hidden">
                    <div class="absolute top-0 w-full h-24 bg-gradient-to-b from-brand-50 to-transparent opacity-50 left-0"></div>
                    <div class="relative z-10">
                        <div class="relative inline-block mb-4">
                            <img src="<%= user?.profilePic || 'https://via.placeholder.com/150' %>"
                                class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-md"
                                alt="Profile">
                        </div>

                        <h2 class="text-xl font-black text-accent-navy tracking-tight mt-2">
                            <%= user.fullName %>
                        </h2>
                        <p class="text-xs text-brand-500 font-bold uppercase tracking-wider mt-1">
                            <%= user.role || 'Member' %>
                        </p>

                        <div class="mt-8 p-3 bg-gray-50 rounded-2xl border border-gray-100">
                            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Referral Code</p>
                            <div class="flex items-center justify-center gap-2 cursor-pointer group/ref"
                                onclick="navigator.clipboard.writeText('<%= user.referralCode %>'); Swal.fire({title: 'Copied!', text: 'Referral code copied to clipboard', icon: 'success', timer: 1500, showConfirmButton: false})">
                                <span class="font-mono font-bold text-accent-navy text-sm group-hover/ref:text-brand-500 transition-colors">
                                    <%= user.referralCode || '----' %>
                                </span>
                                <i class="fa-regular fa-copy text-xs text-gray-300 group-hover/ref:text-brand-500 transition-colors"></i>
                            </div>
                        </div>
                    </div>
                </div>

                    <div class="bg-white rounded-3xl p-4 shadow-sm border border-gray-100 space-y-1">
                        <a href="/profile"
                            class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 text-gray-400 font-bold transition group">
                            <div
                                class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center text-gray-700 group-hover:bg-white group-hover:text-brand-500 group-hover:shadow-sm transition">
                                <i class="fa-regular fa-user"></i>
                            </div>
                            <span class="group-hover:text-accent-navy transition">Profile Details</span>
                        </a>
                        <a href="/wallet"
                            class="flex items-center gap-4 p-4 rounded-2xl bg-brand-50 text-brand-600 font-bold transition shadow-sm border border-brand-100">
                            <div
                                class="w-8 h-8 rounded-lg bg-white flex items-center justify-center text-brand-700 shadow-sm">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                            Wallet
                        </a>
                        <a href="/orders"
                            class="flex items-center gap-4 p-4 rounded-2xl hover:bg-gray-50 text-gray-700 font-bold transition group">
                            <div
                                class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center text-gray-400 group-hover:bg-white group-hover:text-brand-500 group-hover:shadow-sm transition">
                                <i class="fa-solid fa-box"></i>
                            </div>
                            <span class="group-hover:text-accent-navy transition">My Orders</span>
                        </a>

                        <form action="/logout" method="POST" class="pt-2 mt-2 border-t border-gray-50">
                            <button type="submit"
                                class="w-full flex items-center gap-4 p-4 rounded-2xl hover:bg-red-50 text-red-400 font-bold transition text-left group">
                                <div
                                    class="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center text-red-400 group-hover:bg-white group-hover:shadow-sm transition">
                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                </div>
                                <span class="group-hover:text-red-600 transition">Log Out</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- MAIN CONTENT -->
                <div class="lg:col-span-9 space-y-8 animate-fade-in-up delay-150">

                    <!-- Balance Card -->
                    <div
                        class="bg-gradient-to-br from-rose-500 to-rose-600 rounded-[2.5rem] p-8 sm:p-12 text-white shadow-xl shadow-rose-500/20 relative overflow-hidden group">

                        <!-- Background Decorations -->
                        <div
                            class="absolute top-0 right-0 p-8 opacity-10 transform translate-x-10 -translate-y-10 group-hover:scale-110 transition-transform duration-700">
                            <i class="fa-solid fa-wallet text-9xl"></i>
                        </div>
                        <div
                            class="absolute bottom-0 left-0 w-64 h-64 bg-white opacity-5 rounded-full -ml-20 -mb-20 pointer-events-none">
                        </div>

                        <div
                            class="relative z-10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-8">
                            <div>
                                <p
                                    class="text-rose-100 font-bold uppercase tracking-wider text-xs mb-3 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                                    Total Available Balance
                                </p>
                                <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-2">
                                    ₹<%= (wallet.balance || 0).toFixed(2) %>
                                </h1>
                                <p class="text-rose-200 text-sm font-medium">Use for your next purchase</p>
                            </div>

                            <div class="flex flex-col gap-3">
                                <button onclick="openAddMoneyModal()"
                                    class="bg-white text-rose-600 hover:bg-rose-50 px-8 py-3.5 rounded-2xl font-bold text-sm transition shadow-lg shadow-black/10 flex items-center justify-center gap-2 transform active:scale-95">
                                    <i class="fa-solid fa-plus-circle"></i> Add Money
                                </button>
                                <!-- <p class="text-center text-[10px] text-rose-200 font-bold opacity-0 group-hover:opacity-100 transition-opacity">Instant Deposit</p> -->
                            </div>
                        </div>
                    </div>

                    <!-- Transactions Section -->
                    <div class="bg-white rounded-[2.5rem] p-8 shadow-sm border border-gray-100">
                        <div class="flex justify-between items-center mb-8">
                            <h3 class="text-2xl font-bold text-slate-800 flex items-center gap-3">
                                <i class="fa-solid fa-clock-rotate-left text-rose-500"></i>
                                Transaction History
                            </h3>
                            <!-- <button class="text-xs font-bold text-gray-400 hover:text-rose-500 transition">View All</button> -->
                        </div>

                        <% if (wallet.transactions && wallet.transactions.length> 0) { %>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr
                                            class="text-gray-400 text-[10px] uppercase tracking-wider border-b border-gray-50">
                                            <th class="py-4 font-bold pl-4">Date & Time</th>
                                            <th class="py-4 font-bold">Details</th>
                                            <th class="py-4 font-bold text-center">Reference</th>
                                            <th class="py-4 font-bold text-right pr-4">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody class="text-sm">
                                        <% wallet.transactions.slice().reverse().forEach(txn=> { %>
                                            <tr
                                                class="group hover:bg-gray-50/80 transition-colors border-b border-gray-50 last:border-0 rounded-2xl">

                                                <!-- Date -->
                                                <td class="py-5 pl-4 align-top">
                                                    <div class="flex flex-col">
                                                        <span class="font-bold text-slate-700">
                                                            <%= new Date(txn.date).toLocaleDateString('en-IN', {
                                                                day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                                        </span>
                                                        <span class="text-xs text-gray-400 font-medium">
                                                            <%= new Date(txn.date).toLocaleTimeString('en-IN', {
                                                                hour: '2-digit' , minute: '2-digit' }) %>
                                                        </span>
                                                    </div>
                                                </td>

                                                <!-- Details -->
                                                <td class="py-5 align-top">
                                                    <div class="flex items-start gap-4">
                                                        <div
                                                            class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 <%= txn.type === 'Credit' ? 'bg-emerald-50 text-emerald-500' : txn.type === 'Failed' ? 'bg-red-50 text-red-500' : 'bg-rose-50 text-rose-500' %>">
                                                            <i
                                                                class="fa-solid <%= txn.type === 'Credit' ? 'fa-arrow-down' : txn.type === 'Failed' ? 'fa-xmark' : 'fa-arrow-up transform rotate-45' %>"></i>
                                                        </div>
                                                        <div>
                                                            <p class="font-bold text-slate-800 mb-0.5">
                                                                <%= txn.type==='Credit' ? 'Received' :
                                                                    txn.type==='Failed' ? 'Failed' : 'Sent' %>
                                                            </p>
                                                            <p
                                                                class="text-xs text-slate-500 font-medium leading-relaxed max-w-[200px]">
                                                                <%= txn.description %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </td>

                                                <!-- Reference -->
                                                <td class="py-5 text-center align-top">
                                                    <% if (txn.orderId) { %>
                                                        <a href="/order/<%= txn.orderId %>"
                                                            class="inline-block bg-gray-100 hover:bg-gray-200 text-gray-600 text-[10px] font-bold px-2 py-1 rounded-lg transition font-mono">
                                                            #<%= String(txn.orderId).slice(-6).toUpperCase() %>
                                                        </a>
                                                        <% } else { %>
                                                            <span class="text-gray-300 font-mono text-xs">-</span>
                                                            <% } %>
                                                </td>

                                                <!-- Amount -->
                                                <td class="py-5 pr-4 text-right align-top">
                                                    <span
                                                        class="font-black text-lg <%= txn.type === 'Credit' ? 'text-emerald-500' : txn.type === 'Failed' ? 'text-red-500' : 'text-slate-800' %>">
                                                        <%= txn.type==='Credit' ? '+' : txn.type==='Failed' ? '' : '-'
                                                            %> ₹<%= txn.amount.toFixed(2) %>
                                                    </span>
                                                    <p class="text-[10px] font-bold text-gray-400 uppercase mt-1">
                                                        <%= txn.type %>
                                                    </p>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <div
                                    class="text-center py-20 bg-gray-50 rounded-3xl border border-dashed border-gray-200">
                                    <div
                                        class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 text-gray-300 text-2xl shadow-sm">
                                        <i class="fa-solid fa-receipt"></i>
                                    </div>
                                    <h4 class="text-lg font-bold text-slate-700 mb-1">No transactions yet</h4>
                                    <p class="text-xs text-gray-400">Your wallet activity will appear here once you make
                                        a transaction.</p>
                                </div>
                                <% } %>
                    </div>

                </div>

            </div>

        </main>

        <%- include('../partials/footer') %>

            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

            <!-- ADD MONEY MODAL -->
            <div id="addMoneyModal"
                class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
                <div
                    class="bg-white rounded-3xl p-8 w-full max-w-sm shadow-2xl transform scale-95 transition-transform duration-300 relative">

                    <button onclick="closeAddMoneyModal()"
                        class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>

                    <div class="test-center mb-6">
                        <div
                            class="w-16 h-16 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-4 text-rose-500">
                            <i class="fa-solid fa-wallet text-3xl"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-800 text-center">Add Money</h3>
                        <p class="text-sm text-gray-500 text-center">Add funds to your wallet instantly.</p>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Amount
                                (₹)</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 font-bold">₹</span>
                                <input type="number" id="rechargeAmount" placeholder="Enter amount" min="1"
                                    class="w-full pl-8 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl font-bold text-slate-800 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition">
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-2">
                            <button onclick="setAmount(100)"
                                class="py-2 bg-gray-50 hover:bg-rose-50 hover:text-rose-500 hover:border-rose-200 border border-transparent rounded-lg text-xs font-bold text-gray-500 transition">₹100</button>
                            <button onclick="setAmount(500)"
                                class="py-2 bg-gray-50 hover:bg-rose-50 hover:text-rose-500 hover:border-rose-200 border border-transparent rounded-lg text-xs font-bold text-gray-500 transition">₹500</button>
                            <button onclick="setAmount(1000)"
                                class="py-2 bg-gray-50 hover:bg-rose-50 hover:text-rose-500 hover:border-rose-200 border border-transparent rounded-lg text-xs font-bold text-gray-500 transition">₹1000</button>
                        </div>

                        <button onclick="initiateRecharge()" id="payBtn"
                            class="w-full bg-rose-500 hover:bg-rose-600 text-white py-3.5 rounded-xl font-bold shadow-lg shadow-rose-500/30 transition transform active:scale-95 flex items-center justify-center gap-2">
                            <span>Proceed to Pay</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <script>
                const modal = document.getElementById('addMoneyModal');
                const modalContent = modal.querySelector('div');
                const amountInput = document.getElementById('rechargeAmount');

                function openAddMoneyModal() {
                    modal.classList.remove('hidden');
                    // Small delay to allow display:block to apply before opacity transition
                    setTimeout(() => {
                        modal.classList.remove('opacity-0');
                        modalContent.classList.remove('scale-95');
                        modalContent.classList.add('scale-100');
                    }, 10);
                    amountInput.focus();
                }

                function closeAddMoneyModal() {
                    modal.classList.add('opacity-0');
                    modalContent.classList.remove('scale-100');
                    modalContent.classList.add('scale-95');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 300);
                }

                function setAmount(val) {
                    amountInput.value = val;
                }

                // Close on outside click
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) closeAddMoneyModal();
                });

                async function initiateRecharge() {
                    const amount = amountInput.value;
                    const btn = document.getElementById('payBtn');

                    if (!amount || amount < 1) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Invalid Amount',
                            text: 'Please enter a valid amount (minimum ₹1)',
                            confirmButtonColor: '#f43f5e'
                        });
                        return;
                    }

                    try {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Processing...';

                        const response = await fetch('/wallet/recharge', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ amount })
                        });

                        const data = await response.json();

                        if (!data.success) {
                            throw new Error(data.message);
                        }

                        const options = {
                            key: data.key,
                            amount: data.order.amount,
                            currency: "INR",
                            name: "PawPalace",
                            description: "Wallet Recharge",
                            order_id: data.order.id,
                            handler: async function (response) {
                                verifyPayment(response, amount);
                            },
                            modal: {
                                ondismiss: async function () {
                                    console.log("Recharge Modal Closed");
                                    try {
                                        await fetch('/wallet/recharge-failed', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ amount: amount, reason: "Cancelled by User" })
                                        });
                                    } catch (err) {
                                        console.error("Failed to notify backend", err);
                                    }
                                    btn.disabled = false;
                                    btn.innerHTML = '<span>Proceed to Pay</span><i class="fa-solid fa-arrow-right"></i>';
                                    window.location.reload();
                                }
                            },
                            theme: { color: "#f43f5e" }
                        };

                        const rzp1 = new Razorpay(options);
                        rzp1.open();

                        rzp1.on('payment.failed', async function (response) {
                            try {
                                await fetch('/wallet/recharge-failed', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ amount: amount, reason: response.error.description })
                                });
                            } catch (err) {
                                console.error("Failed to notify backend", err);
                            }

                            Swal.fire({
                                icon: 'error',
                                title: 'Payment Failed',
                                text: response.error.description,
                                confirmButtonColor: '#f43f5e'
                            }).then(() => {
                                window.location.reload();
                            });
                            btn.disabled = false;
                            btn.innerHTML = '<span>Proceed to Pay</span><i class="fa-solid fa-arrow-right"></i>';
                        });


                    } catch (error) {
                        console.error(error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: error.message || 'Something went wrong',
                            confirmButtonColor: '#f43f5e'
                        });
                        btn.disabled = false;
                        btn.innerHTML = '<span>Proceed to Pay</span><i class="fa-solid fa-arrow-right"></i>';
                    }
                }

                async function verifyPayment(paymentResponse, amount) {
                    const btn = document.getElementById('payBtn');
                    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Verifying...';

                    try {
                        const res = await fetch('/wallet/verify-recharge', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                ...paymentResponse,
                                amount
                            })
                        });

                        const data = await res.json();

                        if (data.success) {
                            closeAddMoneyModal();
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: 'Wallet recharged successfully.',
                                confirmButtonColor: '#f43f5e',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            throw new Error(data.message);
                        }

                    } catch (error) {
                        console.error(error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Verification Failed',
                            text: error.message || 'Payment verification failed',
                            confirmButtonColor: '#f43f5e'
                        });
                        btn.disabled = false;
                        btn.innerHTML = '<span>Proceed to Pay</span><i class="fa-solid fa-arrow-right"></i>';
                    }
                }
            </script>

</body>

</html>